---
import "../styles/global.css";
import Layout from "../layouts/Layout.astro";
import Container from "../components/shared/Container.astro";
import Titlenew from "../components/shared/Titlenew.astro";
import Paragraph from "../components/shared/Paragraph.astro";
import Pagebreadcrumb from "../components/shared/Pagebreadcrumb.astro";

import {
  BadgeCheck,
  ShieldCheck,
  Lock,
  Mail,
  Cloud,
  Monitor,
  Settings,
  Radar,
  Siren,
  Link2,
  BarChart3,
} from "lucide-astro";

import Requirement from "../components/sections/Requirement.astro";
import Selar from "../components/sections/Selar.astro";
---

<Layout title="CloudTweak - M365 Bootcamp - Week 6">
  <main class="flex flex-col gap-y-16 md:gap-y-24 overflow-hidden">
    <section class="relative py-6 overflow-hidden">
      <!-- Background Effects -->
      <div
        class="absolute left-0 top-0 h-[30rem] w-[30rem] rounded-full bg-cyan-500/10 blur-3xl"
      >
      </div>
      <div
        class="absolute right-0 bottom-0 h-[25rem] w-[25rem] rounded-full bg-indigo-500/10 blur-3xl"
      >
      </div>

      <Container className="relative z-10">
        <!-- Header -->
        <div class="max-w-4xl mx-auto text-center">
          <span
            class="inline-flex
          items-center
          gap-2
          rounded-full
          border
          border-cyan-500/20
          bg-cyan-500/10
          px-5
          py-2
          text-sm
          font-medium
          text-cyan-700
          dark:text-cyan-300
          backdrop-blur-xl"
          >
            <BadgeCheck size={18} />
            Week 6 Curriculum
          </span>

          <h1
            class="mt-8
          text-5xl/tight
          md:text-6xl/tight
          font-bold
          tracking-tight
          text-heading-1"
          >
            Microsoft
            <span
              class="text-transparent
            bg-clip-text
            bg-gradient-to-r
            from-cyan-500
            via-primary
            to-indigo-500"
            >
              Defender
            </span>
          </h1>

          <Paragraph className="mt-8 text-lg">
            Week 6 introduces students to Learn how Microsoft Defender protects
            identities, email, devices, applications and data across Microsoft
            365. This module introduces Microsoft's unified security platform
            from a practical administrator's perspective.
          </Paragraph>

          <Pagebreadcrumb active="weeksix" />
        </div>

        <!-- Grid -->
        <div class="grid lg:grid-cols-2 gap-8 mt-16">
          <!-- Card -->

          <article
            class="rounded-3xl border border-box-border bg-box-bg/50 backdrop-blur-xl p-8"
          >
            <ShieldCheck class="text-primary mb-5" size={34} />

            <h3 class="text-2xl font-bold dark:text-white" ">
              Foundations of Microsoft Defender
            </h3>

            <Paragraph className="mt-4">
              Understand Microsoft's security ecosystem, Zero Trust principles,
              Defender products, licensing overview and how Defender protects
              Microsoft 365 workloads.
            </Paragraph>

            <a
              href="https://support.microsoft.com/en-us/defender/getting-started-with-microsoft-defender"
              target="_blank"
              class="mt-6 inline-flex items-center gap-2 text-primary hover:underline"
            >
              Microsoft Defender Documentation
            </a>
          </article>

          <article
            class="rounded-3xl border border-box-border bg-box-bg/50 backdrop-blur-xl p-8"
          >
            <Lock class="text-primary mb-5" size={34} />

            <h3 class="text-2xl font-bold dark:text-white">
              Environment Setup & Licensing
            </h3>

            <Paragraph className="mt-4">
              Configure your Defender environment, understand licensing
              requirements, activate services and prepare your tenant for
              enterprise security.
            </Paragraph>

            <a
              href="https://learn.microsoft.com/en-us/defender-endpoint/mde-p1-setup-configuration"
              target="_blank"
              class="mt-6 inline-flex items-center gap-2 text-primary hover:underline"
            >
              Environment Setup & Licensing Documentation
            </a>
          </article>

          <article
            class="rounded-3xl border border-box-border bg-box-bg/50 backdrop-blur-xl p-8"
          >
            <Mail class="text-primary mb-5" size={34} />

            <h3 class="text-2xl font-bold dark:text-white">
              Defender for Office 365
            </h3>

            <Paragraph className="mt-4">
              Protect users from phishing, malware, malicious attachments, Safe
              Links and Business Email Compromise attacks.
            </Paragraph>

            <a
              href="https://learn.microsoft.com/en-us/defender-office-365/"
              target="_blank"
              class="mt-6 inline-flex items-center gap-2 text-primary hover:underline"
            >
              Defender for Office 365 Documentation
            </a>
          </article>

          <article
            class="rounded-3xl border border-box-border bg-box-bg/50 backdrop-blur-xl p-8"
          >
            <Cloud class="text-primary mb-5" size={34} />

            <h3 class="text-2xl font-bold dark:text-white">
              Defender for Cloud Apps
            </h3>

            <Paragraph className="mt-4">
              Discover cloud applications, monitor risky behaviour, secure SaaS
              applications and investigate cloud threats.
            </Paragraph>

            <a
              href="https://learn.microsoft.com/en-us/defender-cloud-apps/"
              target="_blank"
              class="mt-6 inline-flex items-center gap-2 text-primary hover:underline"
            >
              Defender for Cloud Apps
            </a>
          </article>

          <article
            class="rounded-3xl border border-box-border bg-box-bg/50 backdrop-blur-xl p-8"
          >
            <Settings class="text-primary mb-5" size={34} />

            <h3 class="text-2xl font-bold dark:text-white">
              Policies & Security Configuration
            </h3>

            <Paragraph className="mt-4">
              Configure anti-phishing, anti-malware, Safe Links, Safe
              Attachments and security policies that protect your organization.
            </Paragraph>

            <a
              href="https://learn.microsoft.com/en-us/microsoftteams/teams-live-events/plan-for-teams-live-events"
              target="_blank"
              class="mt-6 inline-flex items-center gap-2 text-primary hover:underline"
            >
              Policies & Security Configuration Documentation
            </a>
          </article>

          <article
            class="rounded-3xl border border-box-border bg-box-bg/50 backdrop-blur-xl p-8"
          >
            <Radar class="text-primary mb-5" size={34} />

            <h3 class="text-2xl font-bold dark:text-white">
              Threat Protection & Detection
            </h3>

            <Paragraph className="mt-4">
              Understand how Defender detects ransomware, phishing, suspicious
              logins, malware and advanced cyber attacks.
            </Paragraph>

            <a
              href="https://learn.microsoft.com/en-us/defender-office-365/protection-stack-microsoft-defender-for-office365"
              target="_blank"
              class="mt-6 inline-flex items-center gap-2 text-primary hover:underline"
            >
              Threat Protection & Detection Documentation
            </a>
          </article>

          <article
            class="rounded-3xl border border-box-border bg-box-bg/50 backdrop-blur-xl p-8"
          >
            <Siren class="text-primary mb-5" size={34} />

            <h3 class="text-2xl font-bold dark:text-white">
              Incident Management & Response
            </h3>

            <Paragraph className="mt-4">
              Investigate alerts, manage incidents, remediate compromised users
              and respond to security threats confidently.
            </Paragraph>

            <a
              href="https://learn.microsoft.com/en-us/defender-xdr/manage-incidents?tabs=queue"
              target="_blank"
              class="mt-6 inline-flex items-center gap-2 text-primary hover:underline"
            >
              Incident Management & Response Documentation
            </a>
          </article>

          <article
            class="rounded-3xl border border-box-border bg-box-bg/50 backdrop-blur-xl p-8"
          >
            <BarChart3 class="text-primary mb-5" size={34} />

            <h3 class="text-2xl font-bold dark:text-white">
              Analytics & Reporting
            </h3>

            <Paragraph className="mt-4">
              Generate reports, monitor security posture, review Secure Score,
              analyze trends and communicate security insights to management.
            </Paragraph>

            <a
              href="https://learn.microsoft.com/en-us/defender-xdr/threat-analytics"
              target="_blank"
              class="mt-6 inline-flex items-center gap-2 text-primary hover:underline"
            >
              Analytics and reporting Documentation
            </a>
          </article>
        </div>

        <Selar />
        <div class="pt-10">
          <Requirement />
        </div>
      </Container>
    </section>
  </main>
</Layout>
