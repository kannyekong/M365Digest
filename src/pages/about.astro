---
import "../styles/global.css";
import Container from "../components/shared/Container.astro";
import Title from "../components/shared/Title.astro";
import Layout from "../layouts/Layout.astro";
import Selar from "../components/sections/Selar.astro";
import Requirement from "../components/sections/Requirement.astro";
import { services } from "../utils/data.ts";
import Service from "../components/cards/Service.astro";
import {
  Award,
  
} from "lucide-astro";
import AboutUs from "../components/sections/AboutUs.astro";

type ServicesProps = {
  week: string;
  title: string;
  description: string;
  icon: string;
  href: string;
};
---

<Layout title="CloudTweak - M365 Bootcamp - About Page">
  <section id="about-page" class="relative py-24 overflow-hidden">
    <Container className="space-y-10 md:space-y-12 mt-12">
      <div class="text-center max-w-5xl mx-auto space-y-3 md:space-y-6">
        <span
          class="inline-flex
          items-center
          gap-2
          rounded-full
          border
          border-blue-500/20
          bg-blue-500/10
          px-5
          py-2
          text-sm
          font-medium
          text-blue-700
          dark:text-blue-300
          backdrop-blur-xl"
        >
          <Award size={18} />
          Cohort 1.0
        </span>
        <Title>
          <span
            class="text-transparent bg-clip-text bg-gradient-to-br from-indigo-600 from-20% via-primary via-30% to-green-600"
            >About this Bootcamp</span
          >
        </Title>
        <p class="dark:text-white">
          In six weeks, you’ll progress from basic familiarity to confident
          administration of core Microsoft 365 services shown in the sections
          below. Each session is built around real-world administrative
          scenarios—equipping you not just to understand the platform, but to
          effectively manage users, secure data, optimize environments, and
          resolve everyday operational challenges. <br /><br /><span
            >For more answers to your questions, visit our <a
              href="./../#faq"
              class="text-blue-500">FAQ page</a
            > or <a
              href="#tally-open=VL4vdg&tally-layout=modal&tally-emoji-text=👋&tally-emoji-animation=wave"
              class="text-blue-500">Contact Page</a
            >
            or engage with our <a
              href="#"
              class="text-blue-500"
              onclick="event.preventDefault(); openNvitiChat()">AI Assistant</a
            ></span
          >
        </p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
        {
          services.map((service: ServicesProps) => {
            return (
              <Service
                title={service.title}
                description={service.description}
                icon={service.icon}
                week={service.week}
                href={service.href}
              />
            );
          })
        }
      </div>
      <AboutUs />
      <Requirement />
    </Container>
  </section>
  <Selar />
</Layout>
