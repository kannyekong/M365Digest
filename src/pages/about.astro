---
import "../styles/global.css";
import Container from "../components/shared/Container.astro";
import Title from "../components/shared/Title.astro";
import Layout from "../layouts/Layout.astro";
import Selar from "../components/sections/Selar.astro";
import Requirement from "../components/sections/Requirement.astro";
import { services } from "../utils/data.ts";
import Service from "../components/cards/Service.astro";

type ServicesProps = {
  week: string;
  title: string;
  description: string;
  icon: string;
  href: string;
};
---

<Layout title="Cloudnova - M365 Bootcamp - About Page">
  <section id="about-page" class="relative py-24 overflow-hidden">
    <Container className="space-y-10 md:space-y-12 mt-12">
      <div class="text-center max-w-3xl mx-auto space-y-4">
        <Title>
          <span
            class="text-transparent bg-clip-text bg-gradient-to-br from-indigo-600 from-20% via-primary via-30% to-green-600"
            >About this Bootcamp</span
          >
        </Title>
        <p>
          Click on <span class="font-bold text-primary">View details</span> to learn
          more about each week's learning module
        </p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
        {
          services.map((service: ServicesProps) => {
            return (
              <Service
                title={service.title}
                description={service.description}
                icon={service.icon}
                week={service.week}
                href={service.href}
              />
            );
          })
        }
      </div>
      <Requirement />
    </Container>
  </section>
  <Selar />
</Layout>
