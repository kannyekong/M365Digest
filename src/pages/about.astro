---
import Container from "../components/shared/Container.astro";
import "../styles/global.css";
import Title from "../components/shared/Title.astro";
import Paragraph from "../components/shared/Paragraph.astro";
import {
  ShieldCheck,
  Cloud,
  BrainCircuit,
  Rocket,
  BadgeCheck,
} from "lucide-astro";
import Layout from "../layouts/Layout.astro";
import Selar from "../components/sections/Selar.astro";
import Requirement from "../components/sections/Requirement.astro";
---

<Layout title="Cloudnova - M365 Bootcamp - About Page">
  <section id="about-page" class="relative py-24 overflow-hidden">
    <!-- Background Blobs -->
    <div
      class="absolute left-0 top-0 h-[35rem] w-[35rem] rounded-full bg-cyan-500/10 blur-3xl"
    >
    </div>
    <div
      class="absolute right-0 bottom-0 h-[30rem] w-[30rem] rounded-full bg-green-500/10 blur-3xl"
    >
    </div>

    <Container className="relative z-10">
      <!-- Hero -->
      <div class="max-w-4xl mx-auto text-center">
        <span
          class="inline-flex
          items-center
          gap-2
          rounded-full
          border
          border-cyan-500/20
          bg-cyan-500/10
          px-5
          py-2
          text-sm
          font-medium
          text-cyan-700
          dark:text-cyan-300
          backdrop-blur-xl"
        >
          <BadgeCheck size={18} />
          6 Weeks to Mastery guaranteed
        </span>

        <h1
          class="mt-8
          text-5xl/tight
          md:text-6xl/tight
          font-bold
          tracking-tight
          text-heading-1"
        >
          About
          <span
            class="text-transparent
            bg-clip-text
            bg-gradient-to-r
            from-indigo-600
            via-primary
            to-green-500"
          >
            this bootcamp
          </span>
        </h1>

        <Paragraph className="mt-8 text-lg md:text-xl">
          This is a modern Microsoft 365 administration bootcamp designed
          to help aspiring IT professionals, system administrators, cloud
          engineers, and support specialists gain practical, enterprise-ready
          Microsoft 365 skills through hands-on training, real-world scenarios,
          and guided mentorship.
        </Paragraph>
      </div>

      <!-- Content -->
      <div class="grid lg:grid-cols-2 gap-14 mt-24 items-center">
        <!-- Left -->
        <div class="space-y-8">
          <div>
            <Title> Learn Microsoft 365 the Practical Way </Title>

            <Paragraph className="mt-5">
              Our training approach focuses on practical implementation,
              troubleshooting, administration, security, collaboration,
              automation, and real-world enterprise workflows. Students learn
              how organizations deploy and manage modern Microsoft cloud
              technologies including:
            </Paragraph>
          </div>

          <div class="grid sm:grid-cols-2 gap-5">
            <div
              class="rounded-2xl
              border
              border-white/10
              bg-white/5
              backdrop-blur-xl
              p-5
              shadow-xl"
            >
              <div
                class="w-12
                h-12
                rounded-xl
                bg-gradient-to-br
                from-blue-500
                to-cyan-500
                text-white
                flex
                items-center
                justify-center"
              >
                <Cloud size={24} />
              </div>

              <h3 class="mt-4 font-semibold text-lg">
                Microsoft 365 Administration
              </h3>

              <p class="mt-2 text-sm text-gray-600 dark:text-gray-300">
                Learn Exchange Online, SharePoint, Teams, OneDrive, and Entra ID
                administration.
              </p>
            </div>

            <div
              class="rounded-2xl
              border
              border-white/10
              bg-white/5
              backdrop-blur-xl
              p-5
              shadow-xl"
            >
              <div
                class="w-12
                h-12
                rounded-xl
                bg-gradient-to-br
                from-green-500
                to-emerald-500
                text-white
                flex
                items-center
                justify-center"
              >
                <ShieldCheck size={24} />
              </div>

              <h3 class="mt-4 font-semibold text-lg">Security & Compliance</h3>

              <p class="mt-2 text-sm text-gray-600 dark:text-gray-300">
                Understand identity protection, email security, compliance, and
                governance best practices.
              </p>
            </div>

            <div
              class="rounded-2xl
              border
              border-white/10
              bg-white/5
              backdrop-blur-xl
              p-5
              shadow-xl"
            >
              <div
                class="w-12
                h-12
                rounded-xl
                bg-gradient-to-br
                from-indigo-500
                to-purple-500
                text-white
                flex
                items-center
                justify-center"
              >
                <BrainCircuit size={24} />
              </div>

              <h3 class="mt-4 font-semibold text-lg">AI & Automation</h3>

              <p class="mt-2 text-sm text-gray-600 dark:text-gray-300">
                Explore Microsoft Copilot, Power Automate, and workflow
                automation technologies.
              </p>
            </div>

            <div
              class="rounded-2xl
              border
              border-white/10
              bg-white/5
              backdrop-blur-xl
              p-5
              shadow-xl"
            >
              <div
                class="w-12
                h-12
                rounded-xl
                bg-gradient-to-br
                from-orange-400
                to-yellow-400
                text-white
                flex
                items-center
                justify-center"
              >
                <Rocket size={24} />
              </div>

              <h3 class="mt-4 font-semibold text-lg">Career Growth</h3>

              <p class="mt-2 text-sm text-gray-600 dark:text-gray-300">
                Build confidence, hands-on experience, and preparation for
                enterprise IT roles.
              </p>
            </div>
          </div>
        </div>

        <!-- Right -->
        <div class="relative">
          <div
            class="absolute
            inset-0
            bg-gradient-to-br
            from-cyan-500/20
            to-green-500/20
            blur-3xl"
          >
          </div>

          <div
            class="relative
            rounded-[2rem]
            border
            border-white/10
            bg-white/5
            backdrop-blur-xl
            p-8
            shadow-2xl"
          >
            <img
              src="/images/bootcampp.jpg"
              alt="Microsoft 365 Bootcamp"
              class="rounded-2xl
              w-full
              object-cover
              shadow-xl"
            />

            <div class="mt-8 space-y-5">
              <div class="flex items-start gap-4">
                <div
                  class="min-w-[2rem]
                  h-8
                  rounded-xl
                  bg-gradient-to-br
                  from-indigo-500
                  via-blue-500
                  to-cyan-400
                  text-white
                  inline-flex
                  justify-center
                  items-center"
                >
                  ✓
                </div>

                <p>Hands-on enterprise-focused Microsoft 365 training</p>
              </div>

              <div class="flex items-start gap-4">
                <div
                  class="min-w-[2rem]
                  h-8
                  rounded-xl
                  bg-gradient-to-br
                  from-indigo-500
                  via-blue-500
                  to-cyan-400
                  text-white
                  inline-flex
                  justify-center
                  items-center"
                >
                  ✓
                </div>

                <p>Practical administration and troubleshooting labs</p>
              </div>

              <div class="flex items-start gap-4">
                <div
                  class="min-w-[2rem]
                  h-8
                  rounded-xl
                  bg-gradient-to-br
                  from-indigo-500
                  via-blue-500
                  to-cyan-400
                  text-white
                  inline-flex
                  justify-center
                  items-center"
                >
                  ✓
                </div>

                <p>Beginner-friendly learning path with real-world scenarios</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <Selar />
        <div class="pt-10">
          <Requirement />
        </div>
    </Container>
  </section>
</Layout>
