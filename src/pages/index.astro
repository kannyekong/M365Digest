---
import "../styles/global.css";
import Layout from "../layouts/Layout.astro";
import Hero from "../components/sections/Hero.astro";
import Services from "../components/sections/Services.astro";
import AboutUs from "../components/sections/AboutUs.astro";
import Features from "../components/sections/Features.astro";
import CTA from "../components/sections/CTA.astro";
import Contact from "../components/sections/Contact.astro";
import Requirement from "../components/sections/Requirement.astro";
import Selar from "../components/sections/Selar.astro";
import Instructors from "../components/sections/Instructors.astro";
---

<Layout title="Cloudnova - M365 Bootcamp">
  <main class="flex flex-col gap-y-16 md:gap-y-24 overflow-hidden">
    <Hero />
    <Selar />
    <Services />
    <AboutUs />
    <Requirement />
    <CTA />
    <Instructors />
    <Contact />
    <Requirement />
  </main>
