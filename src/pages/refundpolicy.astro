---
import "../styles/global.css";
import Layout from "../layouts/Layout.astro";
import Container from "../components/shared/Container.astro";
import Title from "../components/shared/Title.astro";
import Paragraph from "../components/shared/Paragraph.astro";
import Titlenew from "../components/shared/Titlenew.astro";
import Selar from "../components/sections/Selar.astro";
import Requirement from "../components/sections/Requirement.astro";
---

<Layout title="CloudTweak - M365 Bootcamp - Refund Policy and T&C">
  <main class="flex flex-col gap-y-16 md:gap-y-24 overflow-hidden">
    <section class="relative py-24 overflow-hidden">
      <!-- Background Blurs -->
      <div
        class="absolute top-0 left-0 w-72 h-72 bg-cyan-400/10 blur-3xl rounded-full"
      >
      </div>
      <div
        class="absolute bottom-0 right-0 w-96 h-96 bg-green-400/10 blur-3xl rounded-full"
      >
      </div>

      <Container className="relative z-10 max-w-5xl">
        <!-- Header -->
        <div class="text-center max-w-3xl mx-auto">
          <span
            class="inline-flex
          items-center
          rounded-full
          border
          border-cyan-500/20
          bg-cyan-500/10
          px-5
          py-2
          text-sm
          font-medium
          text-cyan-700
          dark:text-cyan-300
          backdrop-blur-xl"
          >
            CloudTweak Academy
          </span>

          <h1
            class="mt-8
          text-5xl/tight
          md:text-6xl/tight
          font-bold
          tracking-tight
          text-heading-1"
          >
            Refund
            <span
              class="text-transparent
            bg-clip-text
            bg-gradient-to-r
            from-cyan-500
            via-primary
            to-green-500"
            >
              Policy
            </span>
          </h1>

          <Paragraph className="mt-6 text-lg">
            Last Updated: May 27, 2026
          </Paragraph>
        </div>

        <!-- Content -->
        <div
          class="mt-16
        rounded-[2rem]
        border
        border-white/10
        bg-white/5
        backdrop-blur-xl
        p-8
        md:p-12
        shadow-2xl
        space-y-12"
        >
          <!-- Intro -->
          <div class="space-y-4">
            <Titlenew>Welcome to CloudTweak Academy</Titlenew>

            <Paragraph>
              Please read our refund policy carefully before enrolling in any of
              our bootcamps or training programs.
            </Paragraph>
          </div>

          <!-- Section 1 -->
          <div class="space-y-4">
            <Titlenew>1. Enrollment & Commitment</Titlenew>

            <Paragraph>
              By registering for any CloudTweak bootcamp, course, or training
              program, you agree to the terms outlined in this Refund Policy.
            </Paragraph>

            <Paragraph>
              Our programs are structured, instructor-led learning experiences
              that require upfront planning, resource allocation, and limited
              seat reservations. As such, refunds are governed by the conditions
              below.
            </Paragraph>
          </div>

          <!-- Section 2 -->
          <div class="space-y-4">
            <Titlenew>2. Refund Eligibility</Titlenew>

            <Paragraph>
              Students may request a refund within 7 calendar days from the
              official commencement date of the program.
            </Paragraph>

            <Paragraph> To qualify for a refund: </Paragraph>

            <ul class="space-y-3 text-heading-2">
              <li class="flex items-start gap-3">
                <span class="mt-1 w-2 h-2 rounded-full bg-cyan-500"></span>
                The request must be submitted within the 7-day refund window
              </li>

              <li class="flex items-start gap-3">
                <span class="mt-1 w-2 h-2 rounded-full bg-cyan-500"></span>
                The participant must not have excessively consumed course materials,
                downloadable resources, or recorded sessions
              </li>

              <li class="flex items-start gap-3">
                <span class="mt-1 w-2 h-2 rounded-full bg-cyan-500"></span>
                Refund requests must be submitted officially through our support channel
                or designated contact email
              </li>
            </ul>
          </div>

          <!-- Section 3 -->
          <div class="space-y-4">
            <Titlenew>3. Non-Refundable Period</Titlenew>

            <Paragraph>
              After 7 days from the program commencement date, all payments
              become non-refundable.
            </Paragraph>

            <Paragraph> This policy applies regardless of: </Paragraph>

            <ul class="space-y-3 text-heading-2">
              <li class="flex items-start gap-3">
                <span class="mt-1 w-2 h-2 rounded-full bg-green-500"></span>
                Attendance status
              </li>

              <li class="flex items-start gap-3">
                <span class="mt-1 w-2 h-2 rounded-full bg-green-500"></span>
                Scheduling conflicts
              </li>

              <li class="flex items-start gap-3">
                <span class="mt-1 w-2 h-2 rounded-full bg-green-500"></span>
                Change of mind
              </li>

              <li class="flex items-start gap-3">
                <span class="mt-1 w-2 h-2 rounded-full bg-green-500"></span>
                Incomplete participation
              </li>

              <li class="flex items-start gap-3">
                <span class="mt-1 w-2 h-2 rounded-full bg-green-500"></span>
                Failure to complete assignments or labs
              </li>
            </ul>

            <Paragraph>
              By continuing participation beyond the first week, you acknowledge
              and accept the value and access already provided through the
              program.
            </Paragraph>
          </div>

          <!-- Section 4 -->
          <div class="space-y-4">
            <Titlenew>4. Processing Time</Titlenew>

            <Paragraph>
              Approved refunds are processed within 5–10 business days depending
              on your payment provider or financial institution.
            </Paragraph>

            <Paragraph>
              Refunds will be issued using the original payment method whenever
              possible.
            </Paragraph>
          </div>

          <!-- Section 5 -->
          <div class="space-y-4">
            <Titlenew>5. Program Transfers</Titlenew>

            <Paragraph>
              In certain situations, eligible participants may request:
            </Paragraph>

            <ul class="space-y-3 text-heading-2">
              <li class="flex items-start gap-3">
                <span class="mt-1 w-2 h-2 rounded-full bg-yellow-400"></span>
                Transfer to a future cohort
              </li>

              <li class="flex items-start gap-3">
                <span class="mt-1 w-2 h-2 rounded-full bg-yellow-400"></span>
                Credit toward another training program
              </li>
            </ul>

            <Paragraph>
              Transfer requests are reviewed on a case-by-case basis and are not
              guaranteed.
            </Paragraph>
          </div>

          <!-- Section 6 -->
          <div class="space-y-4">
            <Titlenew>6. Cancellation by CloudTweak</Titlenew>

            <Paragraph>
              If a program is canceled by CloudTweak for operational reasons,
              enrolled participants will receive either:
            </Paragraph>

            <ul class="space-y-3 text-heading-2">
              <li class="flex items-start gap-3">
                <span class="mt-1 w-2 h-2 rounded-full bg-red-400"></span>
                A full refund
              </li>

              <li class="flex items-start gap-3">
                <span class="mt-1 w-2 h-2 rounded-full bg-red-400"></span>
                The option to transfer enrollment to a future session
              </li>
            </ul>
          </div>

          <!-- Section 7 -->
          <div class="space-y-4">
            <Titlenew>7. Chargebacks & Payment Disputes</Titlenew>

            <Paragraph>
              Initiating unauthorized chargebacks or payment disputes without
              first contacting our support team may result in:
            </Paragraph>

            <ul class="space-y-3 text-heading-2">
              <li class="flex items-start gap-3">
                <span class="mt-1 w-2 h-2 rounded-full bg-pink-500"></span>
                Immediate suspension from the program
              </li>

              <li class="flex items-start gap-3">
                <span class="mt-1 w-2 h-2 rounded-full bg-pink-500"></span>
                Revocation of access to course materials and communities
              </li>

              <li class="flex items-start gap-3">
                <span class="mt-1 w-2 h-2 rounded-full bg-pink-500"></span>
                Restriction from future enrollments
              </li>
            </ul>

            <Paragraph>
              We encourage all participants to contact us directly so we can
              resolve concerns professionally and efficiently.
            </Paragraph>
          </div>

          <!-- Section 8 -->
          <div class="space-y-4">
            <Titlenew>8. Contact Us</Titlenew>

            <Paragraph>
              For refund inquiries or billing-related questions, please contact:
            </Paragraph>

            <div
              class="rounded-2xl
            border
            border-cyan-500/20
            bg-cyan-500/5
            p-6
            backdrop-blur-xl"
            >
              <p class="font-semibold text-heading-1">CloudTweak Support</p>

              <a
                href="mailto:support@cloudtweak.io"
                class="text-primary hover:underline"
              >
                support@cloudtweak.net
              </a>
            </div>
          </div>
          <Requirement />
        </div>
        <Selar />
      </Container>
    </section>
  </main>
</Layout>
