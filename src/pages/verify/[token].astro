---
import "../../styles/global.css";
import Layout from "../../layouts/Layout.astro";
import { CheckCircle2, ShieldCheck, Award, CalendarDays } from "lucide-react";

// Extract the certificate verification token from the dynamic route.
const { token } = Astro.params;

// Build the certificate verification API URL.
const verificationUrl = `https://uziqrzfbfjucelzmaaeq.supabase.co/functions/v1/verify-certificate?token=${token}`;

// Request certificate verification data from the Edge Function.
const response = await fetch(verificationUrl);

// Parse the verification response.
const result = await response.json();

// Determine whether the certificate is valid.
const isVerified = result.verified === true;

// Store the verified certificate data.
const certificate = result.certificate;
---

<Layout title="Certificate Verification | CloudTweak Academy">
  <main class="min-h-screen px-6 py-20">
    <section class="mx-auto w-full max-w-2xl">
      {
        isVerified ? (
          <div class="rounded-3xl border border-slate-200 bg-white p-8 shadow-sm dark:border-slate-800 dark:bg-slate-950 sm:p-12">
            <div class="text-center">
              <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-full bg-green-500">
                <CheckCircle2 className="h-11 w-11 text-green-600 dark:text-green-400" />
              </div>

              <p class="mt-6 text-sm font-semibold uppercase tracking-[0.2em] text-green-600 dark:text-white">
                Certificate Verified
              </p>

              <h1 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-4xl">
                This certificate is authentic
              </h1>

              <p class="mx-auto mt-4 max-w-lg text-base leading-7 text-slate-600 dark:text-slate-400">
                This certificate has been issued by CloudTweak Academy and
                successfully verified against our certificate records.
              </p>
            </div>

            <div class="mt-10 space-y-4">
              <div class="rounded-2xl border border-slate-200 bg-slate-50 p-5 dark:border-slate-800 dark:bg-slate-900/50">
                <div class="flex items-center gap-3">
                  <Award className="h-5 w-5 text-blue-600 dark:text-blue-400" />

                  <p class="text-sm text-slate-500 dark:text-slate-400">
                    Certificate Holder
                  </p>
                </div>

                <p class="mt-2 text-xl font-semibold text-slate-900 dark:text-slate-100">
                  {certificate.certificate_name}
                </p>
              </div>

              <div class="rounded-2xl border border-slate-200 bg-slate-50 p-5 dark:border-slate-800 dark:bg-slate-900/50">
                <div class="flex items-center gap-3">
                  <ShieldCheck className="h-5 w-5 text-blue-600 dark:text-blue-400" />

                  <p class="text-sm text-slate-500 dark:text-slate-400">
                    Course
                  </p>
                </div>

                <p class="mt-2 text-lg font-medium text-slate-900 dark:text-slate-100">
                  {certificate.course_name}
                </p>
              </div>

              <div class="grid gap-4 sm:grid-cols-2">
                <div class="rounded-2xl border border-slate-200 bg-slate-50 p-5 dark:border-slate-800 dark:bg-slate-900/50">
                  <p class="text-sm text-slate-500 dark:text-slate-400">
                    Certificate Number
                  </p>

                  <p class="mt-2 font-mono text-sm font-semibold text-blue-600 dark:text-blue-400">
                    {certificate.certificate_number}
                  </p>
                </div>

                <div class="rounded-2xl border border-slate-200 bg-slate-50 p-5 dark:border-slate-800 dark:bg-slate-900/50">
                  <div class="flex items-center gap-2">
                    <CalendarDays className="h-4 w-4 text-blue-600 dark:text-blue-400" />

                    <p class="text-sm text-slate-500 dark:text-slate-400">
                      Issued
                    </p>
                  </div>

                  <p class="mt-2 text-sm font-medium text-slate-900 dark:text-slate-100">
                    {new Date(certificate.issued_at).toLocaleDateString(
                      "en-US",
                      {
                        year: "numeric",
                        month: "long",
                        day: "numeric",
                      }
                    )}
                  </p>
                </div>
              </div>
            </div>

            <div class="mt-10 flex items-center justify-center gap-2 text-sm text-slate-500 dark:text-slate-400">
              <ShieldCheck className="h-4 w-4 text-green-600 dark:text-green-400" />

              <span>Verified by CloudTweak Technologies Limited</span>
            </div>
          </div>
        ) : (
          <div class="rounded-3xl border border-slate-200 bg-white p-8 text-center shadow-sm dark:border-slate-800 dark:bg-slate-950 sm:p-12">
            <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-full bg-red-500/10">
              <ShieldCheck className="h-11 w-11 text-red-600 dark:text-red-400" />
            </div>

            <p class="mt-6 text-sm font-semibold uppercase tracking-[0.2em] text-red-600 dark:text-red-400">
              Verification Failed
            </p>

            <h1 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 dark:text-slate-100">
              Certificate not found
            </h1>

            <p class="mx-auto mt-4 max-w-lg text-slate-600 dark:text-slate-400">
              We could not verify this certificate against CloudTweak Academy
              records.
            </p>
          </div>
        )
      }
    </section>
  </main>
</Layout>
