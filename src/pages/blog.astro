---
import "../styles/global.css";
import Layout from "../layouts/Layout.astro";
import Paragraph from "../components/shared/Paragraph.astro";
import Container from "../components/shared/Container.astro";
import Title from "../components/shared/Title.astro";
import { ArrowRight, Calendar } from "lucide-astro";
import { posts } from "../utils/blogdata";
---

<Layout title="CloudTweak | Blog">
  <section class="py-24">
    <Container>
      <div class="max-w-3xl mx-auto text-center my-6">
        <span
          class="inline-flex rounded-full bg-primary/10 px-5 py-2 text-primary font-semibold"
        >
          Blog Insights & Resources
        </span>


        <!-- <Paragraph className="mt-5">
          Stay updated with practical Microsoft 365 tips, Exchange Online,
          SharePoint, Microsoft Teams, Entra ID, Defender, Copilot and cloud
          administration insights.
        </Paragraph> -->

        <!-- <input
          type="text"
          placeholder="Search articles..."
          class="mt-10 w-full rounded-2xl border border-box-border px-6 py-4 bg-white dark:bg-box-bg outline-none focus:ring-2 focus:ring-primary"
        /> -->
      </div>

      <div class="grid md:grid-cols-2 xl:grid-cols-3 gap-8 mt-16">
        {
          posts.map((post) => (
            <div class="group overflow-hidden rounded-3xl border border-box-border bg-white dark:bg-box-bg shadow-lg hover:shadow-2xl transition duration-500 hover:-translate-y-2">
              <img
                src={post.image}
                alt={post.title}
                class="h-56 w-full object-cover group-hover:scale-105 transition duration-700"
              />

              <div class="p-7">
                <div class="flex items-center justify-between mb-4">
                  <span class="rounded-full bg-primary/10 px-3 py-1 text-xs font-semibold text-primary">
                    {post.category}
                  </span>

                  <span class="flex items-center gap-2 text-sm text-gray-500">
                    <Calendar size={15} />

                    {post.date}
                  </span>
                </div>

                <h3 class="text-xl font-bold text-heading-1 mb-4">
                  {post.title}
                </h3>

                <p class="text-gray-600 dark:text-gray-400 leading-7">
                  {post.excerpt}
                </p>

                <a
                  href={post.slug}
                  class="inline-flex items-center gap-2 mt-6 font-semibold text-primary hover:gap-3 transition-all"
                >
                  Read Article
                  <ArrowRight size={18} />
                </a>
              </div>
            </div>
          ))
        }
      </div>

      <!-- <div class="flex justify-center mt-16 gap-3">
        <a
          href="#"
          class="w-11 h-11 rounded-xl border flex items-center justify-center bg-primary text-white"
        >
          1
        </a>

        <a
          href="#"
          class="w-11 h-11 rounded-xl border flex items-center justify-center hover:bg-primary hover:text-white transition"
        >
          2
        </a>

        <a
          href="#"
          class="w-11 h-11 rounded-xl border flex items-center justify-center hover:bg-primary hover:text-white transition"
        >
          3
        </a>
      </div> -->
    </Container>
  </section>
</Layout>
