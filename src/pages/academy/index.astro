  <script>
    /**
     * Initialize the Academy search and category filtering.
     */
    function initializeAcademyFilters() {
      const searchInput = document.querySelector<HTMLInputElement>(
        "#academy-program-search"
      );

      const categoryButtons = Array.from(
        document.querySelectorAll<HTMLButtonElement>(".academy-category-filter")
      );

      const programCards = Array.from(
        document.querySelectorAll<HTMLElement>("[data-program-card]")
      );

      const emptyState = document.querySelector<HTMLElement>(
        "#academy-empty-search"
      );

      const clearButton = document.querySelector<HTMLButtonElement>(
        "#clear-academy-filters"
      );

      const resultCount = document.querySelector<HTMLElement>(
        "#academy-result-count"
      );

      let activeCategory = "all";

      /**
       * Update the visible program count.
       */
      function updateResultCount(count: number) {
        if (!resultCount) {
          return;
        }

        resultCount.textContent = `${count} ${
          count === 1 ? "program" : "programs"
        }`;
      }

      /**
       * Apply the active search phrase and category filter.
       */
      function applyFilters() {
        const searchValue = searchInput?.value.trim().toLowerCase() ?? "";

        let visibleCount = 0;

        programCards.forEach((card) => {
          const category = card.dataset.category ?? "";

          const searchableContent = card.dataset.search ?? "";

          const matchesCategory =
            activeCategory === "all" || category === activeCategory;

          const matchesSearch =
            !searchValue || searchableContent.includes(searchValue);

          const shouldDisplay = matchesCategory && matchesSearch;

          card.classList.toggle("hidden", !shouldDisplay);

          if (shouldDisplay) {
            visibleCount += 1;
          }
        });

        emptyState?.classList.toggle("hidden", visibleCount > 0);

        emptyState?.classList.toggle("flex", visibleCount === 0);

        updateResultCount(visibleCount);
      }

      /**
       * Update the visual state of category buttons.
       */
      function updateCategoryButtons() {
        categoryButtons.forEach((button) => {
          const isActive = button.dataset.categoryFilter === activeCategory;

          button.setAttribute("aria-pressed", String(isActive));

          button.classList.toggle("bg-primary", isActive);

          button.classList.toggle("text-white", isActive);

          button.classList.toggle("border", !isActive);

          button.classList.toggle("border-box-border", !isActive);

          button.classList.toggle("bg-body", !isActive);

          button.classList.toggle("text-heading-3", !isActive);
        });
      }

      // Filter programs as the visitor types.
      searchInput?.addEventListener("input", applyFilters);

      // Update the selected category.
      categoryButtons.forEach((button) => {
        button.addEventListener("click", () => {
          activeCategory = button.dataset.categoryFilter ?? "all";

          updateCategoryButtons();
          applyFilters();
        });
      });

      // Clear the current search and category selection.
      clearButton?.addEventListener("click", () => {
        activeCategory = "all";

        if (searchInput) {
          searchInput.value = "";
        }

        updateCategoryButtons();
        applyFilters();
      });

      updateCategoryButtons();
      applyFilters();
    }

    // Support normal navigation and Astro view transitions.
    document.addEventListener("astro:page-load", initializeAcademyFilters);

    // Initialize immediately when view transitions are not enabled.
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initializeAcademyFilters, {
        once: true,
      });
    } else {
      initializeAcademyFilters();
    }
  </script>
</Layout>
