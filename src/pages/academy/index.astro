---
import "../../styles/global.css";
import {
  ArrowRight,
  Award,
  BookOpen,
  CalendarDays,
  Check,
  Clock3,
  GraduationCap,
  Laptop,
  MapPin,
  Search,
  Sparkles,
  Users,
} from "lucide-astro";
import Layout from "../../layouts/Layout.astro";
import Container from "../../components/shared/Container.astro";
import { getPublishedAcademyPrograms } from "../../lib/academy";
import type { AcademyProgram } from "../../types/academy";

// Retrieve all published Academy programs from Supabase.
const programRecords = await getPublishedAcademyPrograms();

// Ensure the page always works with a valid array.
const programs: AcademyProgram[] = Array.isArray(programRecords)
  ? programRecords.filter((program): program is AcademyProgram =>
      Boolean(program)
    )
  : [];

// Keep featured programs at the beginning of the catalogue.
const sortedPrograms = [...programs].sort((firstProgram, secondProgram) => {
  if (firstProgram.featured !== secondProgram.featured) {
    return firstProgram.featured ? -1 : 1;
  }

  if (firstProgram.display_order !== secondProgram.display_order) {
    return firstProgram.display_order - secondProgram.display_order;
  }

  return firstProgram.title.localeCompare(secondProgram.title);
});

// Determine the lowest published program price for the pricing section.
const pricedPrograms = sortedPrograms.filter(
  (program) =>
    program.show_price &&
    Number.isFinite(program.discount_price ?? program.price)
);

const lowestProgramPrice =
  pricedPrograms.length > 0
    ? Math.min(
        ...pricedPrograms.map(
          (program) => program.discount_price ?? program.price
        )
      )
    : null;

// Resolve the currency used by the lowest-priced published program.
const lowestProgramCurrency =
  pricedPrograms.find(
    (program) =>
      (program.discount_price ?? program.price) === lowestProgramPrice
  )?.currency ?? "NGN";

/**
 * Format a numeric Academy price for the pricing section.
 */
function formatPricingAmount(amount: number | null, currency: string = "NGN") {
  if (amount === null) {
    return "Custom";
  }

  try {
    return new Intl.NumberFormat("en-US", {
      style: "currency",
      currency,
      maximumFractionDigits: 0,
    }).format(amount);
  } catch {
    return `${currency} ${amount.toLocaleString("en-US")}`;
  }
}
// Build a unique list of categories represented by published programs.
const categories = Array.from(
  new Map(
    sortedPrograms
      .filter((program) => program.category)
      .map((program) => [program.category!.id, program.category!])
  ).values()
);

/**
 * Convert an underscore-separated database value into a readable label.
 */
function formatEnumLabel(value: string) {
  return value
    .split("_")
    .map((word) => {
      return word.charAt(0).toUpperCase() + word.slice(1);
    })
    .join(" ");
}

/**
 * Format the duration of an Academy program.
 */
function formatProgramDuration(program: AcademyProgram) {
  if (!program.duration_value || !program.duration_unit) {
    return "Flexible duration";
  }

  const durationUnit =
    program.duration_value === 1
      ? program.duration_unit.replace(/s$/, "")
      : program.duration_unit;

  return `${program.duration_value} ${durationUnit}`;
}

/**
 * Format a program date for public display.
 */
function formatProgramDate(value: string | null) {
  if (!value) {
    return null;
  }

  const date = new Date(value);

  if (Number.isNaN(date.getTime())) {
    return null;
  }

  return new Intl.DateTimeFormat("en-US", {
    day: "numeric",
    month: "short",
    year: "numeric",
  }).format(date);
}

/**
 * Format a program price using its configured currency.
 */
function formatProgramPrice(program: AcademyProgram) {
  if (!program.show_price) {
    return "Contact us";
  }

  const amount =
    program.discount_price !== null ? program.discount_price : program.price;

  try {
    return new Intl.NumberFormat("en-US", {
      style: "currency",
      currency: program.currency || "NGN",
      maximumFractionDigits: 0,
    }).format(amount);
  } catch {
    return `${program.currency || "NGN"} ${amount.toLocaleString("en-US")}`;
  }
}

/**
 * Format the original price when a valid discount exists.
 */
function formatOriginalPrice(program: AcademyProgram) {
  if (
    !program.show_price ||
    program.discount_price === null ||
    program.discount_price >= program.price
  ) {
    return null;
  }

  try {
    return new Intl.NumberFormat("en-US", {
      style: "currency",
      currency: program.currency || "NGN",
      maximumFractionDigits: 0,
    }).format(program.price);
  } catch {
    return `${program.currency || "NGN"} ${program.price.toLocaleString(
      "en-US"
    )}`;
  }
}

/**
 * Select the best available programme image.
 */
function getProgramImage(program: AcademyProgram) {
  return (
    program.thumbnail_image_url ??
    program.hero_image_url ??
    program.banner_image_url ??
    null
  );
}

/**
 * Build searchable text used by the browser-side filtering logic.
 */
function getProgramSearchContent(program: AcademyProgram) {
  return [
    program.title,
    program.code,
    program.short_description,
    program.category?.name,
    program.delivery_mode,
    program.location,
    ...(program.tools_covered ?? []),
    ...(program.target_audience ?? []),
    ...(program.learning_outcomes ?? []),
  ]
    .filter(Boolean)
    .join(" ")
    .toLowerCase();
}

const pageTitle = "CloudTweak Academy";

const pageDescription =
  "Explore practical, instructor-led technology programs covering Microsoft 365, cloud computing, automation, security and modern workplace administration.";
---

<Layout title={pageTitle} description={pageDescription}>
  <main>
    {
      sortedPrograms.length > 0 ? (
        <>
          <section
            id="pricing"
            class="border-t border-box-border bg-body py-10"
          >
            <Container>
              <div class="mx-auto max-w-2xl text-center">
                <h2 class="text-3xl font-bold tracking-tight text-heading-1 sm:text-4xl">
                  Choose the learning path that fits you.
                </h2>

                <p class="mt-4 text-sm leading-7 text-heading-3">
                  Start with an individual program or talk to CloudTweak about
                  structured training for your team.
                </p>
              </div>

              <div class="mt-12 grid gap-6 lg:grid-cols-3">
                <article class="rounded-3xl border border-box-border bg-box-bg p-7 shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-xl">
                  <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-primary/10 text-primary">
                    <BookOpen size={20} />
                  </div>

                  <h3 class="mt-6 text-xl font-bold text-heading-1">
                    Individual Program
                  </h3>

                  <p class="mt-2 text-sm leading-6 text-heading-3">
                    Choose a focused program and build practical skills around a
                    specific technology or career goal.
                  </p>

                  <div class="mt-7">
                    <p class="text-xs font-semibold uppercase tracking-wide text-heading-3">
                      Programs from
                    </p>

                    <p class="mt-1 text-3xl font-extrabold text-heading-1">
                      {lowestProgramPrice !== null
                        ? formatPricingAmount(
                            lowestProgramPrice,
                            lowestProgramCurrency
                          )
                        : "Contact us"}
                    </p>
                  </div>

                  <ul class="mt-7 space-y-3">
                    <li class="flex gap-3 text-sm text-heading-3">
                      <Check class="mt-0.5 h-4 w-4 shrink-0 text-primary" />
                      Structured curriculum
                    </li>

                    <li class="flex gap-3 text-sm text-heading-3">
                      <Check class="mt-0.5 h-4 w-4 shrink-0 text-primary" />
                      Practical learning activities
                    </li>

                    <li class="flex gap-3 text-sm text-heading-3">
                      <Check class="mt-0.5 h-4 w-4 shrink-0 text-primary" />
                      Progress tracking
                    </li>

                    <li class="flex gap-3 text-sm text-heading-3">
                      <Check class="mt-0.5 h-4 w-4 shrink-0 text-primary" />
                      Certificate on eligible programs
                    </li>
                  </ul>

                  <a
                    href="#programs"
                    class="mt-8 inline-flex min-h-11 w-full items-center justify-center gap-2 rounded-xl bg-primary px-5 text-sm font-semibold text-white transition hover:opacity-90"
                  >
                    View programs
                    <ArrowRight size={16} />
                  </a>
                </article>

                <article class="relative overflow-hidden rounded-3xl border border-primary/30 bg-primary p-7 text-white shadow-xl shadow-primary/15">
                  <div class="absolute -right-10 -top-10 h-36 w-36 rounded-full bg-white/10 blur-2xl" />

                  <div class="relative">
                    <div class="flex items-center justify-between">
                      <div class="inline-flex rounded-full bg-white/15 px-3 py-1.5 text-[10px] font-bold uppercase tracking-[0.14em]">
                        Most popular
                      </div>

                      <GraduationCap size={21} />
                    </div>

                    <h3 class="mt-6 text-xl font-bold">
                      Professional Learning
                    </h3>

                    <p class="mt-2 text-sm leading-6 text-white/75">
                      Follow a structured learning path designed to help you
                      develop deeper technical capability and professional
                      confidence.
                    </p>

                    <div class="mt-7">
                      <p class="text-xs font-semibold uppercase tracking-wide text-white/60">
                        Start with
                      </p>

                      <p class="mt-1 text-3xl font-extrabold">
                        {lowestProgramPrice !== null
                          ? formatPricingAmount(
                              lowestProgramPrice,
                              lowestProgramCurrency
                            )
                          : "Program-based"}
                      </p>
                    </div>

                    <ul class="mt-7 space-y-3">
                      <li class="flex gap-3 text-sm text-white/90">
                        <Check class="mt-0.5 h-4 w-4 shrink-0" />
                        Guided learning experience
                      </li>

                      <li class="flex gap-3 text-sm text-white/90">
                        <Check class="mt-0.5 h-4 w-4 shrink-0" />
                        Labs and practical activities
                      </li>

                      <li class="flex gap-3 text-sm text-white/90">
                        <Check class="mt-0.5 h-4 w-4 shrink-0" />
                        Assessments and progress tracking
                      </li>

                      <li class="flex gap-3 text-sm text-white/90">
                        <Check class="mt-0.5 h-4 w-4 shrink-0" />
                        Certificate on eligible programs
                      </li>
                    </ul>

                    <a
                      href="/student/register"
                      class="mt-8 inline-flex min-h-11 w-full items-center justify-center gap-2 rounded-xl bg-white px-5 text-sm font-semibold text-slate-950 transition hover:bg-slate-100"
                    >
                      Start learning
                      <ArrowRight size={16} />
                    </a>
                  </div>
                </article>

                <article class="rounded-3xl border border-box-border bg-box-bg p-7 shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-xl">
                  <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-orange-50 text-orange-500 dark:bg-orange-950/30">
                    <Users size={20} />
                  </div>

                  <h3 class="mt-6 text-xl font-bold text-heading-1">
                    Team Training
                  </h3>

                  <p class="mt-2 text-sm leading-6 text-heading-3">
                    Upskill your team with focused training aligned with your
                    organization's technology environment.
                  </p>

                  <div class="mt-7">
                    <p class="text-xs font-semibold uppercase tracking-wide text-heading-3">
                      Pricing
                    </p>

                    <p class="mt-1 text-3xl font-extrabold text-heading-1">
                      Custom
                    </p>
                  </div>

                  <ul class="mt-7 space-y-3">
                    <li class="flex gap-3 text-sm text-heading-3">
                      <Check class="mt-0.5 h-4 w-4 shrink-0 text-primary" />
                      Team learning programs
                    </li>

                    <li class="flex gap-3 text-sm text-heading-3">
                      <Check class="mt-0.5 h-4 w-4 shrink-0 text-primary" />
                      Organization-focused training
                    </li>

                    <li class="flex gap-3 text-sm text-heading-3">
                      <Check class="mt-0.5 h-4 w-4 shrink-0 text-primary" />
                      Flexible delivery options
                    </li>

                    <li class="flex gap-3 text-sm text-heading-3">
                      <Check class="mt-0.5 h-4 w-4 shrink-0 text-primary" />
                      Enterprise engagement
                    </li>
                  </ul>

                  <a
                    href="/contact"
                    class="mt-8 inline-flex min-h-11 w-full items-center justify-center gap-2 rounded-xl border border-box-border bg-body px-5 text-sm font-semibold text-heading-1 transition hover:border-primary hover:text-primary"
                  >
                    Talk to CloudTweak
                    <ArrowRight size={16} />
                  </a>
                </article>
              </div>
            </Container>
          </section>
          <section class="sticky top-0 z-20 border-b border-t border-box-border bg-box-bg/95 py-5 backdrop-blur">
            <Container>
              <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
                <div class="relative w-full lg:max-w-md">
                  <Search
                    size={18}
                    class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-heading-3"
                  />

                  <input
                    id="academy-program-search"
                    type="search"
                    placeholder="Search programs, tools or categories..."
                    class="min-h-12 w-full rounded-2xl border border-box-border bg-body py-3 pl-12 pr-4 text-sm text-heading-1 outline-none transition placeholder:text-heading-3 focus:border-primary focus:ring-4 focus:ring-primary/10"
                  />
                </div>

                <div class="flex max-w-full gap-2 overflow-x-auto pb-1">
                  <button
                    type="button"
                    data-category-filter="all"
                    aria-pressed="true"
                    class="academy-category-filter shrink-0 rounded-full bg-primary px-4 py-2.5 text-sm font-semibold text-white transition"
                  >
                    All programs
                  </button>

                  {categories.map((category) => (
                    <button
                      type="button"
                      data-category-filter={category.slug}
                      aria-pressed="false"
                      class="academy-category-filter shrink-0 rounded-full border border-box-border bg-body px-4 py-2.5 text-sm font-semibold text-heading-3 transition hover:border-primary hover:text-primary"
                    >
                      {category.name}
                    </button>
                  ))}
                </div>
              </div>
            </Container>
          </section>

          <section class="py-14 sm:py-16" id="programs">
            <Container>
              <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
                <div>
                  <h2 class="mt-3 text-3xl font-bold tracking-tight text-heading-1">
                    Available training programs
                  </h2>

                  <p class="mt-3 max-w-2xl text-sm leading-7 text-heading-3">
                    Choose the program that matches your career goals, preferred
                    delivery method and technical interests.
                  </p>
                </div>

                <p
                  id="academy-result-count"
                  class="text-sm font-semibold text-heading-3"
                >
                  {sortedPrograms.length}

                  {sortedPrograms.length === 1 ? " program" : " programs"}
                </p>
              </div>

              <div
                id="academy-program-grid"
                class="grid gap-7 md:grid-cols-2 xl:grid-cols-3"
              >
                {sortedPrograms.map((program) => {
                  const programImage = getProgramImage(program);
                  const formattedStartDate = formatProgramDate(
                    program.start_date
                  );
                  const formattedPrice = formatProgramPrice(program);
                  const originalPrice = formatOriginalPrice(program);

                  return (
                    <article
                      data-program-card
                      data-category={program.category?.slug ?? ""}
                      data-search={getProgramSearchContent(program)}
                      class="group flex h-full flex-col overflow-hidden rounded-3xl border border-box-border bg-box-bg shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-xl"
                    >
                      <div class="relative h-56 overflow-hidden bg-slate-100 dark:bg-slate-900">
                        {programImage ? (
                          <img
                            src={programImage}
                            alt={`${program.title} cover`}
                            width="1200"
                            height="675"
                            loading="lazy"
                            class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
                          />
                        ) : (
                          <div class="flex h-full items-center justify-center bg-gradient-to-br from-blue-50 via-indigo-50 to-purple-50 dark:from-blue-950/30 dark:via-indigo-950/30 dark:to-purple-950/30">
                            <GraduationCap size={54} class="text-primary/60" />
                          </div>
                        )}

                        <div class="absolute inset-x-0 top-0 flex items-start justify-between gap-3 p-4">
                          <span class="rounded-full border border-white/60 bg-white/90 px-3 py-1.5 text-xs font-semibold text-slate-800 shadow-sm backdrop-blur-md">
                            {program.category?.name ?? "Academy Program"}
                          </span>

                          {program.featured ? (
                            <span class="rounded-full bg-amber-400 px-3 py-1.5 text-xs font-bold text-amber-950 shadow-sm">
                              Featured
                            </span>
                          ) : null}
                        </div>

                        <div class="absolute inset-x-0 bottom-0 p-4">
                          <span
                            class:list={[
                              "inline-flex items-center rounded-full px-3 py-1.5 text-xs font-semibold text-white shadow-sm backdrop-blur-md",
                              program.registration_open
                                ? "bg-emerald-500/95"
                                : "bg-red-500/95",
                            ]}
                          >
                            {program.registration_open
                              ? "Registration Open"
                              : "Registration Closed"}
                          </span>
                        </div>
                      </div>

                      <div class="flex flex-1 flex-col p-6">
                        <div class="flex-1">
                          {program.code ? (
                            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-primary">
                              {program.code}
                            </p>
                          ) : null}

                          <h3 class="mt-2 text-xl font-bold leading-8 text-heading-1 transition group-hover:text-primary">
                            <a href={`/academy/${program.slug}`}>
                              {program.title}
                            </a>
                          </h3>

                          <p class="mt-3 line-clamp-3 text-sm leading-6 text-heading-3">
                            {program.short_description ||
                              "Explore practical, instructor-led training designed to help you build real-world technical skills."}
                          </p>

                          <div class="mt-5 grid grid-cols-2 gap-3">
                            <div class="flex items-center gap-2 text-sm text-heading-3">
                              <Clock3 size={16} class="shrink-0 text-primary" />

                              <span class="truncate">
                                {formatProgramDuration(program)}
                              </span>
                            </div>

                            <div class="flex items-center gap-2 text-sm text-heading-3">
                              <Laptop size={16} class="shrink-0 text-primary" />

                              <span class="truncate">
                                {formatEnumLabel(program.delivery_mode)}
                              </span>
                            </div>

                            <div class="flex items-center gap-2 text-sm text-heading-3">
                              <CalendarDays
                                size={16}
                                class="shrink-0 text-primary"
                              />

                              <span class="truncate">
                                {formattedStartDate ?? "Date coming soon"}
                              </span>
                            </div>

                            {program.maximum_students ? (
                              <div class="flex items-center gap-2 text-sm text-heading-3">
                                <Users
                                  size={16}
                                  class="shrink-0 text-primary"
                                />

                                <span class="truncate">
                                  {program.maximum_students} seats
                                </span>
                              </div>
                            ) : program.location ? (
                              <div class="flex items-center gap-2 text-sm text-heading-3">
                                <MapPin
                                  size={16}
                                  class="shrink-0 text-primary"
                                />

                                <span class="truncate">{program.location}</span>
                              </div>
                            ) : (
                              <div class="flex items-center gap-2 text-sm text-heading-3">
                                <Award
                                  size={16}
                                  class="shrink-0 text-primary"
                                />

                                <span class="truncate">Certificate</span>
                              </div>
                            )}
                          </div>

                          {(program.tools_covered ?? []).length > 0 ? (
                            <div class="mt-5 flex flex-wrap gap-2">
                              {(program.tools_covered ?? [])
                                .slice(0, 4)
                                .map((tool) => (
                                  <span class="rounded-full border border-box-border bg-body px-2.5 py-1 text-xs font-medium text-heading-3">
                                    {tool}
                                  </span>
                                ))}

                              {(program.tools_covered ?? []).length > 4 ? (
                                <span class="rounded-full border border-box-border bg-body px-2.5 py-1 text-xs font-medium text-heading-3">
                                  +{(program.tools_covered ?? []).length - 4}{" "}
                                  more
                                </span>
                              ) : null}
                            </div>
                          ) : null}
                        </div>

                        <div class="mt-6 flex items-end justify-between gap-4 border-t border-box-border pt-5">
                          <a
                            href={`/academy/${program.slug}`}
                            aria-label={`View details for ${program.title}`}
                            class="inline-flex items-center justify-center gap-2 rounded-full bg-primary px-4 py-2.5 text-sm text-white transition duration-300 group-hover:translate-x-1 group-hover:shadow-lg"
                          >
                            View Full Details
                            <ArrowRight size={16} />
                          </a>
                        </div>
                      </div>
                    </article>
                  );
                })}
              </div>

              <div
                id="academy-empty-search"
                class="hidden min-h-[360px] flex-col items-center justify-center rounded-3xl border border-dashed border-box-border bg-box-bg px-6 py-14 text-center"
              >
                <div class="flex h-16 w-16 items-center justify-center rounded-3xl bg-primary/10 text-primary">
                  <Search size={28} />
                </div>

                <h3 class="mt-5 text-xl font-bold text-heading-1">
                  No matching programs
                </h3>

                <p class="mt-2 max-w-md text-sm leading-6 text-heading-3">
                  Try a different search phrase or select another category.
                </p>

                <button
                  id="clear-academy-filters"
                  type="button"
                  class="mt-5 rounded-xl border border-box-border bg-body px-5 py-2.5 text-sm font-semibold text-heading-1 transition hover:border-primary hover:text-primary"
                >
                  Clear filters
                </button>
              </div>
            </Container>
          </section>
          <section
            id="certification"
            class="border-t border-box-border py-20 sm:py-24"
          >
            <Container>
              <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
                <div>
                  <h2 class="mt-3 max-w-xl text-3xl font-bold tracking-tight text-heading-1 sm:text-4xl">
                    Finish your learning with something you can show.
                  </h2>

                  <p class="mt-5 max-w-xl text-base leading-7 text-heading-3">
                    Complete an eligible CloudTweak Academy program, meet its
                    learning requirements and earn a professional certificate
                    that reflects your achievement.
                  </p>

                  <div class="mt-8 space-y-5">
                    <div class="flex gap-4">
                      <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-primary/10 text-primary">
                        <Award size={20} />
                      </div>

                      <div>
                        <h3 class="font-bold text-heading-1">
                          Program-based certification
                        </h3>

                        <p class="mt-1 text-sm leading-6 text-heading-3">
                          Certification is tied to eligible programs and
                          successful completion of their required learning
                          activities.
                        </p>
                      </div>
                    </div>

                    <div class="flex gap-4">
                      <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-orange-50 text-orange-500 dark:bg-orange-950/30">
                        <GraduationCap size={20} />
                      </div>

                      <div>
                        <h3 class="font-bold text-heading-1">
                          Built around real learning
                        </h3>

                        <p class="mt-1 text-sm leading-6 text-heading-3">
                          Your certificate represents completed coursework,
                          practical activities and assessments—not simply
                          registration.
                        </p>
                      </div>
                    </div>

                    <div class="flex gap-4">
                      <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-emerald-50 text-emerald-600 dark:bg-emerald-950/30">
                        <Sparkles size={20} />
                      </div>

                      <div>
                        <h3 class="font-bold text-heading-1">
                          Designed for professional growth
                        </h3>

                        <p class="mt-1 text-sm leading-6 text-heading-3">
                          Build evidence of continuous learning as you develop
                          practical technology skills.
                        </p>
                      </div>
                    </div>
                  </div>
                </div>

                <div class="relative">
