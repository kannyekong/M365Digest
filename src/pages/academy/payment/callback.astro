---
import "../../../styles/global.css";
import {
  AlertCircle,
  ArrowRight,
  CheckCircle2,
  Clock3,
  LoaderCircle,
  ReceiptText,
  RefreshCw,
} from "lucide-astro";
import Layout from "../../../layouts/Layout.astro";
import Container from "../../../components/shared/Container.astro";

const pageTitle = "Payment Verification";

const pageDescription =
  "Verify your CloudTweak Academy payment and registration status.";
---

<Layout title={pageTitle} description={pageDescription}>
  <main>
    <section
      class="relative min-h-[70vh] overflow-hidden bg-body py-16 sm:py-20"
    >
      <div
        class="pointer-events-none absolute inset-0 overflow-hidden"
        aria-hidden="true"
      >
        <div
          class="absolute -left-24 top-12 h-72 w-72 rounded-full bg-blue-500/10 blur-3xl"
        >
        </div>

        <div
          class="absolute -right-24 bottom-0 h-80 w-80 rounded-full bg-purple-500/10 blur-3xl"
        >
        </div>
      </div>

      <Container>
        <div class="relative mx-auto max-w-2xl" data-payment-callback>
          <section
            data-verification-loading
            class="rounded-3xl border border-box-border bg-box-bg p-8 text-center shadow-xl sm:p-12"
          >
            <div
              class="mx-auto flex h-20 w-20 items-center justify-center rounded-3xl bg-primary/10 text-primary"
            >
              <LoaderCircle size={36} class="animate-spin" />
            </div>

            <p
              class="mt-6 text-sm font-semibold uppercase tracking-[0.16em] text-primary"
            >
              Payment verification
            </p>

            <h1 class="mt-3 text-3xl font-bold text-heading-1">
              Confirming your payment
            </h1>

            <p class="mx-auto mt-4 max-w-lg text-sm leading-7 text-heading-3">
              Please wait while we securely confirm your Paystack transaction
              and update your Academy registration.
            </p>
          </section>

          <section
            data-verification-success
            class="hidden rounded-3xl border border-emerald-200 bg-box-bg p-8 text-center shadow-xl dark:border-emerald-500/20 sm:p-12"
          >
            <div
              class="mx-auto flex h-20 w-20 items-center justify-center rounded-3xl bg-emerald-100 text-emerald-600 dark:bg-emerald-500/15 dark:text-emerald-300"
            >
              <CheckCircle2 size={38} />
            </div>

            <p
              class="mt-6 text-sm font-semibold uppercase tracking-[0.16em] text-emerald-600 dark:text-emerald-300"
            >
              Payment successful
            </p>

            <h1 class="mt-3 text-3xl font-bold text-heading-1">
              Your registration is confirmed
            </h1>

            <p
              data-success-message
              class="mx-auto mt-4 max-w-lg text-sm leading-7 text-heading-3"
            >
              Your payment has been verified successfully.
            </p>

            <div
              class="mt-8 rounded-2xl border border-box-border bg-body p-5 text-left"
            >
              <div class="space-y-4">
                <div class="flex items-start justify-between gap-4">
                  <span class="text-sm text-heading-3"> Learner </span>

                  <span
                    data-learner-name
                    class="text-right text-sm font-semibold text-heading-1"
                  >
                    —
                  </span>
                </div>

                <div class="flex items-start justify-between gap-4">
                  <span class="text-sm text-heading-3"> Program </span>

                  <span
                    data-program-title
                    class="max-w-[260px] text-right text-sm font-semibold text-heading-1"
                  >
                    —
                  </span>
                </div>

                <div class="flex items-start justify-between gap-4">
                  <span class="text-sm text-heading-3"> Amount paid </span>

                  <span
                    data-amount-paid
                    class="text-right text-sm font-semibold text-heading-1"
                  >
                    —
                  </span>
                </div>

                <div class="flex items-start justify-between gap-4">
                  <span class="text-sm text-heading-3">
                    Payment reference
                  </span>

                  <span
                    data-payment-reference
                    class="max-w-[260px] break-all text-right text-sm font-semibold text-heading-1"
                  >
                    —
                  </span>
                </div>

                <div class="flex items-start justify-between gap-4">
                  <span class="text-sm text-heading-3">
                    Registration status
                  </span>

                  <span
                    data-registration-status
                    class="rounded-full bg-emerald-100 px-3 py-1 text-xs font-semibold capitalize text-emerald-700 dark:bg-emerald-500/15 dark:text-emerald-300"
                  >
                    Confirmed
                  </span>
                </div>
              </div>
            </div>

            <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:justify-center">
              <a
                data-program-link
                href="/academy"
                class="inline-flex min-h-12 items-center justify-center gap-2 rounded-full bg-primary px-6 text-sm font-semibold text-white transition hover:opacity-90"
              >
                View program

                <ArrowRight size={17} />
              </a>

              <a
                href="/academy"
                class="inline-flex min-h-12 items-center justify-center gap-2 rounded-full border border-box-border bg-body px-6 text-sm font-semibold text-heading-1 transition hover:border-primary hover:text-primary"
              >
                Explore Academy
              </a>
            </div>

            <div
              class="mt-8 flex items-start gap-3 rounded-2xl bg-primary/5 p-4 text-left"
            >
              <ReceiptText size={20} class="mt-0.5 shrink-0 text-primary" />

              <p class="text-sm leading-6 text-heading-3">
                Keep your payment reference for your records. Your registration
                will also appear in the Academy admin dashboard.
              </p>
            </div>
          </section>

          <section
            data-verification-pending
            class="hidden rounded-3xl border border-amber-200 bg-box-bg p-8 text-center shadow-xl dark:border-amber-500/20 sm:p-12"
          >
            <div
              class="mx-auto flex h-20 w-20 items-center justify-center rounded-3xl bg-amber-100 text-amber-600 dark:bg-amber-500/15 dark:text-amber-300"
            >
              <Clock3 size={38} />
            </div>

            <p
              class="mt-6 text-sm font-semibold uppercase tracking-[0.16em] text-amber-600 dark:text-amber-300"
            >
              Payment processing
            </p>

            <h1 class="mt-3 text-3xl font-bold text-heading-1">
              We are still confirming your payment
            </h1>

            <p
              data-pending-message
              class="mx-auto mt-4 max-w-lg text-sm leading-7 text-heading-3"
            >
              Paystack has not confirmed the transaction yet. This can take a
              few moments.
            </p>

            <p
              data-pending-reference
              class="mt-5 break-all text-xs font-semibold text-heading-3"
            >
            </p>

            <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:justify-center">
              <button
                type="button"
                data-retry-verification
                class="inline-flex min-h-12 items-center justify-center gap-2 rounded-full bg-primary px-6 text-sm font-semibold text-white transition hover:opacity-90"
              >
                <RefreshCw size={17} />

                Check payment again
              </button>

              <a
                href="/academy"
                class="inline-flex min-h-12 items-center justify-center rounded-full border border-box-border bg-body px-6 text-sm font-semibold text-heading-1 transition hover:border-primary hover:text-primary"
              >
                Return to Academy
              </a>
            </div>
          </section>

          <section
            data-verification-error
            class="hidden rounded-3xl border border-red-200 bg-box-bg p-8 text-center shadow-xl dark:border-red-500/20 sm:p-12"
          >
            <div
              class="mx-auto flex h-20 w-20 items-center justify-center rounded-3xl bg-red-100 text-red-600 dark:bg-red-500/15 dark:text-red-300"
            >
              <AlertCircle size={38} />
            </div>

            <p
              class="mt-6 text-sm font-semibold uppercase tracking-[0.16em] text-red-600 dark:text-red-300"
            >
              Verification unsuccessful
            </p>

            <h1 class="mt-3 text-3xl font-bold text-heading-1">
              We could not confirm this payment
            </h1>

            <p
              data-error-message
              class="mx-auto mt-4 max-w-lg text-sm leading-7 text-heading-3"
            >
              The transaction could not be verified.
            </p>

            <p
              data-error-reference
              class="mt-5 break-all text-xs font-semibold text-heading-3"
            >
            </p>

            <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:justify-center">
              <button
                type="button"
                data-retry-verification
                class="inline-flex min-h-12 items-center justify-center gap-2 rounded-full bg-primary px-6 text-sm font-semibold text-white transition hover:opacity-90"
              >
                <RefreshCw size={17} />

                Try verification again
              </button>

              <a
                href="/academy"
                class="inline-flex min-h-12 items-center justify-center rounded-full border border-box-border bg-body px-6 text-sm font-semibold text-heading-1 transition hover:border-primary hover:text-primary"
              >
                Return to Academy
              </a>
            </div>

            <div
              class="mt-8 rounded-2xl border border-red-200 bg-red-50 p-4 text-left text-sm leading-6 text-red-700 dark:border-red-500/20 dark:bg-red-500/10 dark:text-red-300"
            >
              If your account was charged, do not make another payment
              immediately. Contact support with the payment reference shown
              above.
            </div>
          </section>
        </div>
      </Container>
    </section>
  </main>

  <script>
    interface PaymentVerificationResult {
      success: boolean;
      message?: string;
      paymentPending?: boolean;
      alreadyVerified?: boolean;
      registrationId?: string;
      reference?: string;
      paymentStatus?: string;
      registrationStatus?: string;
      amountPaid?: number;
      currency?: string;
      paidAt?: string | null;
      learnerName?: string;
      program?: {
        id?: string;
        title?: string;
        slug?: string;
      } | null;
    }

    /**
     * Format the paid amount returned by the verification API.
     */
    function formatPaidAmount(
      amount: number | undefined,
      currency: string | undefined
    ) {
      if (typeof amount !== "number") {
        return "—";
      }

      try {
        return new Intl.NumberFormat("en-US", {
          style: "currency",
          currency: currency || "NGN",
          maximumFractionDigits: 0,
        }).format(amount);
      } catch {
        return `${currency || "NGN"} ${amount.toLocaleString("en-US")}`;
      }
    }

    /**
     * Initialize Paystack callback verification.
     */
    function initializePaymentCallback() {
      const callbackRoot = document.querySelector<HTMLElement>(
        "[data-payment-callback]"
      );

      if (!callbackRoot) {
        return;
      }

      const loadingSection = callbackRoot.querySelector<HTMLElement>(
        "[data-verification-loading]"
      );

      const successSection = callbackRoot.querySelector<HTMLElement>(
        "[data-verification-success]"
      );

      const pendingSection = callbackRoot.querySelector<HTMLElement>(
        "[data-verification-pending]"
      );

      const errorSection = callbackRoot.querySelector<HTMLElement>(
        "[data-verification-error]"
      );

      const successMessage = callbackRoot.querySelector<HTMLElement>(
        "[data-success-message]"
      );

      const pendingMessage = callbackRoot.querySelector<HTMLElement>(
        "[data-pending-message]"
      );

      const errorMessage = callbackRoot.querySelector<HTMLElement>(
        "[data-error-message]"
      );

      const learnerName = callbackRoot.querySelector<HTMLElement>(
        "[data-learner-name]"
      );

      const programTitle = callbackRoot.querySelector<HTMLElement>(
        "[data-program-title]"
      );

      const amountPaid =
        callbackRoot.querySelector<HTMLElement>("[data-amount-paid]");

      const paymentReference = callbackRoot.querySelector<HTMLElement>(
        "[data-payment-reference]"
      );

      const registrationStatus = callbackRoot.querySelector<HTMLElement>(
        "[data-registration-status]"
      );

      const programLink = callbackRoot.querySelector<HTMLAnchorElement>(
        "[data-program-link]"
      );

      const pendingReference = callbackRoot.querySelector<HTMLElement>(
        "[data-pending-reference]"
      );

      const errorReference = callbackRoot.querySelector<HTMLElement>(
        "[data-error-reference]"
      );

      const retryButtons = Array.from(
        callbackRoot.querySelectorAll<HTMLButtonElement>(
          "[data-retry-verification]"
        )
      );

      let verifying = false;

      /**
       * Hide every verification state section.
       */
      function hideAllSections() {
        loadingSection?.classList.add("hidden");
        successSection?.classList.add("hidden");
        pendingSection?.classList.add("hidden");
        errorSection?.classList.add("hidden");
      }

      /**
       * Display the loading verification state.
       */
      function showLoadingState() {
        hideAllSections();
        loadingSection?.classList.remove("hidden");
      }

      /**
       * Display a successful verification result.
       */
      function showSuccessState(result: PaymentVerificationResult) {
        hideAllSections();
        successSection?.classList.remove("hidden");

        if (successMessage) {
          successMessage.textContent =
            result.message || "Your payment has been verified successfully.";
        }

        if (learnerName) {
          learnerName.textContent = result.learnerName || "Academy learner";
        }

        if (programTitle) {
          programTitle.textContent = result.program?.title || "Academy Program";
        }

        if (amountPaid) {
          amountPaid.textContent = formatPaidAmount(
            result.amountPaid,
            result.currency
          );
        }

        if (paymentReference) {
          paymentReference.textContent = result.reference || "—";
        }

        if (registrationStatus) {
          registrationStatus.textContent =
            result.registrationStatus || "confirmed";
        }

        if (programLink && result.program?.slug) {
          programLink.href = `/academy/${result.program.slug}`;
        }
      }

      /**
       * Display a payment-pending result.
       */
      function showPendingState(
        result: PaymentVerificationResult,
        reference: string
      ) {
        hideAllSections();
        pendingSection?.classList.remove("hidden");

        if (pendingMessage) {
          pendingMessage.textContent =
            result.message || "The payment is still being processed.";
        }

        if (pendingReference) {
          pendingReference.textContent = `Reference: ${result.reference || reference}`;
        }
      }

      /**
       * Display a payment verification error.
       */
      function showErrorState(message: string, reference?: string) {
        hideAllSections();
        errorSection?.classList.remove("hidden");

        if (errorMessage) {
          errorMessage.textContent = message;
        }

        if (errorReference) {
          errorReference.textContent = reference
            ? `Reference: ${reference}`
            : "";
        }
      }

      /**
       * Verify the Paystack transaction using the backend endpoint.
       */
      async function verifyPayment() {
        if (verifying) {
          return;
        }

        const searchParameters = new URLSearchParams(window.location.search);

        const reference =
          searchParameters.get("reference") || searchParameters.get("trxref");

        if (!reference) {
          showErrorState("No payment reference was found in the callback URL.");

          return;
        }

        verifying = true;
        showLoadingState();

        try {
          const response = await fetch("/api/academy/payments/verify", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify({
              reference,
            }),
          });

          const result = (await response.json()) as PaymentVerificationResult;

          if (response.ok && result.success) {
            showSuccessState(result);
            return;
          }

          if (result.paymentPending) {
            showPendingState(result, reference);
            return;
          }

          showErrorState(
            result.message || "The payment could not be verified.",
            result.reference || reference
          );
        } catch (error) {
          console.error("Payment callback verification failed:", error);

          showErrorState(
            "A network error occurred while verifying the payment. Please try again."
          );
        } finally {
          verifying = false;
        }
      }

      // Allow the learner to retry verification without reloading.
      retryButtons.forEach((button) => {
        button.addEventListener("click", () => {
          void verifyPayment();
        });
      });

      // Verify the transaction immediately after the callback page loads.
      void verifyPayment();
    }

    // Support normal page navigation and Astro view transitions.
    document.addEventListener("astro:page-load", initializePaymentCallback);

    // Initialize immediately when Astro view transitions are not enabled.
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initializePaymentCallback, {
        once: true,
      });
    } else {
      initializePaymentCallback();
    }
  </script>
</Layout>
