---
import "../styles/global.css";
import Layout from "../layouts/Layout.astro";
import Paragraph from "../components/shared/Paragraph.astro";
import Container from "../components/shared/Container.astro";
import Titlenew from "../components/shared/Titlenew.astro";
import Selar from "../components/sections/Selar.astro";
import Requirement from "../components/sections/Requirement.astro";
---

<Layout title="CloudTweak - M365 Bootcamp - T&C">
  <main class="flex flex-col gap-y-16 md:gap-y-24 overflow-hidden">
    <section class="relative py-6 overflow-hidden">
      <!-- Background Effects -->
      <div
        class="absolute top-0 left-0 w-72 h-72 bg-cyan-400/10 blur-3xl rounded-full"
      >
      </div>
      <div
        class="absolute bottom-0 right-0 w-96 h-96 bg-green-400/10 blur-3xl rounded-full"
      >
      </div>

      <Container className="relative z-10 max-w-5xl">
        <!-- Header -->
        <div class="text-center max-w-3xl mx-auto">
          <span
            class="inline-flex
          items-center
          rounded-full
          border
          border-cyan-500/20
          bg-cyan-500/10
          px-5
          py-2
          text-sm
          font-medium
          text-cyan-700
          dark:text-cyan-300
          backdrop-blur-xl"
          >
            CloudTweak Academy
          </span>

          <h1
            class="mt-8
          text-5xl/tight
          md:text-6xl/tight
          font-bold
          tracking-tight
          text-heading-1"
          >
            Privacy
            <span
              class="text-transparent
            bg-clip-text
            bg-gradient-to-r
            from-cyan-500
            via-primary
            to-green-500"
            >
              Policy
            </span>
          </h1>

          <Paragraph className="mt-6 text-lg">
            Last Updated: May 27, 2026
          </Paragraph>
        </div>

        <!-- Main Card -->
        <div
          class="mt-16
        rounded-[2rem]
        border
        border-white/10
        bg-white/5
        backdrop-blur-xl
        p-8
        md:p-12
        shadow-2xl
        space-y-12"
        >
          <!-- Intro -->
          <div class="space-y-4">
            <Titlenew>Welcome to CloudTweak Academy</Titlenew>

            <Paragraph>
              CloudTweak Academy (“CloudTweak”, “we”, “our”, or “us”) respects
              your privacy and is committed to protecting your personal
              information.
            </Paragraph>

            <Paragraph>
              This Privacy Policy explains how we collect, use, store, and
              protect your information when you use our website, enroll in our
              bootcamps, access training resources, or interact with our
              services.
            </Paragraph>
          </div>

          <!-- Section 1 -->
          <div class="space-y-4">
            <Titlenew>1. Information We Collect</Titlenew>

            <Paragraph>
              We may collect personal and technical information including:
            </Paragraph>

            <ul class="space-y-3 text-heading-2">
              <li class="flex items-start gap-3">
                <span class="mt-1 w-2 h-2 rounded-full bg-cyan-500"></span>
                Full name and contact details
              </li>

              <li class="flex items-start gap-3">
                <span class="mt-1 w-2 h-2 rounded-full bg-cyan-500"></span>
                Email address and communication records
              </li>

              <li class="flex items-start gap-3">
                <span class="mt-1 w-2 h-2 rounded-full bg-cyan-500"></span>
                Payment and billing information
              </li>

              <li class="flex items-start gap-3">
                <span class="mt-1 w-2 h-2 rounded-full bg-cyan-500"></span>
                Enrollment and training activity
              </li>

              <li class="flex items-start gap-3">
                <span class="mt-1 w-2 h-2 rounded-full bg-cyan-500"></span>
                Device, browser, and IP address information
              </li>

              <li class="flex items-start gap-3">
                <span class="mt-1 w-2 h-2 rounded-full bg-cyan-500"></span>
                Website analytics and usage data
              </li>
            </ul>
          </div>

          <!-- Section 2 -->
          <div class="space-y-4">
            <Titlenew>2. How We Use Your Information</Titlenew>

            <Paragraph> We use collected information to: </Paragraph>

            <ul class="space-y-3 text-heading-2">
              <li class="flex items-start gap-3">
                <span class="mt-1 w-2 h-2 rounded-full bg-green-500"></span>
                Process enrollments and payments
              </li>

              <li class="flex items-start gap-3">
                <span class="mt-1 w-2 h-2 rounded-full bg-green-500"></span>
                Deliver training programs and learning resources
              </li>

              <li class="flex items-start gap-3">
                <span class="mt-1 w-2 h-2 rounded-full bg-green-500"></span>
                Provide customer support and communication
              </li>

              <li class="flex items-start gap-3">
                <span class="mt-1 w-2 h-2 rounded-full bg-green-500"></span>
                Improve our website, services, and learning experience
              </li>

              <li class="flex items-start gap-3">
                <span class="mt-1 w-2 h-2 rounded-full bg-green-500"></span>
                Monitor platform security and prevent abuse
              </li>
            </ul>
          </div>

          <!-- Section 3 -->
          <div class="space-y-4">
            <Titlenew>3. Payment Information</Titlenew>

            <Paragraph>
              Payments may be processed through trusted third-party payment
              providers.
            </Paragraph>

            <Paragraph>
              CloudTweak does not directly store complete credit card or banking
              details on our servers unless explicitly stated by the payment
              provider.
            </Paragraph>
          </div>

          <!-- Section 4 -->
          <div class="space-y-4">
            <Titlenew>4. Cookies & Analytics</Titlenew>

            <Paragraph>
              Our website may use cookies, analytics tools, and tracking
              technologies to improve user experience and understand website
              usage patterns.
            </Paragraph>

            <Paragraph> Cookies may be used for: </Paragraph>

            <ul class="space-y-3 text-heading-2">
              <li class="flex items-start gap-3">
                <span class="mt-1 w-2 h-2 rounded-full bg-yellow-400"></span>
                Session management
              </li>

              <li class="flex items-start gap-3">
                <span class="mt-1 w-2 h-2 rounded-full bg-yellow-400"></span>
                Analytics and performance monitoring
              </li>

              <li class="flex items-start gap-3">
                <span class="mt-1 w-2 h-2 rounded-full bg-yellow-400"></span>
                Improving website functionality
              </li>
            </ul>
          </div>

          <!-- Section 5 -->
          <div class="space-y-4">
            <Titlenew>5. Data Sharing</Titlenew>

            <Paragraph>
              CloudTweak does not sell, rent, or trade your personal information
              to third parties.
            </Paragraph>

            <Paragraph>
              We may share limited information with trusted service providers
              strictly for operational purposes such as:
            </Paragraph>

            <ul class="space-y-3 text-heading-2">
              <li class="flex items-start gap-3">
                <span class="mt-1 w-2 h-2 rounded-full bg-pink-500"></span>
                Payment processing
              </li>

              <li class="flex items-start gap-3">
                <span class="mt-1 w-2 h-2 rounded-full bg-pink-500"></span>
                Email communication services
              </li>

              <li class="flex items-start gap-3">
                <span class="mt-1 w-2 h-2 rounded-full bg-pink-500"></span>
                Analytics and infrastructure hosting
              </li>
            </ul>

            <Paragraph>
              These providers are expected to maintain appropriate security and
              confidentiality standards.
            </Paragraph>
          </div>

          <!-- Section 6 -->
          <div class="space-y-4">
            <Titlenew>6. Data Security</Titlenew>

            <Paragraph>
              We implement reasonable administrative, technical, and
              organizational measures to help protect your information against
              unauthorized access, disclosure, or misuse.
            </Paragraph>

            <Paragraph>
              However, no internet-based platform or storage system can be
              guaranteed to be completely secure.
            </Paragraph>
          </div>

          <!-- Section 7 -->
          <div class="space-y-4">
            <Titlenew>7. Retention of Information</Titlenew>

            <Paragraph>
              We may retain certain information for operational, legal,
              compliance, educational, or support purposes.
            </Paragraph>

            <Paragraph>
              Retention periods may vary depending on the type of data collected
              and applicable business requirements.
            </Paragraph>
          </div>

          <!-- Section 8 -->
          <div class="space-y-4">
            <Titlenew>8. Third-Party Platforms</Titlenew>

            <Paragraph>
              CloudTweak training programs may integrate with third-party
              platforms such as Microsoft 365, Microsoft Azure, Tally, Selar,
              Chatbase, or other external services.
            </Paragraph>

            <Paragraph>
              Your interactions with third-party services are governed by their
              respective privacy policies and terms.
            </Paragraph>
          </div>

          <!-- Section 9 -->
          <div class="space-y-4">
            <Titlenew>9. Your Rights</Titlenew>

            <Paragraph>
              Depending on your location and applicable laws, you may have
              rights relating to your personal information, including the
              ability to:
            </Paragraph>

            <ul class="space-y-3 text-heading-2">
              <li class="flex items-start gap-3">
                <span class="mt-1 w-2 h-2 rounded-full bg-indigo-500"></span>
                Request access to your data
              </li>

              <li class="flex items-start gap-3">
                <span class="mt-1 w-2 h-2 rounded-full bg-indigo-500"></span>
                Request correction of inaccurate information
              </li>

              <li class="flex items-start gap-3">
                <span class="mt-1 w-2 h-2 rounded-full bg-indigo-500"></span>
                Request deletion of certain information
              </li>

              <li class="flex items-start gap-3">
                <span class="mt-1 w-2 h-2 rounded-full bg-indigo-500"></span>
                Opt out of non-essential communications
              </li>
            </ul>
          </div>

          <!-- Section 10 -->
          <div class="space-y-4">
            <Titlenew>10. Children's Privacy</Titlenew>

            <Paragraph>
              CloudTweak Academy services are not directed toward children under
              13 years old.
            </Paragraph>

            <Paragraph>
              We do not knowingly collect personal information from children
              without appropriate parental consent.
            </Paragraph>
          </div>

          <!-- Section 11 -->
          <div class="space-y-4">
            <Titlenew>11. Changes to This Policy</Titlenew>

            <Paragraph>
              CloudTweak may update or revise this Privacy Policy periodically
              to reflect operational, legal, or technological changes.
            </Paragraph>

            <Paragraph>
              Continued use of our services after updates constitutes acceptance
              of the revised policy.
            </Paragraph>
          </div>

          <!-- Section 12 -->
          <div class="space-y-4">
            <Titlenew>12. Contact Us</Titlenew>

            <Paragraph>
              If you have questions regarding this Privacy Policy or your
              personal information, please contact:
            </Paragraph>

            <div
              class="rounded-2xl
            border
            border-cyan-500/20
            bg-cyan-500/5
            p-6
            backdrop-blur-xl"
            >
              <p class="font-semibold text-heading-1">CloudTweak Support</p>

              <a
                href="mailto:support@cloudtweak.io"
                class="text-primary hover:underline"
              >
                support@cloudtweak.io
              </a>
            </div>
          </div>
          <Requirement />
        </div>
        <Selar />
      </Container>
    </section>
  </main>
</Layout>
