---
import AdminLayout from "../../../../layouts/AdminLayout.astro";

import Header from "../../../../components/admin/UI/Header.astro";
import ProductForm from "../../../../components/admin/tweakmart/products/ProductForm";

import { getTweakMartProductFormOptions } from "../../../../lib/tweakmart/product-options";

const options = await getTweakMartProductFormOptions();
---

<AdminLayout title="Add Product | CloudTweak Admin">
  <Header />

  <main class="w-full">
    <section class="mx-auto w-full max-w-[1600px] px-4 py-6 sm:px-6 lg:px-8">

      <div class="mt-6">
        <div
          class="flex flex-col gap-3 lg:flex-row lg:items-end lg:justify-between"
        >
          <div>
            <div
              class="flex items-center gap-2 text-xs font-semibold text-slate-500 dark:text-slate-400"
            >
              <a
                href="/admin/tweakmart/products"
                class="transition hover:text-primary"
              >
                Products
              </a>

              <span>/</span>

              <span>Add Product</span>
            </div>

            <h1
              class="mt-2 text-2xl font-bold tracking-tight text-slate-950 dark:text-white"
            >
              Add Product
            </h1>

            <p
              class="mt-1 max-w-2xl text-sm leading-6 text-slate-500 dark:text-slate-400"
            >
              Create the base TweakMart product, then continue with images,
              variants, and inventory.
            </p>
          </div>
        </div>

        <ProductForm client:load options={options} />
      </div>
    </section>
  </main>
</AdminLayout>
