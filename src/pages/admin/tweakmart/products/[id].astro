---
import AdminLayout from "../../../../layouts/AdminLayout.astro";

import Header from "../../../../components/admin/UI/Header.astro";
import ProductForm from "../../../../components/admin/tweakmart/products/ProductForm";

import { getTweakMartProductFormOptions } from "../../../../lib/tweakmart/product-options";
import { getTweakMartProductById } from "../../../../lib/tweakmart/products";

const productId = Astro.params.id;

if (!productId) {
  return Astro.redirect("/admin/tweakmart/products");
}

const [product, options] = await Promise.all([
  getTweakMartProductById(productId),
  getTweakMartProductFormOptions(),
]);

if (!product) {
  Astro.response.status = 404;
}
---

<AdminLayout
  title={product
    ? `${product.name} | TweakMart Admin`
    : "Product Not Found | TweakMart Admin"}
>
  <Header />

  <main class="w-full">
    <section class="mx-auto w-full max-w-[1600px] px-4 py-6 sm:px-6 lg:px-8">
      {
        product ? (
          <div class="mt-6">
            <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
              <div>
                <div class="flex flex-wrap items-center gap-2 text-xs font-semibold text-slate-500 dark:text-slate-400">
                  <a
                    href="/admin/tweakmart/products"
                    class="transition hover:text-primary"
                  >
                    Products
                  </a>

                  <span>/</span>

                  <span>{product.name}</span>
                </div>

                <h1 class="mt-2 text-2xl font-bold tracking-tight text-slate-950 dark:text-white">
                  Edit Product
                </h1>

                <p class="mt-1 max-w-2xl text-sm leading-6 text-slate-500 dark:text-slate-400">
                  Manage product information, pricing, visibility, media,
                  variants, and inventory.
                </p>
              </div>

              <a
                href={`https://tweakmart.cloudtweak.net/products/${product.slug}`}
                target="_blank"
                rel="noreferrer"
                class="inline-flex min-h-10 items-center justify-center rounded-xl border border-slate-200 px-4 text-xs font-bold text-slate-600 transition hover:bg-slate-50 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-900"
              >
                View Storefront
              </a>
            </div>

            <ProductForm client:load options={options} product={product} />
          </div>
        ) : (
          <div class="mt-6 rounded-2xl border border-slate-200 bg-white px-6 py-16 text-center shadow-sm dark:border-slate-800 dark:bg-slate-950">
            <h1 class="text-lg font-bold text-slate-950 dark:text-white">
              Product not found
            </h1>

            <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">
              The requested TweakMart product could not be found.
            </p>

            <a
              href="/admin/tweakmart/products"
              class="mt-5 inline-flex min-h-10 items-center rounded-xl bg-primary px-4 text-xs font-bold text-white"
            >
              Back to Products
            </a>
          </div>
        )
      }
    </section>
  </main>
</AdminLayout>
