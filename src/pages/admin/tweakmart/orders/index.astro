---
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import TweakMartModuleNav from "../../../../components/admin/tweakmart/TweakMartModuleNav";
import TweakMartOrdersTable from "../../../../components/admin/tweakmart/orders/TweakmartOrderTable";

import { getTweakMartAdminOrders } from "../../../../lib/tweakmart/order";
import Header from "../../../../components/admin/UI/Header.astro";

/* Loads TweakMart order data for the CloudTweak management workspace. */
const { orders, stats } = await getTweakMartAdminOrders();
---

<AdminLayout title="TweakMart Orders">
  <Header title="Tweakmart Orders" />
  <div class="space-y-6 p-5">
    <div>
      <h1
        class="mt-2 text-2xl font-bold tracking-tight text-slate-950 dark:text-white"
      >
        Orders
      </h1>

      <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">
        Manage Marketplace orders, payments, inventory fulfillment and
        exceptions.
      </p>
    </div>

    <TweakMartModuleNav current="orders" client:load/>

    <section class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4 mt-5">
      <div
        class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-800 dark:bg-slate-950"
      >
        <p class="text-xs font-medium text-slate-500 dark:text-slate-400">
          Total Orders
        </p>

        <p class="mt-2 text-2xl font-bold text-slate-950 dark:text-white">
          {stats.totalOrders.toLocaleString()}
        </p>

        <p class="mt-1 text-xs text-slate-400">All Marketplace orders</p>
      </div>

      <div
        class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-800 dark:bg-slate-950"
      >
        <p class="text-xs font-medium text-slate-500 dark:text-slate-400">
          Paid
        </p>

        <p
          class="mt-2 text-2xl font-bold text-emerald-600 dark:text-emerald-400"
        >
          {stats.paidOrders.toLocaleString()}
        </p>

        <p class="mt-1 text-xs text-slate-400">Payment completed</p>
      </div>

      <div
        class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-800 dark:bg-slate-950"
      >
        <p class="text-xs font-medium text-slate-500 dark:text-slate-400">
          Pending
        </p>

        <p class="mt-2 text-2xl font-bold text-amber-600 dark:text-amber-400">
          {stats.pendingOrders.toLocaleString()}
        </p>

        <p class="mt-1 text-xs text-slate-400">Awaiting progression</p>
      </div>

      <div
        class:list={[
          "rounded-2xl border p-4 shadow-sm",
          stats.manualReviewOrders > 0
            ? "border-amber-200 bg-amber-50 dark:border-amber-500/20 dark:bg-amber-500/10"
            : "border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-950",
        ]}
      >
        <p
          class:list={[
            "text-xs font-medium",
            stats.manualReviewOrders > 0
              ? "text-amber-700 dark:text-amber-300"
              : "text-slate-500 dark:text-slate-400",
          ]}
        >
          Manual Review
        </p>

        <p
          class:list={[
            "mt-2 text-2xl font-bold",
            stats.manualReviewOrders > 0
              ? "text-amber-800 dark:text-amber-200"
              : "text-slate-950 dark:text-white",
          ]}
        >
          {stats.manualReviewOrders.toLocaleString()}
        </p>

        <p
          class:list={[
            "mt-1 text-xs",
            stats.manualReviewOrders > 0
              ? "text-amber-600 dark:text-amber-400"
              : "text-slate-400",
          ]}
        >
          {
            stats.manualReviewOrders > 0
              ? "Requires administrator attention"
              : "No payment exceptions"
          }
        </p>
      </div>
    </section>

    <TweakMartOrdersTable orders={orders} client:load />
  </div>
</AdminLayout>
