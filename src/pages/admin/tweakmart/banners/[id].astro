---
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import Header from "../../../../components/admin/UI/Header.astro";
import TweakMartModuleNav from "../../../../components/admin/tweakmart/TweakMartModuleNav";
import BannerForm from "../../../../components/admin/tweakmart/banners/BannerForm";
import { getTweakMartBanner } from "../../../../lib/tweakmart/banner";

const bannerId = Astro.params.id;

/* Redirects back to banner management when no banner identifier is available. */
if (!bannerId) {
  return Astro.redirect("/admin/tweakmart/banners");
}

/* Loads the selected TweakMart banner for editing. */
const banner = await getTweakMartBanner(bannerId);

/* Redirects invalid banner requests back to the management table. */
if (!banner) {
  return Astro.redirect("/admin/tweakmart/banners");
}
---

<AdminLayout title={`Edit ${banner.title}`}>
  <Header description="TweakMart - Edit storefront featured banner" />

  <main class="min-h-screen">
    <section class="mx-auto w-full max-w-[1600px] px-4 py-6 sm:px-6 lg:px-8">
      <TweakMartModuleNav current="banners" />

      <div class="mt-8">
        <div>
          <p
            class="text-xs font-semibold uppercase tracking-[0.16em] text-primary"
          >
            Storefront Merchandising
          </p>

          <h1 class="mt-2 text-2xl font-bold text-slate-950 dark:text-white">
            Edit Featured Banner
          </h1>

          <p
            class="mt-2 max-w-2xl text-sm leading-6 text-slate-500 dark:text-slate-400"
          >
            Update the banner image, destination, display priority, visibility
            and campaign scheduling.
          </p>
        </div>

        <BannerForm client:load banner={banner} />
      </div>
    </section>
  </main>
</AdminLayout>
