---
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import Header from "../../../../components/admin/UI/Header.astro";

import TweakMartModuleNav from "../../../../components/admin/tweakmart/TweakMartModuleNav";
import BannerTable from "../../../../components/admin/tweakmart/banners/BannerTable";

import { getTweakMartBanners } from "../../../../lib/tweakmart/banner";

/* Loads all featured banners before rendering the administrative management page. */
const banners = await getTweakMartBanners();
---

<AdminLayout title="TweakMart Featured Banners">
  <Header
    description="TweakMart - Manage storefront promotional and featured banners"
  />

  <main class="min-h-screen">
    <section class="mx-auto w-full max-w-[1600px] px-4 py-6 sm:px-6 lg:px-8">
      <TweakMartModuleNav current="banners" />

      <div class="mt-8">
        <div
          class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between"
        >
          <div>
            <p
              class="text-xs font-semibold uppercase tracking-[0.16em] text-primary"
            >
              Storefront Merchandising
            </p>

            <h1 class="mt-2 text-2xl font-bold text-slate-950 dark:text-white">
              Featured Banners
            </h1>

            <p
              class="mt-2 max-w-2xl text-sm leading-6 text-slate-500 dark:text-slate-400"
            >
              Control promotional images displayed in the TweakMart storefront
              hero. Schedule campaigns, control their order and disable banners
              without deleting them.
            </p>
          </div>

          <a
            href="/admin/tweakmart/banners/new"
            class="inline-flex shrink-0 items-center justify-center rounded-xl bg-primary px-4 py-2.5 text-xs font-semibold text-white shadow-sm transition hover:opacity-90"
          >
            + Add Featured Banner
          </a>
        </div>

        <BannerTable client:load initialBanners={banners} />
      </div>
    </section>
  </main>
</AdminLayout>
