---
export const prerender = false;

import AdminLayout from "../../../../layouts/AdminLayout.astro";
import Header from "../../../../components/admin/UI/Header.astro";
import AcademyChat from "../../../../islands/academy/AcademyChat";
---

<AdminLayout title="Academy Chat">
  <Header />
  <section class="p-5">
    <div class="mb-6">
      <p class="text-xs font-semibold uppercase tracking-[0.16em] text-sky-600">Academy Support</p>
      <h1 class="mt-2 text-2xl font-bold text-slate-900 dark:text-white">Student Chat Inbox</h1>
      <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-500 dark:text-slate-400">Reply to private student conversations from the Academy portal.</p>
    </div>
    <AcademyChat client:load role="admin" />
  </section>
</AdminLayout>
