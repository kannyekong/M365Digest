---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import Header from "../../../components/admin/UI/Header.astro";
import AcademyModuleNav from "../../../components/admin/academy/AcademyModuleNav";
import AcademyLiveSessionsPage from "../../../islands/AcademyLiveSessionPage";
---

<AdminLayout title="Academy Categories">
  <Header title="Academy Categories" />
  <main class="space-y-8 lg:p-5">
    <header
      class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between"
    >
      <div>
        <h1 class="mt-2 text-xl font-bold text-slate-950">
          Create and manage a meeting session for programs
        </h1>

        <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-500">
          Add a meeting session to a learning module, or session.
        </p>
      </div>

      <a
        href="/admin/academy/programs"
        class="inline-flex min-h-12 items-center justify-center rounded-2xl border border-slate-300 bg-white px-5 text-sm font-semibold text-slate-700 transition hover:bg-slate-50"
      >
        View Programs
      </a>
    </header>

    <AcademyModuleNav current="Sessions" />

    <AcademyLiveSessionsPage client:load />
  </main>
</AdminLayout>
