---
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import ProcurementPortalsWorkspace from "../../../../components/admin/procurement/ProcurementPortalsWorkspace";
import Header from "../../../../components/admin/UI/Header.astro";
---

<AdminLayout title="Procurement Portals">
  <Header />
  <div class="space-y-6 p-5">
    <div>
      <h1 class="mt-3 text-2xl font-semibold tracking-tight">
        Procurement Portals
      </h1>

      <p class="mt-2 max-w-2xl text-sm text-black/60 dark:text-white/60">
        Maintain the external procurement channels where CloudTweak can discover
        opportunities, register as a vendor and participate in RFQs and tenders.
      </p>
    </div>

    <ProcurementPortalsWorkspace client:load />
  </div>
</AdminLayout>
