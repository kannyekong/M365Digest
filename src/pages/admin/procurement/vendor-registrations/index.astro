---
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import VendorRegistrationsWorkspace from "../../../../components/admin/procurement/VendorRegistrationWorkspace";
import Header from "../../../../components/admin/UI/Header.astro";
---

<AdminLayout title="Vendor Registrations">
  <Header />
  <div class="space-y-6 p-5">
    <div>
      <h1 class="mt-3 text-2xl font-semibold tracking-tight">
        Vendor Registrations
      </h1>

      <p class="mt-2 max-w-2xl text-sm text-black/60 dark:text-white/60">
        Track supplier registration requirements, submissions, approvals,
        renewals and follow-up actions across procurement portals.
      </p>
    </div>

    <VendorRegistrationsWorkspace client:load />
  </div>
</AdminLayout>
