---
import { ArrowDownUp, Check, DollarSign, Users, Workflow } from "lucide-react";
import Header from "../../../components/admin/UI/Header.astro";
import { SummaryCard } from "../../../islands/AdminSummaryCard";
import AdminLayout from "../../../layouts/AdminLayout.astro";
import {
  getProcurementStatistics,
  getProcurementLeads,
  getProcurementOpportunities,
} from "../../../lib/procurement";

/* Loads the procurement dashboard statistics and current pipeline data. */
const [statistics, leadsResult, opportunitiesResult] = await Promise.all([
  getProcurementStatistics(),
  getProcurementLeads({
    page: 1,
    page_size: 5,
  }),
  getProcurementOpportunities({
    page: 1,
    page_size: 5,
  }),
]);

/* Formats monetary values using the Nigerian Naira presentation used by CloudTweak. */
function formatCurrency(value: number, currency = "NGN") {
  return new Intl.NumberFormat("en-NG", {
    style: "currency",
    currency,
    maximumFractionDigits: 0,
  }).format(value);
}

/* Formats a date into a compact dashboard-friendly representation. */
function formatDate(value: string | null) {
  if (!value) return "No date";

  return new Intl.DateTimeFormat("en-NG", {
    day: "numeric",
    month: "short",
    year: "numeric",
  }).format(new Date(value));
}

/* Converts an opportunity stage into a human-readable label. */
function formatStage(stage: string) {
  return stage
    .split("_")
    .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
    .join(" ");
}

/* Converts a lead status into a human-readable label. */
function formatStatus(status: string) {
  return status.charAt(0).toUpperCase() + status.slice(1);
}
---

<AdminLayout title="Procurement & Business Development">
  <Header title="Procurement Dashboard" />
  <div class="min-h-screen p-5">
    <div class="mx-auto max-w-[1500px]">
      <div
        class="flex flex-col gap-5 lg:flex-row lg:items-center lg:justify-between"
      >
        <div>
          <h1
            class="mt-1 text-xl font-bold tracking-tight text-slate-900 dark:text-white"
          >
            Procurement & Business Development
          </h1>

          <p class="mt-2 max-w-3xl text-xs text-slate-600 dark:text-slate-400">
            Track prospects, procurement opportunities, vendor registrations,
            proposals and contracts from first contact through close.
          </p>
        </div>

        <div class="flex flex-wrap gap-3">
          <a
            href="/admin/procurement/leads/"
            class="inline-flex items-center justify-center rounded-xl bg-primary px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-primary-700"
          >
            View Leads
          </a>

          <a
            href="/admin/procurement/opportunities/"
            class="inline-flex items-center justify-center rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50 dark:border-white/10 dark:bg-white/5 dark:text-slate-200 dark:hover:bg-white/10"
          >
            View Opportunities
          </a>
        </div>
      </div>

      <div class="mt-8 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
        <SummaryCard
          label="Active Leads"
          value={statistics.active_leads}
          icon={Users}
          iconBackgroundColor="bg-green-50"
          iconColor="text-green-500"
          description={`${statistics.qualified_leads} qualified`}
        />

        <SummaryCard
          label="Open Opportunities"
          value={statistics.open_opportunities}
          icon={Workflow}
          iconBackgroundColor="bg-blue-50"
          iconColor="text-blue-500"
          description={`Currently in pipeline`}
        />

        <SummaryCard
          label="Pipeline Value"
          value={formatCurrency(statistics.pipeline_value)}
          icon={DollarSign}
          iconBackgroundColor="bg-green-50"
          iconColor="text-green-500"
          description={`Total open opportunity value`}
        />

        <SummaryCard
          label="Weighted Pipeline"
          value={formatCurrency(statistics.weighted_pipeline_value)}
          icon={ArrowDownUp}
          iconBackgroundColor="bg-yellow-50"
          iconColor="text-yellow-500"
          description={`Based on opportunity probability`}
        />
      </div>

      <div class="mt-8 grid gap-6 xl:grid-cols-2">
        <section
          class="rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-white/10 dark:bg-white/5"
        >
          <div
            class="flex items-center justify-between border-b border-slate-200 px-5 py-4 dark:border-white/10"
          >
            <div>
              <h2 class="font-semibold text-slate-900 dark:text-white">
                Recent Leads
              </h2>

              <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">
                Latest business-development prospects
              </p>
            </div>

            <a
              href="/admin/procurement/leads"
              class="text-sm font-semibold underline text-primary hover:text-primary-700 dark:text-primary-400"
            >
              View all
            </a>
          </div>

          <div class="divide-y divide-slate-100 dark:divide-white/5">
            {
              leadsResult.data.length === 0 ? (
                <div class="px-5 py-10 text-center">
                  <p class="text-sm font-medium text-slate-700 dark:text-slate-300">
                    No procurement leads yet.
                  </p>

                  <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">
                    Start by adding your first prospect.
                  </p>
                </div>
              ) : (
                leadsResult.data.map((lead) => (
                  <a
                    href={`/admin/procurement/leads/${lead.id}`}
                    class="block px-5 py-4 transition hover:bg-slate-50 dark:hover:bg-white/5"
                  >
                    <div class="flex items-start justify-between gap-4">
                      <div class="min-w-0">
                        <p class="truncate text-sm font-semibold text-slate-900 dark:text-white">
                          {lead.title}
                        </p>

                        <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">
                          {lead.client_name ?? "Unassigned company"}
                          {lead.contact_name ? ` · ${lead.contact_name}` : ""}
                        </p>
                      </div>

                      <span class="shrink-0 rounded-full bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-600 dark:bg-white/10 dark:text-slate-300">
                        {formatStatus(lead.status)}
                      </span>
                    </div>

                    <div class="mt-3 flex items-center justify-between text-xs text-slate-500 dark:text-slate-400">
                      <span>{lead.lead_code}</span>
                      <span>{formatDate(lead.created_at)}</span>
                    </div>
                  </a>
                ))
              )
            }
          </div>
        </section>

        <section
          class="rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-white/10 dark:bg-white/5"
        >
          <div
            class="flex items-center justify-between border-b border-slate-200 px-5 py-4 dark:border-white/10"
          >
            <div>
              <h2 class="font-semibold text-slate-900 dark:text-white">
                Opportunity Pipeline
              </h2>

              <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">
                Latest active opportunities
              </p>
            </div>

            <a
              href="/admin/procurement/opportunities"
              class="text-sm font-semibold text-primary underline hover:text-primary-700 dark:text-primary-400"
            >
              View pipeline
            </a>
          </div>

          <div class="divide-y divide-slate-100 dark:divide-white/5">
            {
              opportunitiesResult.data.length === 0 ? (
                <div class="px-5 py-10 text-center">
                  <p class="text-sm font-medium text-slate-700 dark:text-slate-300">
                    No opportunities yet.
                  </p>

                  <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">
                    Qualified leads can become opportunities.
                  </p>
                </div>
              ) : (
                opportunitiesResult.data.map((opportunity) => (
                  <a
                    href={`/admin/procurement/opportunities/${opportunity.id}`}
                    class="block px-5 py-4 transition hover:bg-slate-50 dark:hover:bg-white/5"
                  >
                    <div class="flex items-start justify-between gap-4">
                      <div class="min-w-0">
                        <p class="truncate text-sm font-semibold text-slate-900 dark:text-white">
                          {opportunity.name}
                        </p>

                        <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">
                          {opportunity.client_name ?? "Unknown client"}
                        </p>
                      </div>

                      <span class="shrink-0 rounded-full bg-green-200 px-2.5 py-1 text-xs font-medium text-slate-700 dark:bg-white/10 dark:text-slate-300">
                        {formatStage(opportunity.stage)}
                      </span>
                    </div>

                    <div class="mt-3 flex items-center justify-between text-xs">
                      <span class="text-slate-500 dark:text-slate-400">
                        {opportunity.opportunity_code}
                      </span>

                      <span class="font-semibold text-slate-700 dark:text-slate-200">
                        {formatCurrency(
                          Number(opportunity.estimated_value ?? 0),
                          opportunity.currency
                        )}
                      </span>
                    </div>
                  </a>
                ))
              )
            }
          </div>
        </section>
      </div>
    </div>
  </div>
</AdminLayout>
