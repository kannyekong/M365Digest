---
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import ProcurementNegotiationsWorkspace from "../../../../components/admin/procurement/ProcurementNegotiationsWorkspace";
import Header from "../../../../components/admin/UI/Header.astro";

const pageTitle = "Negotiations";
const pageDescription =
  "Manage commercial negotiations, concessions, next actions and agreed terms across procurement opportunities.";
---

<AdminLayout title={pageTitle}>
  <Header title={pageDescription} />
  <div class="space-y-6 p-5">
    <div>
      <div
        class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between"
      >
        <div>
          <h1
            class="text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100"
          >
            Negotiations
          </h1>
          <p class="mt-1 max-w-3xl text-sm text-zinc-500 dark:text-zinc-400">
            {pageDescription}
          </p>
        </div>
      </div>
    </div>

    <ProcurementNegotiationsWorkspace client:load />
  </div>
</AdminLayout>
