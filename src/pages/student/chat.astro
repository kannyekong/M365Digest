---
export const prerender = false;

import StudentLayout from "../../layouts/StudentLayout.astro";
import StudentHeader from "../../components/admin/UI/StudentHeader.astro";
import AcademyChat from "../../islands/academy/AcademyChat";
---

<StudentLayout title="Academy Chat" description="Private chat with CloudTweak Academy support.">
  <StudentHeader
    eyebrow="Academy Support"
    title="Chat with Support"
    description="Send a private message to the Academy support team and keep the conversation in one place."
  />
  <main class="min-h-screen p-5">
    <AcademyChat client:load role="student" />
  </main>
</StudentLayout>
