---
export const prerender = false;

import StudentLayout from "../../layouts/StudentLayout.astro";
import StudentHeader from "../../components/admin/UI/StudentHeader.astro";
import StudentAccountSettings from "../../islands/student/StudentAccountSettings";
---

<StudentLayout
  title="Account Settings"
  description="Manage your CloudTweak Academy account."
>
  <StudentHeader
    eyebrow="Account"
    title="Account Settings"
    description="Manage your profile, password and account security."
  />

  <main class="min-h-screen p-5">
    <div class="mx-auto max-w-[1180px]">
      <StudentAccountSettings client:load />
    </div>
  </main>
</StudentLayout>
