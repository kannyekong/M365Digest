---
import StudentLayout from "../../layouts/StudentLayout.astro";
import { LibraryBig } from "lucide-astro";
import StudentHeader from "../../components/admin/UI/StudentHeader.astro";
---

<StudentLayout
  title="Resources"
  description="Access CloudTweak Academy learning resources."
>
  <StudentHeader
    eyebrow="Learning"
    title="Resources"
    description="Access documents, labs, videos, links, and other learning materials."
  />
  <main class="min-h-screen p-5 md:p-5">
    <div class="mx-auto max-w-[1600px] space-y-6">
      <section
        class="rounded-2xl border border-slate-200 bg-white p-10 text-center shadow-sm dark:border-slate-800 dark:bg-slate-900"
      >
        <div
          class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-green-50 text-green-600 dark:bg-green-950/40 dark:text-green-400"
        >
          <LibraryBig size={25} />
        </div>

        <h2 class="mt-5 text-lg font-semibold text-slate-900 dark:text-white">
          Your resources will appear here
        </h2>

        <p
          class="mx-auto mt-2 max-w-md text-sm leading-6 text-slate-500 dark:text-slate-400"
        >
          Course resources will become available as you enroll in Academy
          programs.
        </p>
      </section>
    </div>
  </main>
</StudentLayout>
