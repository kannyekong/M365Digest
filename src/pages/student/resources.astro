---
import StudentLayout from "../../layouts/StudentLayout.astro";
import StudentHeader from "../../components/admin/UI/StudentHeader.astro";
import StudentResourcesLibrary from "../../islands/student/StudentResourcesLibrary";
---

<StudentLayout
  title="Resources"
  description="Access resources for your enrolled CloudTweak Academy courses."
>
  <StudentHeader
    eyebrow="Learning"
    title="Course Resources"
    description="Find published learning materials from your enrolled courses."
  />
  <main class="min-h-screen p-5 md:p-6">
    <div class="mx-auto max-w-[1400px] space-y-6">
      <StudentResourcesLibrary client:load />
    </div>
  </main>
</StudentLayout>
