---
import StudentLayout from "../../layouts/StudentLayout.astro";
import StudentPageHeader from "../../components/student/StudentPageHeader.astro";
import { Award } from "lucide-astro";
import StudentHeader from "../../components/admin/UI/StudentHeader.astro";
---

<StudentLayout
  title="Certificates"
  description="View your CloudTweak Academy certificates."
>
  <StudentHeader
    eyebrow="Achievements"
    title="Certificates"
    description="Access certificates earned from your completed Academy programs."
  />
  <main class="min-h-screen p-5 md:p-5">
    <div class="mx-auto max-w-[1600px] space-y-6">
      <section
        class="rounded-2xl border border-slate-200 bg-white p-10 text-center shadow-sm dark:border-slate-800 dark:bg-slate-900"
      >
        <div
          class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-yellow-50 text-yellow-600 dark:bg-yellow-950/40 dark:text-yellow-400"
        >
          <Award size={25} />
        </div>

        <h2 class="mt-5 text-lg font-semibold text-slate-900 dark:text-white">
          No certificates yet
        </h2>

        <p
          class="mx-auto mt-2 max-w-md text-sm leading-6 text-slate-500 dark:text-slate-400"
        >
          Certificates earned after completing eligible Academy programs will
          appear here.
        </p>
      </section>
    </div>
  </main>
</StudentLayout>
