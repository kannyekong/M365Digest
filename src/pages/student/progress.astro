---
import StudentLayout from "../../layouts/StudentLayout.astro";
import StudentPageHeader from "../../components/student/StudentPageHeader.astro";
import { TrendingUp } from "lucide-astro";
import StudentHeader from "../../components/admin/UI/StudentHeader.astro";
---

<StudentLayout
  title="My Progress"
  description="Track your CloudTweak Academy learning progress."
>
  <StudentHeader
    eyebrow="Learning"
    title="My Progress"
    description="Track your progress across your enrolled Academy programs."
  />
  <main class="min-h-screen p-5 md:p-5">
    <div class="mx-auto max-w-[1600px] space-y-6">
      <section
        class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900"
      >
        <div class="flex items-center gap-4">
          <div
            class="flex h-12 w-12 items-center justify-center rounded-xl bg-purple-50 text-purple-600 dark:bg-purple-950/40 dark:text-purple-400"
          >
            <TrendingUp size={22} />
          </div>

          <div>
            <p class="text-sm font-semibold text-slate-900 dark:text-white">
              Overall Progress
            </p>

            <p class="text-xs text-slate-500 dark:text-slate-400">
              Your course progress will appear here.
            </p>
          </div>
        </div>

        <div class="mt-8">
          <div class="mb-2 flex justify-between text-sm">
            <span class="text-slate-500 dark:text-slate-400">
              Overall progress
            </span>

            <span class="font-semibold text-slate-900 dark:text-white">
              0%
            </span>
          </div>

          <div
            class="h-2 overflow-hidden rounded-full bg-slate-100 dark:bg-slate-800"
          >
            <div class="h-full w-0 rounded-full bg-purple-500"></div>
          </div>
        </div>
      </section>
    </div>
  </main>
</StudentLayout>
