---
import StudentLayout from "../../layouts/StudentLayout.astro";

import StudentHeader from "../../components/admin/UI/StudentHeader.astro";

import StudentProgress from "../../islands/student/StudentProgress";
---

<StudentLayout
  title="Course Progress"
  description="Track your CloudTweak Academy learning progress."
>
  <StudentHeader
    eyebrow="Learning"
    title="Course Progress"
    description="Track your progress across your enrolled CloudTweak Academy courses."
    backHref="/student/dashboard"
    backLabel="Back to Dashboard"
  />

  <main class="min-h-screen p-5">
    <div class="mx-auto max-w-[1600px]">
      <StudentProgress client:load />
    </div>
  </main>
</StudentLayout>
