---
import StudentForgotPasswordForm from "../../islands/student/StudentForgotPasswordForm";
import "../../styles/global.css";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#CEEDE5" />
    <title>Reset Password | CloudTweak Academy</title>
    <meta name="description" content="Request a password reset link for your CloudTweak Academy student account." />
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-900 dark:bg-slate-950 dark:text-white">
    <main class="flex min-h-screen items-center justify-center px-5 py-12">
      <section class="w-full max-w-md rounded-3xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8 dark:border-slate-800 dark:bg-slate-900">
        <a href="/student/login" class="text-sm font-semibold text-primary hover:opacity-80">← Student login</a>
        <div class="mb-8 mt-8">
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-primary">Account recovery</p>
          <h1 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 dark:text-white">Forgot your password?</h1>
          <p class="mt-3 text-sm leading-6 text-slate-500 dark:text-slate-400">Enter the email address associated with your Academy account. We'll send a secure link to reset your password if an account matches.</p>
        </div>
        <StudentForgotPasswordForm client:load />
      </section>
    </main>
  </body>
</html>
