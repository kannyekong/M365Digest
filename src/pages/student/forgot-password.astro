---
import StudentForgotPasswordForm from "../../islands/student/StudentForgotPasswordForm";
import "../../styles/global.css";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#CEEDE5" />
    <title>Reset your password | CloudTweak Academy</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#CEEDE5" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap"
      rel="stylesheet"
    />
  </head>

  <body
    class="min-h-screen bg-white text-slate-900 dark:bg-slate-950 dark:text-white"
  >
    <main class="min-h-screen lg:grid lg:grid-cols-2">
      <!-- Left branding and promotional section -->
      <section
        class="relative hidden min-h-screen overflow-hidden bg-slate-950 lg:flex"
      >
        <div
          class="absolute inset-0 bg-cover bg-center"
          style="
            background-image:
              url('https://uziqrzfbfjucelzmaaeq.supabase.co/storage/v1/object/public/cloudtweak-media/general/2026/09/58c14270-c413-488b-add5-e527a20ce759.jpeg');
          "
        >
        </div>

        <div class="absolute inset-0 bg-slate-950/70"></div>

        <div
          class="absolute inset-0 bg-gradient-to-br from-blue-950/80 via-indigo-950/50 to-purple-950/80"
        >
        </div>

        <div class="relative z-10 flex w-full flex-col px-12 py-10 xl:px-16">
          <!-- Logo -->
          <a href="/">
            <div>
              <img
                src="/logos/cloudtweakwhite.png"
                alt="CloudTweak Academy"
                class="h-auto w-[190px]"
              />
            </div>
          </a>

          <!-- Main promotional content -->
          <div class="my-auto max-w-xl">
            <h3
              class="text-4xl font-bold leading-[1.08] tracking-tight text-white xl:text-6xl"
            >
              Build the skills to
              <span
                class="bg-gradient-to-r from-blue-400 via-cyan-300 to-purple-400 bg-clip-text text-transparent"
              >
                work smarter.
              </span>
            </h3>

            <p
              class="mt-7 max-w-lg text-base leading-8 text-slate-300 xl:text-lg"
            >
              Learn Microsoft 365, cloud administration, automation, AI and
              modern workplace technologies through practical, career-focused
              training.
            </p>

            <!-- Feature list -->
            <div class="mt-10 grid gap-5 sm:grid-cols-2">
              <div class="flex items-center gap-3">
                <div
                  class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-cyan-400/40 bg-cyan-400/10"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    class="h-4 w-4 text-cyan-300"
                  >
                    <path d="m5 12 4 4L19 6"></path>
                  </svg>
                </div>

                <span class="text-sm text-slate-200"> Practical training </span>
              </div>

              <div class="flex items-center gap-3">
                <div
                  class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-cyan-400/40 bg-cyan-400/10"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    class="h-4 w-4 text-cyan-300"
                  >
                    <path d="m5 12 4 4L19 6"></path>
                  </svg>
                </div>

                <span class="text-sm text-slate-200">
                  Industry-focused courses
                </span>
              </div>

              <div class="flex items-center gap-3">
                <div
                  class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-cyan-400/40 bg-cyan-400/10"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    class="h-4 w-4 text-cyan-300"
                  >
                    <path d="m5 12 4 4L19 6"></path>
                  </svg>
                </div>

                <span class="text-sm text-slate-200"> Hands-on labs </span>
              </div>

              <div class="flex items-center gap-3">
                <div
                  class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-cyan-400/40 bg-cyan-400/10"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    class="h-4 w-4 text-cyan-300"
                  >
                    <path d="m5 12 4 4L19 6"></path>
                  </svg>
                </div>

                <span class="text-sm text-slate-200"> Earn certificates </span>
              </div>
            </div>
          </div>

          <!-- Footer -->
          <div
            class="flex items-center justify-between border-t border-white/15 pt-6 text-xs text-white"
          >
            <span> © 2026 CloudTweak Technologies Limited. </span>

            <span class="hidden sm:block"> Learn. Build. Get Certified. </span>
          </div>
        </div>
      </section>

      <!-- Right password recovery section -->
      <section
        class="flex min-h-screen items-center justify-center bg-white px-5 py-10 dark:bg-slate-950 sm:px-8 lg:px-12"
      >
        <div class="my-auto flex w-full max-w-md flex-col justify-center">
          <!-- Mobile logo -->
          <a href="/">
            <div class="mb-8 flex justify-center lg:hidden">
              <img
                src="/logos/cloudtweaklogo.png"
                alt="CloudTweak Academy"
                class="h-auto w-[180px]"
              />
            </div>
          </a>

          <!-- Password recovery card -->
          <section
            class="w-full rounded-3xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8 dark:border-slate-800 dark:bg-slate-900"
          >
            <a
              href="/student/login"
              class="text-sm font-semibold text-primary hover:opacity-80"
            >
              ← Student login
            </a>

            <div class="mb-8 mt-8">
              <p
                class="text-xs font-semibold uppercase tracking-[0.18em] text-primary"
              >
                Account recovery
              </p>

              <h1
                class="mt-3 text-3xl font-bold tracking-tight text-slate-900 dark:text-white"
              >
                Forgot your password?
              </h1>

              <p
                class="mt-3 text-sm leading-6 text-slate-500 dark:text-slate-400"
              >
                Enter the email address associated with your Academy account.
                We'll send a secure link to reset your password if an account
                matches.
              </p>
            </div>

            <StudentForgotPasswordForm client:load />
          </section>

          <!-- Security note -->
          <p
            class="mt-6 text-center text-xs leading-5 text-slate-400 dark:text-slate-500"
          >
            Your account is protected by CloudTweak Academy's secure
            authentication system.
          </p>
        </div>
      </section>
    </main>
  </body>
</html>
