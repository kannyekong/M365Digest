---
export const prerender = false;
import StudentLayout from "../../layouts/StudentLayout.astro";
import StudentHeader from "../../components/admin/UI/StudentHeader.astro";
import StudentLiveSessions from "../../islands/student/StudentLiveSessions";
---

<StudentLayout
  title="Live Sessions"
  description="View your scheduled live sessions with your instructor related to your courses."
>
  <StudentHeader
    eyebrow="Live Sessions"
    title="Live Sessions"
    description="View your scheduled live sessions with your instructor related to your courses."
    backHref="/student/dashboard"
    backLabel="Back to Dashboard"
  />
  <main class="min-h-screen p-5">
    <div class="mx-auto max-w-[1180px]">
      <StudentLiveSessions client:load />
    </div>
  </main>
</StudentLayout>
