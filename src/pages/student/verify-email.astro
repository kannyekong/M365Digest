---
import StudentVerifyEmailForm from "../../islands/student/StudentVerifyEmailForm";
import "../../styles/global.css";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#CEEDE5" />
    <title>Verify Email | CloudTweak Academy</title>
  </head>

  <body class="min-h-screen bg-slate-50 dark:bg-slate-950">
    <main class="flex min-h-screen items-center justify-center px-4 py-12">
      <div class="w-full max-w-lg">
        <div class="mb-8 text-center">
          <a href="/" class="inline-block">
            <img
              src="https://uziqrzfbfjucelzmaaeq.supabase.co/storage/v1/object/public/cloudtweak-media/general/2026/09/c659ac61-8b73-4cb6-9081-31d7041bad85.png"
              alt="CloudTweak Academy"
              class="mx-auto h-12 w-auto"
            />
          </a>

          <h1
            class="mt-8 text-3xl font-bold tracking-tight text-slate-900 dark:text-white"
          >
            Verify your email
          </h1>

          <p
            class="mx-auto mt-3 max-w-md text-sm leading-6 text-slate-500 dark:text-slate-400"
          >
            One more step before you start learning with CloudTweak Academy.
          </p>
        </div>

        <section
          class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8 dark:border-slate-800 dark:bg-slate-900"
        >
          <StudentVerifyEmailForm client:load />
        </section>
      </div>
    </main>
  </body>
</html>
