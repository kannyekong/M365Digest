---
import StudentLayout from "../../../layouts/StudentLayout.astro";
import StudentHeader from "../../../components/admin/UI/StudentHeader.astro";
import {
  Award,
  ArrowRight,
  BookOpen,
  ChevronLeft,
  ChevronRight,
  Clock3,
  Search,
  ShieldCheck,
} from "lucide-astro";

// These illustrative records define the first UI pass; replace them with the authenticated learner's database records before production.
const certificatePrograms = [
  {
    slug: "microsoft-365-administration",
    title: "Microsoft 365 Administration",
    category: "Microsoft 365",
    status: "not-ready",
    progress: "In progress",
  },
  {
    slug: "exchange-online-administration",
    title: "Exchange Online Administration",
    category: "Microsoft Exchange",
    status: "not-ready",
    progress: "In progress",
  },
  {
    slug: "sharepoint-onedrive-administration",
    title: "SharePoint & OneDrive Administration",
    category: "SharePoint",
    status: "not-ready",
    progress: "In progress",
  },
  {
    slug: "microsoft-entra-id",
    title: "Microsoft Entra ID Administration",
    category: "Identity & Access",
    status: "ready",
    progress: "Completed",
  },
  {
    slug: "microsoft-teams-administration",
    title: "Microsoft Teams Administration",
    category: "Microsoft Teams",
    status: "not-ready",
    progress: "In progress",
  },
  {
    slug: "power-platform-automation",
    title: "Power Platform Automation",
    category: "Automation",
    status: "ready",
    progress: "Completed",
  },
  {
    slug: "copilot-for-microsoft-365",
    title: "Copilot for Microsoft 365",
    category: "AI Productivity",
    status: "not-ready",
    progress: "In progress",
  },
];
---

<StudentLayout
  title="Certificates"
  description="View your CloudTweak Academy program certificates."
>
  <StudentHeader
    eyebrow="Achievements"
    title="My Certificates"
    description="Track your achievements and access certificates issued for your completed Academy programs."
  />

  <main class="min-h-screen p-5 md:p-6">
    <div class="mx-auto max-w-[1600px] space-y-6">
      <section class="grid gap-4 sm:grid-cols-3">
        <div
          class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900"
        >
          <div class="flex items-start justify-between gap-3">
            <div>
              <p class="text-sm text-slate-500 dark:text-slate-400">
                Certificates tracked
              </p>
              <p class="mt-2 text-2xl font-bold text-slate-900 dark:text-white">
                {certificatePrograms.length}
              </p>
              <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">
                Across your Academy programs
              </p>
            </div>

            <div
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-blue-50 text-blue-600 dark:bg-blue-950/50 dark:text-blue-400"
            >
              <Award size={22} strokeWidth={1.8} />
            </div>
          </div>
        </div>

        <div
          class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900"
        >
          <div class="flex items-start justify-between gap-3">
            <div>
              <p class="text-sm text-slate-500 dark:text-slate-400">
                Ready to access
              </p>
              <p
                class="mt-2 text-2xl font-bold text-emerald-600 dark:text-emerald-400"
              >
                {
                  certificatePrograms.filter((item) => item.status === "ready")
                    .length
                }
              </p>
              <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">
                Issued and available
              </p>
            </div>

            <div
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-emerald-50 text-emerald-600 dark:bg-emerald-950/50 dark:text-emerald-400"
            >
              <ShieldCheck size={22} strokeWidth={1.8} />
            </div>
          </div>
        </div>

        <div
          class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900"
        >
          <div class="flex items-start justify-between gap-3">
            <div>
              <p class="text-sm text-slate-500 dark:text-slate-400">
                Not ready
              </p>
              <p
                class="mt-2 text-2xl font-bold text-amber-600 dark:text-amber-400"
              >
                {
                  certificatePrograms.filter((item) => item.status !== "ready")
                    .length
                }
              </p>
              <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">
                Completion or issuance pending
              </p>
            </div>

            <div
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-amber-50 text-amber-600 dark:bg-amber-950/50 dark:text-amber-400"
            >
              <Award size={22} strokeWidth={1.8} />
            </div>
          </div>
        </div>
      </section>

      <section
        class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-800 dark:bg-slate-900 md:p-5"
      >
        <div
          class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between"
        >
          <div>
            <h2 class="font-semibold text-slate-900 dark:text-white">
              Your program certificates
            </h2>
            <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
              Each eligible program has its own certificate status.
            </p>
          </div>
          <div class="flex flex-col gap-3 sm:flex-row">
            <label class="relative block">
              <span class="sr-only">Search certificates</span>
              <Search
                size={16}
                class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-slate-400"
              />
              <input
                id="certificate-search"
                type="search"
                placeholder="Search programs..."
                class="w-full rounded-xl border border-slate-200 bg-white py-2.5 pl-9 pr-3 text-sm text-slate-900 outline-none focus:border-teal-500 focus:ring-2 focus:ring-teal-500/20 dark:border-slate-700 dark:bg-slate-950 dark:text-white sm:w-56"
              />
            </label>
            <label>
              <span class="sr-only">Filter certificate status</span>
              <select
                id="certificate-filter"
                class="w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm text-slate-700 outline-none focus:border-teal-500 focus:ring-2 focus:ring-teal-500/20 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-200 sm:w-44"
              >
                <option value="all">All statuses</option><option value="ready"
                  >Ready</option
                ><option value="not-ready">Not ready</option>
              </select>
            </label>
          </div>
        </div>

        <div id="certificate-grid" class="mt-5 grid gap-4 md:grid-cols-2">
          {
            certificatePrograms.map((program) => (
              <article
                data-certificate-card
                data-title={program.title.toLowerCase()}
                data-category={program.category.toLowerCase()}
                data-status={program.status}
                class="group overflow-hidden rounded-2xl border border-slate-200 bg-white transition hover:-translate-y-0.5 hover:border-teal-300 hover:shadow-md dark:border-slate-800 dark:bg-slate-900 dark:hover:border-teal-800"
              >
                <a
                  href={`/student/certificate/${program.slug}`}
                  class="block p-4 sm:p-5"
                  aria-label={`View ${program.title} certificate`}
                >
                  <div class="flex items-start justify-between gap-3">
                    <div class="flex min-w-0 items-center gap-3">
                      <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-teal-50 text-teal-700 dark:bg-teal-950/50 dark:text-teal-300">
                        <Award size={21} />
                      </div>
                      <div class="min-w-0">
                        <p class="text-xs font-medium text-slate-500 dark:text-slate-400">
                          {program.category}
                        </p>
                        <h3 class="mt-1 font-semibold text-slate-900 dark:text-white">
                          {program.title}
                        </h3>
                      </div>
                    </div>
                    <span
                      class:list={[
                        "shrink-0 rounded-full px-2.5 py-1 text-[11px] font-semibold",
                        program.status === "ready"
                          ? "bg-emerald-50 text-emerald-700 dark:bg-emerald-950/50 dark:text-emerald-300"
                          : "bg-amber-50 text-amber-700 dark:bg-amber-950/50 dark:text-amber-300",
                      ]}
                    >
                      {program.status === "ready" ? "Ready" : "Not ready"}
                    </span>
                  </div>

                  <div class="relative mt-5 overflow-hidden rounded-xl border border-slate-200 bg-gradient-to-br from-slate-50 via-white to-teal-50 p-4 dark:border-slate-700 dark:from-slate-950 dark:via-slate-900 dark:to-teal-950/40">
                    <div
                      class:list={[
                        "select-none rounded-lg border border-dashed border-slate-300 bg-white/80 px-4 py-5 text-center dark:border-slate-700 dark:bg-slate-950/80",
                        program.status !== "ready" && "blur-[2px]",
                      ]}
                      aria-hidden="true"
                    >
                      <div class="mx-auto flex h-8 w-8 items-center justify-center rounded-full bg-teal-50 text-teal-700 dark:bg-teal-950 dark:text-teal-300">
                        <Award size={17} />
                      </div>
                      <p class="mt-2 text-[10px] font-semibold uppercase tracking-[0.22em] text-teal-800 dark:text-teal-300">
                        CloudTweak Academy
                      </p>
                      <p class="mt-2 font-serif text-sm font-semibold text-slate-800 dark:text-slate-100">
                        Certificate of Completion
                      </p>
                      <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">
                        {program.title}
                      </p>
                      <div class="mx-auto mt-3 h-px w-24 bg-slate-300 dark:bg-slate-700" />
                      <p class="mt-2 text-[10px] text-slate-400">
                        Recipient · Certificate number
                      </p>
                    </div>
                    {program.status !== "ready" && (
                      <div class="absolute inset-0 flex flex-col items-center justify-center bg-white/35 text-center dark:bg-slate-950/35">
                        <div class="flex h-9 w-9 items-center justify-center rounded-full border border-slate-200 bg-white/95 text-slate-600 shadow-sm dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300">
                          <ShieldCheck size={17} />
                        </div>
                        <span class="mt-2 text-xs font-semibold text-slate-700 dark:text-slate-200">
                          Preview locked
                        </span>
                      </div>
                    )}
                  </div>

                  <div class="mt-4 flex items-center justify-between gap-3">
                    <div class="flex items-center gap-2 text-sm text-slate-600 dark:text-slate-300">
                      {program.status === "ready" ? (
                        <ShieldCheck
                          size={16}
                          class="text-emerald-600 dark:text-emerald-400"
                        />
                      ) : (
                        <Clock3
                          size={16}
                          class="text-amber-600 dark:text-amber-400"
                        />
                      )}
                      {program.progress}
                    </div>
                    <ArrowRight
                      size={17}
                      class="shrink-0 text-slate-400 transition group-hover:translate-x-0.5 group-hover:text-teal-600 dark:group-hover:text-teal-300"
                    />
                  </div>
                  <div class="mt-4 border-t border-slate-100 pt-4 dark:border-slate-800">
                    {program.status === "ready" ? (
                      <span class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-teal-700 px-4 py-2.5 text-sm font-semibold text-white">
                        View certificate <ArrowRight size={15} />
                      </span>
                    ) : (
                      <span class="inline-flex w-full cursor-not-allowed items-center justify-center gap-2 rounded-xl bg-slate-100 px-4 py-2.5 text-sm font-semibold text-slate-400 dark:bg-slate-800 dark:text-slate-500">
                        <Clock3 size={15} /> Download unavailable
                      </span>
                    )}
                  </div>
                </a>
              </article>
            ))
          }
        </div>

        <div
          id="certificate-empty"
          class="hidden rounded-xl border border-dashed border-slate-200 px-6 py-12 text-center dark:border-slate-700"
        >
          <BookOpen size={25} class="mx-auto text-slate-400" />
          <h3 class="mt-3 font-semibold text-slate-900 dark:text-white">
            No matching certificates
          </h3>
          <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
            Try another search term or status filter.
          </p>
        </div>

        <div
          class="mt-5 flex flex-col gap-3 border-t border-slate-100 pt-4 dark:border-slate-800 sm:flex-row sm:items-center sm:justify-between"
        >
          <p
            id="certificate-result-count"
            class="text-sm text-slate-500 dark:text-slate-400"
          >
          </p>
          <nav
            id="certificate-pagination"
            aria-label="Certificate pages"
            class="flex items-center justify-center gap-1.5"
          >
            <button
              type="button"
              data-page-prev
              class="inline-flex h-9 items-center gap-1 rounded-lg border border-slate-200 px-3 text-sm font-medium text-slate-600 hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-40 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-800"
              ><ChevronLeft size={15} /> Previous</button
            >
            <div
              id="certificate-page-numbers"
              class="flex items-center gap-1.5"
            >
            </div>
            <button
              type="button"
              data-page-next
              class="inline-flex h-9 items-center gap-1 rounded-lg border border-slate-200 px-3 text-sm font-medium text-slate-600 hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-40 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-800"
              >Next <ChevronRight size={15} /></button
            >
          </nav>
        </div>
      </section>

      <p class="text-xs leading-5 text-slate-500 dark:text-slate-400">
        The records and certificate artwork above are UI placeholders. Before
        production, load only the signed-in student's records and keep real
        certificate files behind server-side authorization.
      </p>
    </div>
  </main>
</StudentLayout>

<script>
  // Keep search, status filtering and pagination synchronized.
  const pageSize = 6;
  const cards = Array.from(
    document.querySelectorAll<HTMLElement>("[data-certificate-card]")
  );
  const searchInput = document.querySelector<HTMLInputElement>(
    "#certificate-search"
  );
  const statusFilter = document.querySelector<HTMLSelectElement>(
    "#certificate-filter"
  );
  const previousButton =
    document.querySelector<HTMLButtonElement>("[data-page-prev]");
  const nextButton =
    document.querySelector<HTMLButtonElement>("[data-page-next]");
  const pageNumbers = document.querySelector<HTMLElement>(
    "#certificate-page-numbers"
  );
  const resultCount = document.querySelector<HTMLElement>(
    "#certificate-result-count"
  );
  const emptyState = document.querySelector<HTMLElement>("#certificate-empty");
  const pagination = document.querySelector<HTMLElement>(
    "#certificate-pagination"
  );
  let currentPage = 1;

  // Return cards matching the current search and status filter.
  function getFilteredCards() {
    const search = searchInput?.value.trim().toLowerCase() ?? "";
    const status = statusFilter?.value ?? "all";
    return cards.filter((card) => {
      const matchesSearch =
        (card.dataset.title ?? "").includes(search) ||
        (card.dataset.category ?? "").includes(search);
      const matchesStatus = status === "all" || card.dataset.status === status;
      return matchesSearch && matchesStatus;
    });
  }

  // Update visible cards, page controls and result count.
  function renderCertificates() {
    const filtered = getFilteredCards();
    const totalPages = Math.max(1, Math.ceil(filtered.length / pageSize));
    currentPage = Math.min(currentPage, totalPages);
    const start = (currentPage - 1) * pageSize;
    const visible = new Set(filtered.slice(start, start + pageSize));
    cards.forEach((card) => {
      card.hidden = !visible.has(card);
    });

    if (resultCount)
      resultCount.textContent = `Showing ${filtered.length ? start + 1 : 0}–${Math.min(start + pageSize, filtered.length)} of ${filtered.length} programs`;
    if (emptyState) emptyState.classList.toggle("hidden", filtered.length > 0);
    if (pagination)
      pagination.classList.toggle("hidden", filtered.length <= pageSize);
    if (previousButton) previousButton.disabled = currentPage <= 1;
    if (nextButton) nextButton.disabled = currentPage >= totalPages;

    if (pageNumbers) {
      pageNumbers.replaceChildren();
      for (let page = 1; page <= totalPages; page += 1) {
        const button = document.createElement("button");
        button.type = "button";
        button.textContent = String(page);
        button.setAttribute("aria-label", `Go to page ${page}`);
        button.setAttribute(
          "aria-current",
          page === currentPage ? "page" : "false"
        );
        button.className =
          page === currentPage
            ? "h-9 min-w-9 rounded-lg bg-teal-700 px-3 text-sm font-semibold text-white"
            : "h-9 min-w-9 rounded-lg border border-slate-200 px-3 text-sm font-medium text-slate-600 hover:bg-slate-50 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-800";
        button.addEventListener("click", () => {
          currentPage = page;
          renderCertificates();
        });
        pageNumbers.append(button);
      }
    }
  }

  // Return to page one when a filter changes.
  searchInput?.addEventListener("input", () => {
    currentPage = 1;
    renderCertificates();
  });
  statusFilter?.addEventListener("change", () => {
    currentPage = 1;
    renderCertificates();
  });
  previousButton?.addEventListener("click", () => {
    currentPage = Math.max(1, currentPage - 1);
    renderCertificates();
  });
  nextButton?.addEventListener("click", () => {
    currentPage += 1;
    renderCertificates();
  });
  renderCertificates();
</script>
