---
import StudentLayout from "../../../layouts/StudentLayout.astro";
import { Award, ArrowLeft, BadgeCheck, CalendarDays, Download, ShieldCheck } from "lucide-astro";

export const prerender = false;
---

<StudentLayout title="Certificate details" description="View your CloudTweak Academy certificate.">
  <main class="min-h-screen p-4 md:p-6 dark:bg-slate-950">
    <div class="mx-auto max-w-6xl space-y-6">
      <a href="/student/certificate" class="inline-flex items-center gap-2 text-sm font-semibold text-teal-700 hover:text-teal-800 dark:text-teal-300"><ArrowLeft size={17} /> Back to certificates</a>
      <section id="certificate-loading" role="status" aria-live="polite" class="rounded-2xl border border-slate-200 bg-white p-10 text-center dark:border-slate-800 dark:bg-slate-900">Loading your certificate…</section>
      <section id="certificate-not-found" class="hidden rounded-2xl border border-slate-200 bg-white p-8 text-center dark:border-slate-800 dark:bg-slate-900"><Award size={30} class="mx-auto text-slate-400" /><h1 class="mt-4 text-xl font-bold text-slate-900 dark:text-white">Certificate not found</h1><p class="mt-2 text-sm text-slate-500 dark:text-slate-400">This program is not among your completed certificate-enabled programs.</p></section>
      <section id="certificate-detail" class="hidden space-y-5">
        <div id="certificate-status" class="rounded-2xl border p-5"></div>
        <div class="rounded-2xl border border-slate-200 bg-white p-3 shadow-sm dark:border-slate-800 dark:bg-slate-900 sm:p-6">
          <div class="mb-4 flex flex-wrap items-center justify-between gap-2 px-1"><div><h2 class="font-semibold text-slate-900 dark:text-white">Certificate details</h2><p class="mt-1 text-xs text-slate-500 dark:text-slate-400">CloudTweak Academy</p></div><span id="certificate-badge" class="inline-flex items-center gap-1.5 rounded-full bg-slate-100 px-3 py-1.5 text-xs font-semibold text-slate-700 dark:bg-slate-800 dark:text-slate-200"><BadgeCheck size={14} /> Certificate status</span></div>
          <div id="certificate-paper" class="relative overflow-hidden border-[8px] border-double border-teal-800 bg-white p-5 text-center text-slate-900 sm:border-[12px] sm:p-10 lg:p-14">
            <div class="pointer-events-none absolute inset-2 border border-amber-500/70 sm:inset-3"></div>
            <div class="relative mx-auto flex max-w-3xl flex-col items-center">
              <div class="flex h-16 w-16 items-center justify-center rounded-full border-2 border-amber-500 bg-teal-50 text-teal-800 sm:h-20 sm:w-20"><Award size={39} /></div>
              <p class="mt-5 text-[10px] font-bold uppercase tracking-[0.3em] text-teal-800 sm:text-xs">CloudTweak Technologies Limited</p><p class="mt-2 text-xs font-semibold uppercase tracking-[0.25em] text-slate-500">CloudTweak Academy</p><div class="mt-6 h-px w-28 bg-amber-500"></div>
              <h1 class="mt-6 font-serif text-3xl font-bold leading-tight text-teal-950 sm:text-5xl">Certificate</h1><p class="mt-2 font-serif text-lg italic text-slate-600 sm:text-2xl">of Completion</p><p class="mt-7 text-sm text-slate-600 sm:text-base">This certificate is presented to</p>
              <p id="certificate-recipient" class="mt-5 w-full break-words border-b border-slate-300 pb-3 font-serif text-2xl font-semibold text-slate-900 sm:text-4xl">—</p><p class="mt-5 max-w-xl text-sm leading-7 text-slate-600 sm:text-base">in recognition of successful completion of the learning program</p><h2 id="certificate-program" class="mt-3 max-w-2xl font-serif text-xl font-bold leading-snug text-teal-900 sm:text-3xl">—</h2>
              <div class="mt-10 grid w-full max-w-2xl gap-8 sm:grid-cols-2 sm:gap-12">
                <div class="text-center"><div class="mx-auto mb-2 flex h-5 items-center justify-center"><CalendarDays size={18} class="text-teal-800" /></div><div class="mx-auto w-full max-w-52 border-b border-slate-400"></div><p class="mt-2 text-xs font-semibold text-slate-700">Issue date</p><p id="certificate-issue-date" class="mt-1 text-xs text-slate-500">—</p></div>
                <div class="text-center"><div class="mx-auto mb-2 flex h-5 items-center justify-center"><ShieldCheck size={18} class="text-teal-800" /></div><div class="mx-auto w-full max-w-52 border-b border-slate-400"></div><p class="mt-2 text-xs font-semibold text-slate-700">Certificate number</p><p id="certificate-number" class="mt-1 text-xs text-slate-500">—</p></div>
              </div>
              <p id="certificate-verification" class="mt-8 text-xs text-slate-500">Verification code: —</p>
            </div>
          </div>
          <div class="mt-5 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between"><p id="certificate-footnote" class="text-xs leading-5 text-slate-500 dark:text-slate-400"></p><a id="certificate-download" class="hidden shrink-0 items-center justify-center gap-2 rounded-xl bg-teal-700 px-4 py-3 text-sm font-semibold text-white hover:bg-teal-800" href="#"><Download size={17} /> Download PDF</a></div>
        </div>
      </section>
    </div>
  </main>
</StudentLayout>

<script>
  import { studentSupabase } from "../../../lib/superbase";

  type CertificateResponse = {
    success: boolean;
    message?: string;
    certificate: {
      programTitle: string;
      programSlug: string;
      status: "issued" | "eligible" | "revoked";
      recipientName: string;
      completedAt: string | null;
      certificate: {
        certificateNumber: string;
        verificationCode: string;
        issueDate: string;
        fileUrl: string | null;
        revocationReason: string | null;
      } | null;
    } | null;
  };

  // Load the selected program's certificate through a server endpoint that validates the student token.
  async function loadCertificate() {
    const loading = document.querySelector<HTMLElement>("#certificate-loading");
    const notFound = document.querySelector<HTMLElement>("#certificate-not-found");
    const detail = document.querySelector<HTMLElement>("#certificate-detail");
    const slug = window.location.pathname.split("/").filter(Boolean).at(-1) ?? "";
    const { data: { session } } = await studentSupabase.auth.getSession();

    if (!session?.access_token) {
      if (loading) loading.innerHTML = 'Please <a class="font-semibold text-teal-700 underline" href="/student/login">sign in</a> to view your certificate.';
      return;
    }

    const response = await fetch(`/api/student/certificates?slug=${encodeURIComponent(slug)}`, {
      headers: { Authorization: `Bearer ${session.access_token}` },
      cache: "no-store",
    });
    const payload = await response.json() as CertificateResponse;
    if (!response.ok || !payload.success) {
      if (loading) loading.textContent = payload.message ?? "Your certificate could not be loaded.";
      return;
    }
    if (!payload.certificate) {
      loading?.classList.add("hidden");
      notFound?.classList.remove("hidden");
      return;
    }

    const item = payload.certificate;
    const certificate = item.certificate;
    const issued = item.status === "issued";
    const revoked = item.status === "revoked";
    loading?.classList.add("hidden");
    detail?.classList.remove("hidden");

    const setText = (selector: string, value: string) => {
      const element = document.querySelector<HTMLElement>(selector);
      if (element) element.textContent = value;
    };
    const statusPanel = document.querySelector<HTMLElement>("#certificate-status");
    const badge = document.querySelector<HTMLElement>("#certificate-badge");
    const footnote = document.querySelector<HTMLElement>("#certificate-footnote");
    const download = document.querySelector<HTMLAnchorElement>("#certificate-download");

    if (statusPanel) {
      statusPanel.className = revoked
        ? "rounded-2xl border border-rose-200 bg-rose-50 p-5 dark:border-rose-900 dark:bg-rose-950/20"
        : issued
          ? "rounded-2xl border border-emerald-200 bg-emerald-50/70 p-5 dark:border-emerald-900 dark:bg-emerald-950/20"
          : "rounded-2xl border border-amber-200 bg-amber-50/70 p-5 dark:border-amber-900 dark:bg-amber-950/20";
      statusPanel.textContent = revoked
        ? `This certificate has been revoked. ${certificate?.revocationReason ?? ""}`
        : issued
          ? "Your certificate has been issued and is ready to download."
          : "Your program completion is recorded. Your certificate will appear here after an administrator issues it.";
    }
    if (badge) badge.textContent = revoked ? "Revoked" : issued ? "Issued" : "Awaiting issuance";
    setText("#certificate-recipient", item.recipientName);
    setText("#certificate-program", item.programTitle);
    setText("#certificate-issue-date", issued && certificate?.issueDate ? new Date(certificate.issueDate).toLocaleDateString() : "Pending issuance");
    setText("#certificate-number", issued && certificate?.certificateNumber ? certificate.certificateNumber : "Pending issuance");
    setText("#certificate-verification", issued && certificate?.verificationCode ? `Verification code: ${certificate.verificationCode}` : "Verification code is assigned at issuance");
    if (footnote) footnote.textContent = issued
      ? "This certificate was issued by CloudTweak Academy. Use the verification code to confirm its status."
      : revoked
        ? "This certificate is not valid for use."
        : "Eligibility is based on recorded program completion. Enrollment or payment alone does not issue a certificate.";
    if (issued && certificate?.fileUrl && download) {
      download.href = certificate.fileUrl;
      download.target = "_blank";
      download.rel = "noopener noreferrer";
      download.classList.remove("hidden");
    }
  }

  loadCertificate().catch((error) => {
    console.error("Unable to load certificate:", error);
    const loading = document.querySelector<HTMLElement>("#certificate-loading");
    if (loading) loading.textContent = "Your certificate could not be loaded. Please refresh and try again.";
  });
</script>
