---
import StudentLayout from "../../../layouts/StudentLayout.astro";
import StudentHeader from "../../../components/admin/UI/StudentHeader.astro";
import { ArrowLeft, Award, CheckCircle2, Clock3, Download, LockKeyhole, ShieldCheck } from "lucide-astro";

const { slug } = Astro.params;

// Convert the route slug into a readable placeholder title until the authenticated certificate record is loaded.
const programTitle = (slug ?? "academy-program")
  .split("-")
  .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
  .join(" ");
---

<StudentLayout title={`Certificate | ${programTitle}`} description={`Certificate details for ${programTitle} at CloudTweak Academy.`}>
  <StudentHeader eyebrow="Achievements" title="Certificate details" description="Review your certificate status and access it when it has been officially issued." />

  <main class="min-h-screen p-5 md:p-6">
    <div class="mx-auto max-w-5xl space-y-5">
      <a href="/student/certificates" class="inline-flex items-center gap-2 text-sm font-medium text-slate-600 transition hover:text-teal-700 dark:text-slate-300 dark:hover:text-teal-300">
        <ArrowLeft size={16} /> Back to all certificates
      </a>

      <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900">
        <div class="flex flex-col gap-4 border-b border-slate-100 p-5 dark:border-slate-800 sm:flex-row sm:items-start sm:justify-between md:p-6">
          <div class="flex items-start gap-3">
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-teal-50 text-teal-700 dark:bg-teal-950/50 dark:text-teal-300"><Award size={23} /></div>
            <div>
              <p class="text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">CloudTweak Academy program</p>
              <h2 class="mt-1 text-xl font-bold text-slate-900 dark:text-white">{programTitle}</h2>
              <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">Your certificate will become available after eligibility is verified and the certificate has been issued.</p>
            </div>
          </div>
          <span class="inline-flex w-fit items-center gap-1.5 rounded-full bg-amber-50 px-3 py-1.5 text-xs font-semibold text-amber-700 dark:bg-amber-950/40 dark:text-amber-300"><Clock3 size={14} /> Not ready</span>
        </div>

        <div class="p-4 sm:p-6 md:p-8">
          <div class="relative mx-auto max-w-3xl overflow-hidden rounded-xl border border-slate-200 bg-gradient-to-br from-slate-50 via-white to-teal-50 p-4 dark:border-slate-700 dark:from-slate-950 dark:via-slate-900 dark:to-teal-950/40 sm:p-7">
            <div class="pointer-events-none select-none rounded-lg border-4 border-double border-slate-300 bg-white/90 px-5 py-8 text-center blur-[3px] dark:border-slate-700 dark:bg-slate-950/90 sm:px-10 sm:py-12" aria-hidden="true">
              <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-teal-50 text-teal-700 dark:bg-teal-950 dark:text-teal-300"><Award size={26} /></div>
              <p class="mt-4 text-xs font-semibold uppercase tracking-[0.28em] text-teal-800 dark:text-teal-300">CloudTweak Academy</p>
              <h3 class="mt-5 font-serif text-2xl font-semibold text-slate-900 dark:text-white sm:text-3xl">Certificate of Completion</h3>
              <p class="mt-4 text-sm text-slate-500 dark:text-slate-400">This certifies that</p>
              <p class="mt-2 font-serif text-xl font-semibold text-slate-900 dark:text-white">Student Name</p>
              <p class="mx-auto mt-3 max-w-lg text-sm leading-6 text-slate-600 dark:text-slate-300">has successfully completed the requirements for</p>
              <p class="mt-2 font-semibold text-slate-900 dark:text-white">{programTitle}</p>
              <div class="mx-auto mt-8 h-px w-40 bg-slate-300 dark:bg-slate-700"></div>
              <p class="mt-2 text-xs text-slate-500 dark:text-slate-400">Certificate number · Completion date</p>
            </div>
            <div class="absolute inset-0 flex flex-col items-center justify-center bg-white/45 px-4 text-center dark:bg-slate-950/45">
              <div class="flex h-12 w-12 items-center justify-center rounded-full border border-slate-200 bg-white/95 text-slate-600 shadow-sm dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300"><LockKeyhole size={22} /></div>
              <p class="mt-3 text-sm font-semibold text-slate-800 dark:text-slate-100">Certificate preview locked</p>
              <p class="mt-1 max-w-sm text-xs leading-5 text-slate-600 dark:text-slate-300">This is a placeholder preview, not your actual certificate file.</p>
            </div>
          </div>

          <div class="mx-auto mt-6 max-w-3xl rounded-xl border border-amber-200 bg-amber-50/70 p-4 dark:border-amber-900/60 dark:bg-amber-950/20">
            <div class="flex items-start gap-3">
              <Clock3 size={19} class="mt-0.5 shrink-0 text-amber-700 dark:text-amber-300" />
              <div>
                <h3 class="text-sm font-semibold text-amber-900 dark:text-amber-200">Your certificate is not ready yet</h3>
                <p class="mt-1 text-sm leading-6 text-amber-800 dark:text-amber-300">Complete the required program activities and any assessments or projects. Once your completion is verified and your certificate is issued, this page will show the ready status and allow a secure download.</p>
              </div>
            </div>
          </div>

          <div class="mx-auto mt-5 grid max-w-3xl gap-3 sm:grid-cols-2">
            <div class="flex items-start gap-3 rounded-xl border border-slate-200 p-4 dark:border-slate-800">
              <CheckCircle2 size={18} class="mt-0.5 shrink-0 text-slate-400" />
              <div><p class="text-sm font-medium text-slate-800 dark:text-slate-200">Program completion</p><p class="mt-1 text-xs leading-5 text-slate-500 dark:text-slate-400">Completion must be recorded and verified.</p></div>
            </div>
            <div class="flex items-start gap-3 rounded-xl border border-slate-200 p-4 dark:border-slate-800">
              <ShieldCheck size={18} class="mt-0.5 shrink-0 text-slate-400" />
              <div><p class="text-sm font-medium text-slate-800 dark:text-slate-200">Certificate issuance</p><p class="mt-1 text-xs leading-5 text-slate-500 dark:text-slate-400">An issued, valid certificate is required before download.</p></div>
            </div>
          </div>

          <div class="mx-auto mt-6 max-w-3xl">
            <button type="button" disabled aria-disabled="true" class="inline-flex w-full cursor-not-allowed items-center justify-center gap-2 rounded-xl bg-slate-200 px-5 py-3 text-sm font-semibold text-slate-500 dark:bg-slate-800 dark:text-slate-500">
              <Download size={17} /> Download certificate
            </button>
            <p class="mt-2 text-center text-xs text-slate-500 dark:text-slate-400">Download will activate only after the server confirms that your certificate has been issued and is valid.</p>
          </div>
        </div>
      </section>
    </div>
  </main>
</StudentLayout>
