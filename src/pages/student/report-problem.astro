---
export const prerender = false;

import StudentLayout from "../../layouts/StudentLayout.astro";
import StudentHeader from "../../components/admin/UI/StudentHeader.astro";
import StudentReportProblem from "../../islands/student/StudentReportProblem";
---

<StudentLayout
  title="Report a Problem"
  description="Contact CloudTweak Academy support."
>
  <StudentHeader
    eyebrow="Support"
    title="Report a Problem"
    description="Tell us what went wrong and our support team will review your request."
  />

  <main class="min-h-screen p-5">
    <div class="mx-auto max-w-[1180px]">
      <StudentReportProblem client:load />
    </div>
  </main>
</StudentLayout>
