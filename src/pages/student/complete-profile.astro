---
import StudentCompleteProfileForm from "../../islands/student/StudentCompleteProfileForm";
import "../../styles/global.css";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#CEEDE5" />
    <title>Complete your profile | CloudTweak Academy</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#CEEDE5" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap"
      rel="stylesheet"
    />
  </head>

  <body
    class="min-h-screen bg-slate-50 text-slate-900 dark:bg-slate-950 dark:text-white"
  >
    <main class="min-h-screen lg:grid lg:grid-cols-2">
      <section
        class="relative hidden min-h-screen overflow-hidden bg-slate-950 lg:flex"
      >
        <div
          class="absolute inset-0 bg-cover bg-center"
          style="
            background-image:
              url('https://uziqrzfbfjucelzmaaeq.supabase.co/storage/v1/object/public/cloudtweak-media/general/2026/09/a0172f41-bfbc-4e02-95fa-bd533b4de1c0.jpg');
          "
        >
        </div>

        <div class="absolute inset-0 bg-slate-950/70"></div>

        <div
          class="absolute inset-0 bg-gradient-to-br from-blue-950/80 via-indigo-950/50 to-purple-950/80"
        >
        </div>

        <div class="relative z-10 flex w-full flex-col px-12 py-10 xl:px-16">
          <div>
            <img
              src="/logos/cloudtweakwhite.png"
              alt="CloudTweak Academy"
              class="h-auto w-[190px]"
            />
          </div>

          <div class="my-auto max-w-xl">
            <p
              class="mb-5 text-sm font-semibold uppercase tracking-[0.3em] text-blue-300"
            >
              Almost there
            </p>

            <h1
              class="text-4xl font-bold leading-[1.08] tracking-tight text-white xl:text-6xl"
            >
              Complete your
              <span
                class="bg-gradient-to-r from-blue-400 via-cyan-300 to-purple-400 bg-clip-text text-transparent"
              >
                Academy profile.
              </span>
            </h1>

            <p
              class="mt-7 max-w-lg text-base leading-8 text-slate-300 xl:text-lg"
            >
              Tell us a little more about yourself so we can personalize your
              learning experience and prepare your Academy profile.
            </p>

            <div class="mt-10 space-y-5">
              <div class="flex items-center gap-3">
                <div
                  class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-cyan-400/40 bg-cyan-400/10"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    class="h-4 w-4 text-cyan-300"
                  >
                    <path d="m5 12 4 4L19 6"></path>
                  </svg>
                </div>

                <span class="text-sm text-slate-200">
                  Personalize your learning profile
                </span>
              </div>

              <div class="flex items-center gap-3">
                <div
                  class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-cyan-400/40 bg-cyan-400/10"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    class="h-4 w-4 text-cyan-300"
                  >
                    <path d="m5 12 4 4L19 6"></path>
                  </svg>
                </div>

                <span class="text-sm text-slate-200">
                  Keep your certificate information accurate
                </span>
              </div>

              <div class="flex items-center gap-3">
                <div
                  class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-cyan-400/40 bg-cyan-400/10"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    class="h-4 w-4 text-cyan-300"
                  >
                    <path d="m5 12 4 4L19 6"></path>
                  </svg>
                </div>

                <span class="text-sm text-slate-200">
                  Unlock your student dashboard
                </span>
              </div>
            </div>
          </div>

          <div class="border-t border-white/15 pt-6 text-xs text-slate-400">
            © 2026 CloudTweak Technologies Limited.
          </div>
        </div>
      </section>

      <section
        class="flex min-h-screen items-center justify-center px-5 py-10 sm:px-8 lg:px-12"
      >
        <div class="w-full max-w-xl">
          <div class="mb-10 flex justify-center lg:hidden">
            <img
              src="YOUR_PUBLIC_LOGO_URL"
              alt="CloudTweak Academy"
              class="h-auto w-[180px]"
            />
          </div>

          <div
            class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8 xl:p-10 dark:border-slate-800 dark:bg-slate-900"
          >
            <div class="mb-8">
              <p
                class="mb-3 text-xs font-semibold uppercase tracking-[0.25em] text-blue-600 dark:text-blue-400"
              >
                Student profile
              </p>

              <h2
                class="text-3xl font-bold tracking-tight text-slate-950 dark:text-white"
              >
                Complete your profile
              </h2>

              <p
                class="mt-3 text-sm leading-6 text-slate-500 dark:text-slate-400"
              >
                Your name will be used for your Academy records and certificate.
                You can add the other information now or later.
              </p>
            </div>

            <StudentCompleteProfileForm client:load />
          </div>

          <p
            class="mt-6 text-center text-xs leading-5 text-slate-400 dark:text-slate-500"
          >
            Your information is securely stored with your CloudTweak Academy
            account.
          </p>
        </div>
      </section>
    </main>
  </body>
</html>
