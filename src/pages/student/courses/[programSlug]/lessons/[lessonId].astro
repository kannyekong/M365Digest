---
import StudentLayout from "../../../../../layouts/StudentLayout.astro";
import StudentHeader from "../../../../../components/admin/UI/StudentHeader.astro";
import { supabase } from "../../../../../lib/superbase";
import StudentLessonAccess from "../../../../../islands/student/StudentLessonAccess";
import StudentLessonAssessment from "../../../../../islands/student/StudentLessonAssessment";

const { programSlug, lessonId } = Astro.params;

// Redirect to the student courses page when the required route parameters are missing.
if (!programSlug || !lessonId) {
  return Astro.redirect("/student/courses");
}

// Resolve the published Academy program using the course slug.
const { data: program, error: programError } = await supabase
  .from("academy_programs")
  .select("id, title, slug")
  .eq("slug", programSlug)
  .eq("status", "published")
  .maybeSingle();

// Redirect when the requested Academy program cannot be found.
if (programError || !program) {
  return Astro.redirect("/student/courses");
}

// Load the requested lesson together with its parent module.
const { data: lesson, error: lessonError } = await supabase
  .from("academy_program_lessons")
  .select(
    `
      id,
      module_id,
      title,
      description,
      lesson_type,
      duration,
      display_order,
      academy_program_modules (
        id,
        program_id,
        title,
        module_number
      )
    `
  )
  .eq("id", lessonId)
  .maybeSingle();

// Redirect when the requested lesson cannot be found.
if (lessonError || !lesson) {
  return Astro.redirect(`/student/courses/${programSlug}`);
}

// Normalize Supabase's nested module relationship into one module object.
const moduleData = Array.isArray(lesson.academy_program_modules)
  ? lesson.academy_program_modules[0]
  : lesson.academy_program_modules;

// Redirect when the lesson has no valid parent module.
if (!moduleData) {
  return Astro.redirect(`/student/courses/${programSlug}`);
}

// Prevent a lesson belonging to another Academy program from being accessed
// through the current program URL.
if (moduleData.program_id !== program.id) {
  return Astro.redirect(`/student/courses/${programSlug}`);
}

/**
 * Load all modules belonging to the current Academy program in curriculum order.
 */
const { data: programModules, error: programModulesError } = await supabase
  .from("academy_program_modules")
  .select("id, module_number, display_order")
  .eq("program_id", program.id)
  .order("module_number", { ascending: true })
  .order("display_order", { ascending: true });

// Navigation failure should not prevent the lesson itself from rendering.
if (programModulesError) {
  console.error(
    "Failed to load Academy modules for lesson navigation:",
    programModulesError
  );
}

/**
 * Collect the module IDs used to retrieve all lessons in the current program.
 */
const moduleIds = (programModules ?? []).map(
  (academyModule) => academyModule.id
);

/**
 * Load all lessons belonging to the current Academy program.
 */
const { data: programLessons, error: programLessonsError } =
  moduleIds.length > 0
    ? await supabase
        .from("academy_program_lessons")
        .select("id, module_id, display_order")
        .in("module_id", moduleIds)
        .order("display_order", { ascending: true })
    : { data: [], error: null };

// Navigation failure should not prevent the lesson itself from rendering.
if (programLessonsError) {
  console.error(
    "Failed to load Academy lessons for navigation:",
    programLessonsError
  );
}

/**
 * Build one ordered lesson list across all modules in the Academy program.
 */
const orderedLessons = (programModules ?? []).flatMap((academyModule) => {
  return (programLessons ?? [])
    .filter((programLesson) => programLesson.module_id === academyModule.id)
    .sort((a, b) => a.display_order - b.display_order);
});

/**
 * Find the current lesson's position in the complete program curriculum.
 */
const currentLessonIndex = orderedLessons.findIndex(
  (programLesson) => programLesson.id === lesson.id
);

/**
 * Resolve the previous lesson across module boundaries when available.
 */
const previousLesson =
  currentLessonIndex > 0 ? orderedLessons[currentLessonIndex - 1] : null;

/**
 * Resolve the next lesson across module boundaries when available.
 */
const nextLesson =
  currentLessonIndex >= 0 && currentLessonIndex < orderedLessons.length - 1
    ? orderedLessons[currentLessonIndex + 1]
    : null;

/**
 * Build the student-facing URL for the previous lesson.
 */
const previousLessonUrl = previousLesson
  ? `/student/courses/${programSlug}/lessons/${previousLesson.id}`
  : null;

/**
 * Build the student-facing URL for the next lesson.
 */
const nextLessonUrl = nextLesson
  ? `/student/courses/${programSlug}/lessons/${nextLesson.id}`
  : null;

/**
 * Convert the lesson type into a readable student-facing label.
 */
const lessonTypeLabel = lesson.lesson_type
  .split("_")
  .map((word: string) => word.charAt(0).toUpperCase() + word.slice(1))
  .join(" ");
---

<StudentLayout
  title={`${lesson.title} | ${program.title}`}
  description={lesson.description ?? `Continue your ${program.title} learning.`}
>
  <StudentHeader
    eyebrow={`${moduleData.title} • ${lessonTypeLabel}`}
    title={lesson.title}
    description={lesson.description ??
      "Continue your CloudTweak Academy learning."}
    backHref={`/student/courses/${programSlug}`}
    backLabel="Back to Course"
  />

  <main class="min-h-screen p-5">
    <div class="mx-auto max-w-[1200px] space-y-6">
      <div class="mt-2">
        <div class="flex flex-wrap items-center gap-3">
          <span
            class="text-xs font-semibold uppercase tracking-[0.14em] text-orange-500"
          >
            {lessonTypeLabel}
          </span>

          {
            lesson.duration ? (
              <span class="rounded-full bg-primary px-2.5 py-1 text-xs font-medium text-white">
                {lesson.duration} mins
              </span>
            ) : null
          }
        </div>

        {
          lesson.description ? (
            <div class="prose prose-slate mt-3 max-w-none dark:prose-invert">
              <p>{lesson.description}</p>
            </div>
          ) : null
        }
      </div>

      <StudentLessonAccess
        client:load
        programId={program.id}
        lessonId={lesson.id}
        programSlug={programSlug}
        previousLessonUrl={previousLessonUrl}
        nextLessonUrl={nextLessonUrl}
      />

      <StudentLessonAssessment
        client:load
        programId={program.id}
        moduleId={moduleData.id}
        lessonId={lesson.id}
      />
    </div>
  </main>
</StudentLayout>
