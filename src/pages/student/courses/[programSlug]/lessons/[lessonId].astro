---
import StudentLayout from "../../../../../layouts/StudentLayout.astro";
import StudentPageHeader from "../../../../../components/student/StudentPageHeader.astro";
import { ArrowLeft, ArrowRight, CheckCircle2 } from "lucide-astro";

const { programSlug, lessonId } = Astro.params;
---

<StudentLayout
  title="Lesson"
  description="Continue your CloudTweak Academy learning."
>
  <main class="min-h-screen p-5 md:p-6 xl:p-8">
    <div class="mx-auto max-w-[1200px] space-y-6">
      <StudentPageHeader
        eyebrow="Learning"
        title="Lesson title"
        description="Lesson content will be loaded here."
        backHref={`/student/courses/${programSlug}`}
        backLabel="Back to Course"
      />

      <article
        class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900 md:p-8"
      >
        <div class="aspect-video rounded-2xl bg-slate-100 dark:bg-slate-800">
          <div
            class="flex h-full items-center justify-center text-sm text-slate-400"
          >
            Lesson media / content
          </div>
        </div>

        <div class="mt-8">
          <p
            class="text-xs font-semibold uppercase tracking-[0.14em] text-orange-500"
          >
            Lesson
          </p>

          <h2 class="mt-2 text-2xl font-bold text-slate-900 dark:text-white">
            Lesson title
          </h2>

          <div class="prose prose-slate mt-6 max-w-none dark:prose-invert">
            <p>
              Lesson content will be rendered here when the Academy lesson data
              and content model are connected.
            </p>
          </div>
        </div>

        <div
          class="mt-8 flex flex-col gap-3 border-t border-slate-200 pt-6 sm:flex-row sm:items-center sm:justify-between dark:border-slate-800"
        >
          <a
            href="#"
            class="inline-flex items-center justify-center gap-2 rounded-xl border border-slate-200 px-5 py-3 text-sm font-semibold text-slate-700 transition hover:bg-slate-50 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800"
          >
            <ArrowLeft size={16} />
            Previous Lesson
          </a>

          <button
            type="button"
            class="inline-flex items-center justify-center gap-2 rounded-xl bg-orange-500 px-5 py-3 text-sm font-semibold text-white transition hover:bg-orange-600"
          >
            Mark Complete
            <CheckCircle2 size={16} />
          </button>

          <a
            href="#"
            class="inline-flex items-center justify-center gap-2 rounded-xl bg-slate-900 px-5 py-3 text-sm font-semibold text-white transition hover:bg-slate-700 dark:bg-white dark:text-slate-900 dark:hover:bg-slate-200"
          >
            Next Lesson
            <ArrowRight size={16} />
          </a>
        </div>
      </article>
    </div>
  </main>
</StudentLayout>
