---
import StudentLayout from "../../../layouts/StudentLayout.astro";
import StudentCourses from "../../../islands/student/StudentCourses";
import StudentHeader from "../../../components/admin/UI/StudentHeader.astro";
---

<StudentLayout
  title="My Courses"
  description="View your enrolled CloudTweak Academy courses and discover new programs."
>
  <main class="min-h-screen">
    <StudentHeader
      eyebrow="Academy"
      title="My Courses"
      description="Continue your learning, track your enrolled programs, and discover what's next."
    />
    <div class="mx-auto max-w-[1600px] space-y-6 p-5">
      <StudentCourses client:load />
    </div>
  </main>
</StudentLayout>
