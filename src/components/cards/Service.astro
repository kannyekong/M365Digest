---
import Paragraph from "../shared/Paragraph.astro";


export interface Props {
  week: string;
  title: string;
  description: string;
  icon: string;
  href: string;
}

const { week, title, description, icon, href } = Astro.props;
---

<div
  class="p-5 sm:p-6 lg:p-8 rounded-3xl border border-box-border bg-box-bg shadow-lg shadow-box-shadow relative overflow-hidden transition-all duration-500 hover:-translate-y-2 hover:border-primary/40 hover:shadow-2xl"
>
  <div class="rounded-xl p-3 text-heading-1 w-max relative">
    <slot set:html={icon} />
  </div>
  <div class="mt-6 space-y-4 relative">
    <div>
      <div class="">
        <mark
          class="text-sm md:text-md text-white bg-gradient-to-br from-indigo-600 from-20% via-primary via-30% to-yellow-500 p-1 rounded"
          >{week}</mark
        >
      </div>
      <h2 class="text-lg md:text-xl font-semibold text-heading-2">
        {title}
      </h2>
    </div>

    <Paragraph>
      {description}
    </Paragraph>
    <div class="flex flex-col justify-between font-semibold text-blue-400">
      <!-- <a
        href={href}
        class="inline-flex items-center gap-2 text-sm md:text-md hover:text-blue-800 transition"
      >
        More details

        <BadgeInfo size={18} strokeWidth={2.5} />
      </a> -->
    </div>
  </div>
  <span
    class="absolute w-32 aspect-square -bottom-16 -right-16 bg-primary/10 rounded-full"
  ></span>
</div>
