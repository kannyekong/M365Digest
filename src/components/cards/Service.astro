---
import Paragraph from '../shared/Paragraph.astro';

export interface Props{
    week:string
    title:string
    description:string
    icon: string
}

const {week,title, description, icon} = Astro.props
---
<div class="p-5 sm:p-6 lg:p-8 rounded-3xl border border-box-border bg-box-bg shadow-lg shadow-box-shadow relative overflow-hidden">
    <div class="rounded-xl p-3 text-heading-1 w-max relative">
            <slot set:html={icon} />
    </div>
    <div class="mt-6 space-y-4 relative">
        <div>
            <div class=>
               <mark class="text-sm md:text-xl text-white bg-gradient-to-br from-indigo-600 from-20% via-primary via-30% to-yellow-500 p-1 rounded">{week}</mark>
            </div>
            <h2 class="text-lg md:text-xl font-semibold text-heading-2">
                {title}
            </h2>
        </div>
        
        <Paragraph>
            {description}
        </Paragraph>
        <a href="" class="text-sm md:text-md underline">View full details...</a>
    </div>
    <span class="absolute w-32 aspect-square -bottom-16 -right-16 bg-primary/10 rounded-full"></span>
</div>