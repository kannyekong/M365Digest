---
import Container from "../shared/Container.astro";
import {
  BadgeDollarSign,
  BrainCircuit,
  SquarePen,
  UserStar,
} from "lucide-astro";
---

<section id="req">
  <Container>
    <div class="mx-auto text-center max-w-xl md:max-w-full relative p-0">
      <Container>
        <div
          class="border-8 border-blue-400 rounded-xl md:rounded-full mx-auto lg:mx-0 p-5 sm:p-6 py-6 sm:py-8 max-w-full bg-box-bg shadow-box-shadow md:divide-x divide-box-border grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-8 md:gap-6 lg:gap-12"
        >
          <div>
            <a
              class="bg-blue-600 hover:bg-cyan-700 inline-flex items-center md:gap-2 text-white transition-all duration-300 hover:scale-105 shadow-lg hover:shadow-xl text-sm lg:text-md px-2 md:px-4 py-2 rounded-full group"
              href=""
              data-tally-open="gDkNGO"
              data-tally-layout="modal"
              data-tally-width="500"
              data-tally-hide-title="1"
              data-tally-emoji-text="👋"
              data-tally-emoji-animation="wave"
              data-tally-auto-close="0"
              data-tally-form-events-forwarding="1"
            >
              Register Now
              <span class="transition group-hover:translate-x-1">
                <SquarePen size={15} strokeWidth={3} />
              </span>
            </a>
          </div>

          <div>
            <a
              href="###"
              class="open-modal-btn bg-emerald-600 hover:bg-emerald-700 inline-flex items-center md:gap-2 text-white transition-all duration-300 hover:scale-105 shadow-lg hover:shadow-xl text-sm lg:text-md px-2 md:px-4 py-2 rounded-full group"
            >
              Make Payment
              <span class="transition group-hover:translate-x-1">
                <BadgeDollarSign size={15} strokeWidth={3} />
              </span>
            </a>
          </div>
          <!-- <button
              class="bg-pink-500 hover:bg-slate-900 text-white text-sm transition-all duration-300 hover:scale-105 shadow-lg hover:shadow-xl lg:text-md p-2 rounded-full pr-2 pl-2"
              ><a
                href="#tally-open=VL4vdg&tally-emoji-text=👋&tally-emoji-animation=wave"
                >Leave Feedback</a
              ></button
            > -->
          <div>
            <a
              href="###"
              class="bg-pink-500 hover:bg-slate-900 inline-flex items-center md:gap-2 text-white transition-all duration-300 hover:scale-105 shadow-lg hover:shadow-xl text-sm lg:text-md px-2 md:px-4 py-2 rounded-full group"
            >
              Leave Feedback
              <span class="transition group-hover:translate-x-1">
                <UserStar size={15} strokeWidth={3} />
              </span>
            </a>
          </div>

          <div>
            <a
              href="###"
              class="open-chatbot inline-flex items-center md:gap-2 bg-indigo-600 hover:bg-indigo-700 text-white transition-all duration-300 hover:scale-105 shadow-lg hover:shadow-xl text-sm lg:text-md px-2 md:px-4 py-2 rounded-full group"
            >
              Ask AI Assistant
              <span class="transition group-hover:translate-x-1">
                <BrainCircuit size={20} strokeWidth={3} />
              </span>
            </a>
          </div>
        </div>
      </Container>
    </div>
  </Container>
</section>
