---
import Container from "../shared/Container.astro";
import Title from "../shared/Title.astro";
---

<section  id="req">
  <Container>
    <div
      class="w-full relative py-8 md:py-10 px-6 md:px-8"
    >
      <div class="absolute right-0 top-0 h-full w-full flex justify-end">
        <div class="w-28 h-28 overflow-auto flex rounded-xl relative blur-2xl">
            <span
              class="absolute w-16 h-16 -top-1 -right-1 bg-green-500 rounded-md rotate-45"
            ></span>
            <span
              class="absolute w-16 h-16 -bottom-1 -right-1 bg-[#FCDC58] rounded-md rotate-45"
            ></span>
            <span
              class="absolute w-16 h-16 -bottom-1 -left-1 bg-primary rounded-md rotate-45"
            ></span>
          </div>
      </div>

      <div class="absolute left-0 bottom-0 h-full w-full flex items-end">
        <div class="w-28 h-28 overflow-auto flex rounded-xl relative blur-2xl">
            <span
              class="absolute w-16 h-16 -top-1 -right-1 bg-green-500 rounded-md rotate-45"
            ></span>
            <span
              class="absolute w-16 h-16 -bottom-1 -right-1 bg-[#FCDC58] rounded-md rotate-45"
            ></span>
            <span
              class="absolute w-16 h-16 -bottom-1 -left-1 bg-primary rounded-md rotate-45"
            ></span>
          </div>
      </div>
      <div class="mx-auto text-center max-w-xl md:max-w-2xl relative">
        <Title>
          <span class="text-transparent bg-clip-text bg-gradient-to-br from-indigo-600 from-20% via-primary via-30% to-green-600">What do you need to get started?</span>
        </Title>
      </div>
      <Container className="lg:mt-8 border-1 rounded-2xl">
            <div
            class="mx-auto lg:mx-0 p-5 sm:p-6 py-6 sm:py-8 max-w-full rounded-3xl bg-box-bg  shadow-box-shadow md:divide-x divide-box-border grid grid-cols-2 md:grid-cols-3 gap-4 sm:gap-8 md:gap-6 lg:gap-12"
            >
            <div class="items-right justify-right">
                <img src="/logos/application.png" alt="Computer" width="50" height="50" class="items-center">
                <p class="mt-2 text-heading-3">Computer with Internet</p>
            </div>

            <div class="">
                <img src="/logos/deadline_2.png" alt="Computer" width="50" height="50" class="items-center">
                <p class="mt-2 text-heading-3">2 Hours/ 3 Days Weekly Availability</p>
            </div>

            <div>
                <img src="/logos/machine-learning.png" alt="Computer" width="50" height="50" class="items-center">
                <p class="mt-2 text-heading-3">Readiness to Learn</p>
            </div>

            </div>
        </Container>
    </div>
  </Container>
</section>
