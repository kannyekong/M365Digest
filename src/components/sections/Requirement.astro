---
import Container from "../shared/Container.astro";
---

<section  id="req">
  <Container>
    
      <div class="mx-auto text-center max-w-xl md:max-w-2xl relative p-0">
        <Container>
            <div
            class="border-8 border-green-800 rounded-full mx-auto lg:mx-0 p-5 sm:p-6 py-6 sm:py-8 max-w-full bg-box-bg  shadow-box-shadow md:divide-x divide-box-border grid grid-cols-2 md:grid-cols-3 gap-4 sm:gap-8 md:gap-6 lg:gap-12"
            >
            <div class="items-right justify-right">
              <button class="border dark:text-white text-black text-sm lg:text-md p-1 rounded-full pr-2 pl-2"><a href="" data-tally-open="gDkNGO" data-tally-layout="modal" data-tally-width="500" data-tally-hide-title="1" data-tally-emoji-text="👋" data-tally-emoji-animation="wave" data-tally-auto-close="0" data-tally-form-events-forwarding="1"> Register Now</a></button>
                
            </div>

            <div>
             <button class="open-modal-btn border text-sm lg:text-md p-1 bg-primary text-white rounded-full pr-2 pl-2"><a href="###">Make Payment</a></button>
            </div>

            <div>
                  <button class="border dark:text-white text-black text-sm lg:text-md p-1 rounded-full pr-2 pl-2"><a href="#tally-open=VL4vdg&tally-emoji-text=👋&tally-emoji-animation=wave">Contact Us</a></button>
            </div>

            </div>
        </Container>
      </div>
  </Container>
</section>
