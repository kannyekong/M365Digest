---
import {
  ArrowRight,
  BookOpenText,
  Clock3,
  Newspaper,
  Sparkles,
  TrendingUp,
} from "lucide-astro";

import { getPublishedPosts } from "../../lib/blog";

/* Fetches published posts and limits the homepage section to the first three. */
const { data: posts } = await getPublishedPosts();

const latestPosts = posts?.slice(0, 3) ?? [];

/* Assigns each returned post to its position in the editorial layout. */
const featuredPost = latestPosts[0];
const secondaryPosts = latestPosts.slice(1, 3);

/* Formats the article publication date for display. */
function formatPostDate(date: string) {
  return new Date(date).toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
  });
}
---

<section>
  <div class="mx-auto max-w-full px-4">
    <!-- Section heading -->
    <div class="mx-auto mb-12 max-w-3xl text-center lg:mb-16">
      <div
        class="mb-4 inline-flex items-center gap-2 rounded-full bg-primary/10 px-4 py-2 text-xs font-semibold text-primary"
      >
        <Newspaper class="h-4 w-4" />
        Our Blog
      </div>

      <h2
        class="text-3xl font-bold tracking-tight text-foreground sm:text-4xl lg:text-5xl dark:text-white"
      >
        Ideas, insights &
        <span class="text-primary">practical knowledge.</span>
      </h2>

      
    </div>

    {
      featuredPost ? (
        <>
          <div class="grid gap-6 lg:grid-cols-[1.25fr_0.75fr]">
            <article class="group relative min-h-[480px] overflow-hidden rounded-[2rem] border border-border bg-card sm:min-h-[540px]">
              <img
                src={featuredPost.cover_image}
                alt={featuredPost.title}
                class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
                loading="lazy"
              />

              <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/45 to-black/5" />

              <div class="absolute left-5 top-5 flex items-center gap-2 rounded-full border border-white/20 bg-black/20 px-3 py-1.5 text-xs font-semibold text-white backdrop-blur-md sm:left-7 sm:top-7">
                <Sparkles class="h-3.5 w-3.5" />
                Featured Insight
              </div>

              <div class="absolute inset-x-0 bottom-0 p-6 sm:p-8">
                <div class="mb-4 flex flex-wrap items-center gap-3 text-xs font-medium text-white/70">
                  <span class="rounded-full bg-white/10 px-3 py-1 backdrop-blur-md">
                    Technology
                  </span>

                  <span class="flex items-center gap-1.5">
                    <Clock3 class="h-3.5 w-3.5" />
                    {formatPostDate(featuredPost.created_at)}
                  </span>
                </div>

                <h3 class="max-w-2xl text-2xl font-bold leading-tight text-white sm:text-3xl lg:text-4xl">
                  {featuredPost.title}
                </h3>

                {featuredPost.excerpt && (
                  <p class="mt-4 max-w-xl text-sm leading-6 text-white/75 sm:text-base">
                    {featuredPost.excerpt}
                  </p>
                )}

                <a
                  href={`/blog/${featuredPost.slug}`}
                  class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-white"
                >
                  Read Article

                  <ArrowRight class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" />
                </a>
              </div>
            </article>

            <div class="grid gap-6">
              {secondaryPosts.map((post) => (
                <article class="group grid overflow-hidden rounded-[1.75rem] border border-border bg-card sm:grid-cols-[180px_1fr] lg:grid-cols-1 xl:grid-cols-[180px_1fr]">
                  <div class="relative min-h-[190px] overflow-hidden">
                    <img
                      src={post.cover_image}
                      alt={post.title}
                      class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                      loading="lazy"
                    />

                    <div class="absolute left-3 top-3 rounded-full bg-background/90 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider text-foreground backdrop-blur-md">
                      Technology
                    </div>
                  </div>

                  <div class="flex flex-col justify-center p-5">
                    <div class="mb-3 flex items-center gap-2 text-xs text-muted-foreground">
                      <Clock3 class="h-3.5 w-3.5" />
                      {formatPostDate(post.created_at)}
                    </div>

                    <h3 class="text-lg font-bold leading-snug text-foreground transition-colors group-hover:text-primary">
                      {post.title}
                    </h3>

                    <a
                      href={`/blog/${post.slug}`}
                      class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-primary"
                    >
                      Read Insight

                      <ArrowRight class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" />
                    </a>
                  </div>
                </article>
              ))}
            </div>
          </div>

          <div class="relative mt-6 overflow-hidden rounded-[1.75rem] border border-border bg-gradient-to-r from-primary/5 via-background to-primary/10 px-6 py-7 sm:px-8">
            <div
              class="pointer-events-none absolute -right-16 -top-20 h-52 w-52 rounded-full bg-primary/10 blur-3xl"
              aria-hidden="true"
            />

            <div class="relative flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
              <div class="flex items-start gap-4">
                <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-primary/10 text-primary">
                  <TrendingUp class="h-5 w-5" />
                </div>

                <div>
                  <p class="font-semibold text-foreground dark:text-white">
                    Keep your knowledge ahead of the curve.
                  </p>

                  <p class="mt-1 max-w-xl text-sm leading-6 text-muted-foreground dark:text-white">
                    Explore more practical guides, technology insights,
                    tutorials, and perspectives from CloudTweak.
                  </p>
                </div>
              </div>

              <a
                href="/blog"
                class="blog-cta group inline-flex w-fit shrink-0 items-center gap-3 rounded-full bg-primary px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-primary/20 transition-all duration-300 hover:-translate-y-0.5 hover:shadow-xl"
              >
                <BookOpenText class="h-4 w-4" />

                Explore All Insights

                <ArrowRight class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" />
              </a>
            </div>
          </div>
        </>
      ) : (
        <!-- Empty state if no published posts are available -->
        <div class="rounded-[2rem] border border-slate-300 bg-muted/30 px-6 py-16 text-center">
          <Newspaper class="mx-auto h-8 w-8 text-primary" />

          <h3 class="mt-4 text-xl font-semibold text-foreground dark:text-white">
            Insights are on the way.
          </h3>

          <p class="mx-auto mt-2 max-w-md text-sm leading-6 text-muted-foreground dark:text-white">
            We're preparing practical insights, guides, and perspectives to
            help you get more from modern technology.
          </p>
        </div>
      )
    }
  </div>
</section>

<style>
  /* Gives the blog CTA a subtle breathing animation. */
  @keyframes blogCtaPulse {
    0%,
    100% {
      transform: scale(1);
    }

    50% {
      transform: scale(1.02);
    }
  }

  /* Applies a subtle animation without distracting from the article content. */
  .blog-cta {
    animation: blogCtaPulse 3s ease-in-out infinite;
  }

  /* Disables decorative motion when the visitor requests reduced motion. */
  @media (prefers-reduced-motion: reduce) {
    .blog-cta {
      animation: none;
    }
  }
</style>