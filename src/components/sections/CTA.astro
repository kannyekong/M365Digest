---
import Container from "../shared/Container.astro";
import { ITEMS_PER_PAGE, faqs } from "../../utils/accordiondata";
import Title from "../shared/Title.astro";
---

<section id="faq" class="">
  <Container>
    <div
      class="w-full relative py-8 md:py-10 px-6 md:px-8 rounded-2xl bg-gradient-to-tr from-gray-100 to-gray-200 dark:from-gray-900 dark:to-transparent"
    >
      <div class="absolute right-0 top-0 h-full w-full flex justify-end">
        <div class="w-28 h-28 overflow-auto flex rounded-xl relative blur-2xl">
          <span
            class="absolute w-16 h-16 -top-1 -right-1 bg-green-500 rounded-md rotate-45"
          ></span>
          <span
            class="absolute w-16 h-16 -bottom-1 -right-1 bg-[#FCDC58] rounded-md rotate-45"
          ></span>
          <span
            class="absolute w-16 h-16 -bottom-1 -left-1 bg-primary rounded-md rotate-45"
          ></span>
        </div>
      </div>

      <div class="absolute left-0 bottom-0 h-full w-full flex items-end">
        <div class="w-28 h-28 overflow-auto flex rounded-xl relative blur-2xl">
          <span
            class="absolute w-16 h-16 -top-1 -right-1 bg-green-500 rounded-md rotate-45"
          ></span>
          <span
            class="absolute w-16 h-16 -bottom-1 -right-1 bg-[#FCDC58] rounded-md rotate-45"
          ></span>
          <span
            class="absolute w-16 h-16 -bottom-1 -left-1 bg-primary rounded-md rotate-45"
          ></span>
        </div>
      </div>
      <div class="mx-auto text-center max-w-full md:max-w-2xl relative">
        <section>
          <div class="mx-auto max-w-full px-6">
            <!-- Heading -->
            <div class="mb-12 text-center">
              <Title>
                <span
                  class="bg-gradient-to-r from-indigo-600 via-primary to-green-600 bg-clip-text text-transparent"
                >
                  Frequently Asked Questions
                </span>
              </Title>
            </div>

            <!-- Accordion -->
            <!-- FAQ Container -->
            <div
              id="faq-container"
              data-items-per-page={ITEMS_PER_PAGE}
              class="space-y-4"
            >
              {
                faqs.map((faq, index) => (
                  <details
                    class="faq-item group overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm dark:border-gray-800 dark:bg-gray-900"
                    data-index={index}
                  >
                    <summary class="flex cursor-pointer list-none items-start justify-between px-2 py-2 lg:px-6 lg:py-5">
                      <h3 class="text-sm font-semibold text-gray-800 dark:text-white lg:text-lg">
                        {faq.question}
                      </h3>

                      <div class="ml-4 flex h-8 w-8 items-center justify-center rounded-full bg-gray-100 transition-transform duration-300 group-open:rotate-45 dark:bg-gray-800">
                        <span class="text-xl text-primary">+</span>
                      </div>
                    </summary>

                    <div class="border-t border-gray-100 px-6 pb-6 pt-4 dark:border-gray-800">
                      <p class="leading-5 text-gray-600 dark:text-gray-300 text-left">
                        {faq.answer}
                      </p>
                    </div>
                  </details>
                ))
              }
            </div>

            <!-- Pagination -->
            <div class="mt-10 flex items-center justify-center gap-4">
              <button
                id="prev-btn"
                class="rounded-xl bg-gray-200 px-5 py-2 dark:bg-gray-800"
              >
                Previous
              </button>

              <span
                id="page-indicator"
                class="text-sm text-gray-600 dark:text-gray-300"
              >
              </span>

              <button
                id="next-btn"
                class="rounded-xl bg-primary px-5 py-2 text-white"
              >
                Next
              </button>
            </div>
          </div>
        </section>
      </div>
    </div>
  </Container>
</section>
