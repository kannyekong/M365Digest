---
import {
  Eye,
  Globe,
  Lightbulb,
  Rocket,
} from "lucide-astro";

import Title from "../shared/Title.astro";

/* Stores the content and visual identity used for each company value card. */
const values = [
  {
    label: "Our Vision",
    heading: "Shaping the Future of Cloud Excellence",
    description:
      "To become a trusted leader in AI, automation, and cloud transformation, empowering organizations to unlock the full potential of modern technologies through intelligent, secure, and scalable digital solutions.",
    icon: Eye,
    borderColor: "border-blue-300",
    iconBackground: "bg-blue-50",
    iconColor: "text-blue-600",
    labelColor: "text-blue-600",
    glowColor: "bg-blue-400/10",
    accentColor: "bg-blue-500",
  },
  {
    label: "Our Mission",
    heading: "Simplifying Cloud Transformation",
    description:
     "To help organizations work smarter by integrating AI, automation, and cloud technologies to streamline workflows, improve collaboration, and drive sustainable growth.",
    icon: Rocket,
    borderColor: "border-blue-300",
    iconBackground: "bg-blue-50",
    iconColor: "text-blue-600",
    labelColor: "text-blue-600",
    glowColor: "bg-blue-400/10",
    accentColor: "bg-blue-700",
  },
  {
    label: "Our Purpose",
    heading: "Technology That Creates Meaningful Impact",
    description:
     "To help organizations turn emerging technologies into practical business value by safely adopting AI, automating processes, and maximizing the potential of cloud solutions.",
    icon: Lightbulb,
    borderColor: "border-blue-300",
    iconBackground: "bg-blue-50",
    iconColor: "text-blue-600",
    labelColor: "text-blue-600",
    glowColor: "bg-blue-400/10",
    accentColor: "bg-blue-700",
  },
];
---

<section
  class="relative isolate overflow-hidden py-12"
  aria-labelledby="vision-mission-purpose-heading"
>
  <!-- Subtle section decoration -->
  <div
    class="pointer-events-none absolute left-0 top-1/4 -z-10 h-72 w-72 rounded-full bg-blue-500/5 blur-[120px]"
    aria-hidden="true"
  ></div>

  <div
    class="pointer-events-none absolute bottom-0 right-0 -z-10 h-96 w-96 rounded-full bg-emerald-500/5 blur-[140px]"
    aria-hidden="true"
  ></div>

  <div class="mx-auto max-w-7xl px-6">
    <!-- Section heading -->
    <div class="mx-auto mb-12 max-w-3xl text-center lg:mb-16">
      <span
        class="mb-8 inline-flex items-center gap-2 rounded-full border border-blue-500/20 bg-blue-500/10 px-5 py-2 text-sm font-medium text-blue-700 backdrop-blur-xl dark:text-blue-300"
      >
        <Globe size={18} />
        Our Values
      </span>

      <Title
        class="text-3xl font-bold tracking-tight text-heading-1 sm:text-4xl lg:text-5xl"
      >
        We are building technology solutions with a
        <span
          class="bg-gradient-to-r from-indigo-600 via-primary to-emerald-500 bg-clip-text text-transparent"
        >
          clear direction
        </span>
      </Title>
    </div>

    <!-- Values cards -->
    <div class="grid gap-6 lg:grid-cols-3 lg:gap-8">
      {
        values.map(
          ({
            label,
            heading,
            description,
            icon: Icon,
            borderColor,
            iconBackground,
            iconColor,
            labelColor,
            glowColor,
            accentColor,
          }) => (
            <article
              class:list={[
                "group relative overflow-hidden rounded-[2rem] border bg-white/90 shadow-sm backdrop-blur-xl transition-all duration-500 hover:-translate-y-2 hover:shadow-xl",
                borderColor,
              ]}
            >
              <!-- Very subtle colored glow -->
              <div
                class:list={[
                  "pointer-events-none absolute -right-16 -top-16 h-48 w-48 rounded-full opacity-0 blur-3xl transition-all duration-700 group-hover:scale-125 group-hover:opacity-100",
                  glowColor,
                ]}
                aria-hidden="true"
              ></div>

              <!-- Colored top accent -->
              <div
                class:list={[
                  "absolute left-8 right-8 top-0 h-[3px] rounded-b-full opacity-70",
                  accentColor,
                ]}
                aria-hidden="true"
              ></div>

              <div class="relative flex h-full flex-col p-7 sm:p-8 lg:p-9">
                <!-- Icon and label -->
                <div class="flex items-center justify-between">
                  <div
                    class:list={[
                      "flex h-14 w-14 items-center justify-center rounded-2xl transition-all duration-500 group-hover:scale-105",
                      iconBackground,
                      iconColor,
                    ]}
                  >
                    <Icon size={27} strokeWidth={1.8} />
                  </div>

                  <span
                    class:list={[
                      "text-xs font-bold uppercase tracking-[0.22em]",
                      labelColor,
                    ]}
                  >
                    {label}
                  </span>
                </div>

                <!-- Content -->
                <div class="mt-10">
                  <h3
                    class="text-2xl font-bold leading-tight text-slate-950 sm:text-[1.65rem]"
                  >
                    {heading}
                  </h3>

                  <p class="mt-5 text-[15px] leading-7 text-slate-600">
                    {description}
                  </p>
                </div>

                <!-- Bottom accent -->
                <div class="mt-auto pt-8">
                  <div class="flex items-center gap-3">
                    <span
                      class:list={[
                        "h-2 w-2 rounded-full",
                        accentColor,
                      ]}
                    ></span>

                    <span class="h-px flex-1 bg-slate-200"></span>
                  </div>
                </div>
              </div>
            </article>
          ),
        )
      }
    </div>
  </div>
</section>