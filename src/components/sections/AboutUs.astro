---
import Container from "../shared/Container.astro";
import Paragraph from "../shared/Paragraph.astro";
import Title from "../shared/Title.astro";
import { CheckCircle, BadgeCheck, BadgeCheck } from "lucide-astro";
---

<section>
  <Container className="flex flex-col midmd:flex-row gap-4">
    <div
      class="max-w-md mx-auto midmd:max-w-none lg:mx-0 lg:pr-10 xl:pr-2 flex-1 flex w-11/12 midmd:w-5/12 lg:w-1/2 midmd:h-auto"
    >
      <div class="w-full h-full sm:h-96 midmd:h-full relative">
        <img
          src={"/images/tech.png"}
          alt="banner image"
          
          class="rounded-lg lg:rounded-4xl w-auto left-1/2 -translate-x-1/2 absolute max-h-full"
        />
      </div>
    </div>
    <div class="flex-1 flex p-2 md:p-0 midmd:w-7/12 lg:w-1/2 flex-col">
      <Title>
        <span
          class="text-transparent bg-clip-text bg-gradient-to-br from-indigo-600 from-20% via-primary via-30% to-green-600"
          >Benefits of joining this Bootcamp?</span
        >
      </Title>
      <ul class="mt-4 space-y-1">
        <li>
          <Paragraph
            ><span
              class="bg-box-bg rounded-full w-8 h-8 text-primary inline-flex justify-center items-center"
              ><BadgeCheck size={20} strokeWidth={5} /></span
            >Gain hands-on experience with widely used Microsoft 365
            technologies used by organizations worldwide</Paragraph
          >
        </li>
        <li>
          <Paragraph
            ><span
              class="bg-box-bg rounded-full w-8 h-8 text-primary inline-flex justify-center items-center"
              ><BadgeCheck size={20} strokeWidth={3} /></span
            > Build practical administrative skills in areas such as Exchange Online,
            SharePoint & OneDrive, Entra ID, Teams and MS Defender.</Paragraph
          >
        </li>
        <li>
          <Paragraph
            ><span
              class="bg-box-bg rounded-full w-8 h-8 text-primary inline-flex justify-center items-center"
              ><BadgeCheck size={20} strokeWidth={3} /></span
            > Understand real-world workplace scenarios and how administrators manage
            users, security, collaboration, and cloud services</Paragraph
          >
        </li>

        <li>
          <Paragraph
            ><span
              class="bg-box-bg rounded-full w-8 h-8 text-primary inline-flex justify-center items-center"
              ><BadgeCheck size={20} strokeWidth={3} /></span
            > Develop confidence working in enterprise environments and modern digital
            workplaces</Paragraph
          >
        </li>
        <li>
          <Paragraph
            ><span
              class="bg-box-bg rounded-full w-8 h-8 text-primary inline-flex justify-center items-center"
              ><BadgeCheck size={20} strokeWidth={3} /></span
            > Create a strong foundation for advanced Microsoft certifications and
            career growth</Paragraph
          >
        </li>
      </ul>
    </div>
  </Container>
</section>
