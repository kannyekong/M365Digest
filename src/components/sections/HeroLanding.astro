---
import Container from "../shared/Container.astro";
import HeroCarousel from "../hero/HeroCarousel";
import Paragraph from "../shared/Paragraph.astro";
import BtnLinkStart from "../shared/BtnLinkStart.astro";
import TypewriterText from "@astroanimate/core/TypewriterText";
import { Rocket, Telescope } from "lucide-react";
---

<section class="relative pt-5">
  <Container>
    <div class="md:hidden">
      <div
        class="relative flex flex-col text-center
        items-center max-w-full"
      >
        <h1
          class="text-5xl tracking-loose leading-12 font-extrabold bg-gradient-to-r from-blue-500 dark:from-pink-600 via-blue-800 to-black dark:to-white bg-clip-text text-transparent"
        >
          Modernizing Businesses with Intelligent Cloud Solutions.
        </h1>
      </div>
      <p class="text-md text-center text-gray-500 leading-7">
        Empower your business with AI-driven automation powered by Claude, n8n,
        Make, Zapier, and Microsoft Power Platform. We build intelligent
        workflows that save time, reduce operational costs, and scale with your
        organization. Explore our solutions to see all our offerings.
      </p>
      <div
        class="mt-5 w-full flex flex-row justify-center max-w-full mx-auto space-x-4"
      >
        <a
          href="#tally-open=MeglOM&tally-layout=modal&tally-width=500&tally-emoji-animation=wave&tally-auto-close=2000&tally-form-events-forwarding=1"
          class={`inline-flex items-center justify-center gap-2 rounded-full px-4 py-2 font-semibold text-white transition bg-pink-500`}
        >
          <span class="text-sm">Request a Quote</span>
        </a>

        <a
          href="/solutions"
          class={`inline-flex items-center justify-center gap-2 rounded-full px-4 py-3 font-semibold text-white transition bg-blue-500`}
        >
          <span class="text-sm">Explore our solutions</span>
        </a>
      </div>
    </div>
  </Container>
</section>
<HeroCarousel client:load />
