---
import Container from "../shared/Container.astro";
import HeroCarousel from "../hero/HeroCarousel";
import TypewriterText from "@astroanimate/core/TypewriterText";
---

<section class="relative pt-5">
  <Container>
    <div class="md:hidden">
      <div
        class="relative flex flex-col text-center
        items-center max-w-full"
      >
        <h1
          class="bg-gradient-to-r from-blue-500 via-blue-800 to-black bg-clip-text text-4xl leading-12 font-bold tracking-tight text-transparent dark:from-pink-600 dark:to-white"
        >
          Modernizing Businesses with Intelligent Cloud <br />

          <span class="inline-flex items-baseline whitespace-nowrap">
            <TypewriterText
              texts={["Solutions"]}
              typeSpeed={90}
              eraseSpeed={90}
              pauseAfter={2800}
              enhance
            />

            <span
              class="typewriter-cursor ml-[1px] inline-block"
              aria-hidden="true"
            >
              _
            </span>
          </span>
        </h1>
      </div>
      <p class="text-md text-center text-gray-500 leading-7 mt-5">
        Empower your business with AI-driven automation powered by Claude, n8n,
        Make, Zapier, and Microsoft Power Platform. We build intelligent
        workflows that save time, reduce operational costs, and scale with your
        organization. Explore our solutions to see all our offerings.
      </p>
      <div
        class="mt-5 w-full flex flex-row justify-center max-w-full mx-auto space-x-4"
      >
        <a
          href="#tally-open=MeglOM&tally-layout=modal&tally-width=500&tally-emoji-animation=wave&tally-auto-close=2000&tally-form-events-forwarding=1"
          class={`inline-flex items-center justify-center gap-2 rounded-lg px-6 py-2 font-semibold text-white transition bg-pink-500`}
        >
          <span class="text-sm">Request a Quote</span>
        </a>

        <a
          href="/solutions"
          class={`inline-flex items-center justify-center gap-2 rounded-lg px-4 py-3 font-semibold text-white transition bg-blue-500`}
        >
          <span class="text-sm">Explore our solutions</span>
        </a>
      </div>
    </div>
  </Container>
</section>
<HeroCarousel client:load />

<style>
  .typewriter-cursor {
    animation: typewriter-cursor-blink 1s step-end infinite;
  }

  @keyframes typewriter-cursor-blink {
    0%,
    49% {
      opacity: 1;
    }

    50%,
    100% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .typewriter-cursor {
      animation: none;
    }
  }
</style>
