---
import Container from "../shared/Container.astro";
import { Quote, Star, UserCircle } from "lucide-astro";
import Title from "../shared/Title.astro";
import { listTestimonials } from "../../lib/testimonials";

const { data: testimonials } = await listTestimonials();
---


<section class="py-12 overflow-hidden">
  <Container>
    <div class="text-center max-w-3xl mx-auto">
      <Title className="mt-5">
        What our
        <span
          class="bg-gradient-to-r from-indigo-600 via-primary to-emerald-500 bg-clip-text text-transparent"
        >
          Clients say
        </span>
      </Title>
    </div>
  </Container>

  <div class="relative mt-10">
    <div class="testimonial-track">
      {
        [...(testimonials ?? []), ...(testimonials ?? [])].map((item) => (
          <div class="w-[380px] shrink-0 rounded-3xl border border-box-border bg-white dark:bg-box-bg p-8 shadow-xl">
            <Quote class="text-primary mb-5" size={34} />

            <p class="leading-7 text-gray-600 dark:text-gray-300">
              "{item.testimonial}"
            </p>

            <div class="flex mt-6">
              {Array.from({ length: 5 }).map(() => (
                <Star size={16} class="fill-yellow-400 text-yellow-400" />
              ))}
            </div>

            <div class="flex items-center gap-4 mt-8">
              <UserCircle />

              <div>
                <h4 class="font-semibold text-heading-1">{item.full_name}</h4>

                <p class="text-sm text-gray-500">{item.position}</p>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
