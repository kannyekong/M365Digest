---
import Container from "../shared/Container.astro";
import Paragraph from "../shared/Paragraph.astro";
import ByNumber from "./ByNumber.astro";
import BtnLinkStart from "../shared/BtnLinkStart.astro";
import TypewriterText from "@astroanimate/core/TypewriterText";
---

<section class="relative pt-32 lg:pt-36">
  <Container className={"flex flex-col lg:flex-row gap-10 lg:gap-12"}>
    <div class="absolute w-full lg:w-1/2 inset-y-0 lg:right-0">
      <span
        class="absolute -left-6 md:left-4 top-24 lg:top-28 w-24 h-24 rotate-90 skew-x-12 rounded-3xl bg-red-300 blur-xl opacity-60 lg:opacity-95 lg:block hidden"
      ></span>
      <span
        class="absolute right-4 bottom-12 w-24 h-24 rounded-3xl bg-blue-500 blur-xl opacity-80"
      ></span>
    </div>
    <!-- <span
      class="w-4/12 lg:w-3/12 md:aspect-square md:bg-gradient-to-tr from-blue-400 to-green-400 absolute -top-5 lg:left-0 rounded-full skew-y-12 blur-2xl opacity-40 skew-x-12 rotate-90"
    ></span> -->
    <div
      class="relative flex flex-col text-left sm:space-y-6 lg:py-7 xl:py-8
        items-start lg:max-w-none max-w-3xl mx-auto lg:mx-0 lg:flex-1 lg:w-1/2"
    >
      <span class="bg-yellow-500 p-0.5 rounded font-bold">Cohort 1.0</span>
      <h1
        class="text-5xl/tight md:text-5xl/tight tracking-tight xl:text-6xl/tight font-bold text-heading-1"
      >
        M365 Bootcamp:

        <span class="text-primary"> 6 Weeks to Mastery of </span>
        <span
          class="inline-block
      min-w-[12ch]
      whitespace-nowrap
      text-primary"
        >
          <TypewriterText
            texts={[
              "Exchange",
              "SharePoint",
              "Entra ID",
              "OneDrive",
              "Copilot",
              "Teams",
            ]}
            enhance
          />
        </span>
      </h1>
      <mark
        class="border-2 border-yellow-500 bg-white p-0.5 rounded font-bold pr-1 pl-1"
        ><i class="fa fa-bullhorn text-yellow-500 font-bold"></i> 1st June - 13th
        July, 2026</mark
      >
      <Paragraph className="mt-5">
        In six weeks, you will progress from basic familiarity to confident
        administration of core Microsoft 365 services, including Outlook, Teams,
        SharePoint, OneDrive, Power Automate, and Power BI. Each session is
        built around real-world administrative scenarios—equipping you not just
        to understand the platform, but to effectively manage users, secure
        data, optimize environments, and resolve everyday operational
        challenges.
      </Paragraph>
      <div
        class="mt-5 w-full flex flex-row max-w-full mx-auto lg:mx-0 space-x-4"
      >
        <div class="lg:min-w-max flex lg:items-center sm:w-max w-full">
          <BtnLinkStart
            text="Explore Learning"
            href="/weekone"
            className="flex justify-center w-full sm:w-max"
            variant="primary"
          />
        </div>
        <div
          class="lg:min-w-max flex lg:items-center sm:w-max w-full lg:pb-0 border-b border-box-bg lg:border-0 lg:px-0"
        >
          <button
            data-tally-open="gDkNGO"
            data-tally-layout="modal"
            data-tally-width="500"
            data-tally-hide-title="1"
            data-tally-emoji-text="👋"
            data-tally-emoji-animation="wave"
            data-tally-auto-close="0"
            data-tally-form-events-forwarding="1"
            class="bg-primary text-white text-sm py-3 px-2 w-full
            md:text-md
            md:px-6
            md:py-3
            rounded-full
            outline-none
            relative
            overflow-hidden
            duration-300
            ease-linear
            z-0
            after:absolute
            after:inset-x-0
            after:aspect-square
            after:scale-0
            after:opacity-70
            after:origin-center
            after:duration-300
            after:ease-linear
            after:rounded-full
            after:top-0
            after:left-0
            after:bg-[#172554]
            after:z-[-1]
            hover:text-white
            hover:after:opacity-100
            shadow-orange-500
            animate-soft-glow
            hover:after:scale-[2.5]"
          >
            <span class="relative z-10"> Register Now </span>
          </button>
        </div>
      </div>
    </div>

    <div
      class="flex flex-1 lg:w-1/2 lg:h-auto relative lg:max-w-none lg:mx-0 mx-auto max-w-3xl"
    >
      <img
        src="/images/boot.jpg"
        alt="Hero image"
        width="2350"
        height="2359"
        class="lg:absolute lg:w-full lg:h-full rounded-3xl lg:rounded-full object-cover lg:max-h-none max-h-96 md:rotate-5 hover:rotate-0 transition-all duration-500 shadow-2xl"
      />
    </div>
  </Container>

  <ByNumber />
</section>
