---
import Title from "../shared/Title.astro";
import {
  Cloud,
  LifeBuoy,
  ArrowRightLeft,
  GraduationCap,
  Network,
  Globe,
  Users,
  Rocket,
  SquareArrowOutDownRight,
} from "lucide-astro";

import { listServices } from "../../lib/services";
const { data: items } = await listServices();
const serviceIcons = {
  "Technology Bootcamp Trainings": GraduationCap,
  "Cloud Consultancy": Cloud,
  "Technical Support Advisory": LifeBuoy,
  "Power Platform Solutions": ArrowRightLeft,
  "Networking Solutions": Network,
  "Software Development": Globe,
};
---

<div class="text-center max-w-3xl mx-auto mb-16 space-y-6">
  <span
    class="inline-flex
          items-center
          gap-2
          rounded-full
          border
          border-blue-500/20
          bg-blue-500/10
          px-5
          py-2
          text-sm
          font-medium
          text-blue-700
          dark:text-blue-300
          backdrop-blur-xl"
  >
    <Users size={18} />
    What we offer
  </span>

  <Title className="mt-5">
    Helping Businesses Build, Secure &
    <span
      class="bg-gradient-to-r from-indigo-600 via-primary to-emerald-500 bg-clip-text text-transparent"
    >
      Scale with Technology
    </span>
  </Title>

  <p class="mt-5 dark:text-white">
    We deliver practical technology solutions that empower businesses to embrace
    cloud transformation, strengthen security, improve collaboration, and
    accelerate digital growth.
  </p>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-8 px-4 md:px-0">
  {
    items?.map((service) => {
      const Icon =
        serviceIcons[service.title as keyof typeof serviceIcons] ?? Cloud;

      const featured = service.title === "Technology Bootcamp Trainings";

      return (
        <div
          class:list={[
            "group relative rounded-3xl backdrop-blur-xl p-8 transition-all duration-500 hover:-translate-y-2",
            featured
              ? "overflow-hidden border-2 border-primary bg-gradient-to-br from-primary/10 via-white dark:via-box-bg to-emerald-500/10 shadow-xl hover:shadow-[0_20px_60px_rgba(37,99,235,0.25)]"
              : "border border-box-border bg-white/70 dark:bg-box-bg/70 hover:border-primary/40 hover:shadow-2xl",
          ]}
        >
          {featured && (
            <>
              <div class="absolute -top-20 -right-20 h-48 w-48 rounded-full bg-primary/20 blur-3xl" />

              <span class="absolute top-5 right-5 rounded-full bg-primary px-3 py-1 text-xs font-semibold text-white shadow-lg">
                🚀 Now Enrolling
              </span>
            </>
          )}

          <div
            class:list={[
              "relative z-10 mb-6 flex h-16 w-16 items-center justify-center rounded-2xl transition-all duration-500",
              featured
                ? "bg-gradient-to-br from-primary to-emerald-500 shadow-lg shadow-primary/30"
                : "bg-gradient-to-br from-primary/20 to-emerald-500/20 group-hover:scale-110",
            ]}
          >
            <Icon
              size={32}
              class:list={[
                "transition-colors",
                featured
                  ? "text-white"
                  : "text-primary group-hover:text-emerald-500",
              ]}
            />
          </div>

          <h3 class="relative z-10 text-xl font-bold text-heading-1">
            {service.title}
          </h3>

          <p class="relative z-10 mt-4 leading-7 text-gray-600 dark:text-gray-400">
            {service.description}
          </p>

          <a
            href={service.button_url}
            class:list={[
              "relative z-10 mt-8 inline-flex items-center gap-2 font-semibold transition-all",
              featured
                ? "rounded-full bg-primary px-5 py-3 text-white hover:bg-indigo-700 hover:gap-3"
                : "text-primary hover:gap-3",
            ]}
          >
            {service.button_text}

            {featured ? <Rocket size={18} /> : <SquareArrowOutDownRight />}
          </a>
        </div>
      );
    })
  }
</div>
