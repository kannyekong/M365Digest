---
import Title from "../shared/Title.astro";
import {
  Cloud,
  LifeBuoy,
  ArrowRightLeft,
  Network,
  Globe,
  Users,
  Building,
  Briefcase,
  Rocket,
  SquareArrowOutDownRight,
  ArrowRight,
  BrainCircuit,
  Bot,
  Workflow,
  ShieldCheck,
  GraduationCap,
  Computer,
  Atom,
  Play,
} from "lucide-astro";

import { listServices } from "../../lib/services";
const { data: items } = await listServices();
const serviceIcons = {
  "Technology Bootcamp Trainings": GraduationCap,
  "Cloud Consultancy": Cloud,
  "Technical Support Advisory": LifeBuoy,
  "Power Platform Solutions": ArrowRightLeft,
  "Networking Solutions": Network,
  "Software Development": Globe,
};

interface Props {
  videoUrl?: string;
}

const { videoUrl = "https://www.youtube.com/embed/YOUR_VIDEO_ID" } =
  Astro.props;
---

<div class="text-center px-6 md:max-w-3xl mx-auto mb-16 space-y-6">
  <span
    class="inline-flex
          items-center
          gap-2
          rounded-full
          border
          border-blue-500/20
          bg-blue-500/10
          px-5
          py-2
          text-sm
          font-medium
          text-blue-700
          dark:text-blue-300
          backdrop-blur-xl"
  >
    <Briefcase size={18} />
    Our services
  </span>

  <Title className="mt-5 px-6">
    Helping Businesses Build, Secure &
    <span
      class="bg-gradient-to-r from-indigo-600 via-primary to-emerald-500 bg-clip-text text-transparent"
    >
      Scale with Technology
    </span>
  </Title>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-8 px-4 md:px-6">
  {
    items?.map((service) => {
      const Icon =
        serviceIcons[service.title as keyof typeof serviceIcons] ?? Cloud;

      const featured = service.highlight;

      return (
        <div
          class:list={[
            "group relative rounded-3xl backdrop-blur-xl p-8 transition-all duration-500 hover:-translate-y-2",
            featured
              ? "overflow-hidden border-2 border-primary bg-gradient-to-br from-primary/10 via-white dark:via-box-bg to-emerald-500/10 shadow-xl hover:shadow-[0_20px_60px_rgba(37,99,235,0.25)]"
              : "border border-box-border bg-white/70 dark:bg-box-bg/70 hover:border-primary/40 hover:shadow-2xl",
          ]}
        >
          {featured && (
            <>
              <div class="absolute -top-20 -right-20 h-48 w-48 rounded-full bg-primary/20 blur-3xl" />

              <span class="absolute top-5 right-5 rounded-full bg-primary px-3 py-1 text-xs font-semibold text-white shadow-lg">
                {service.badge}
              </span>
            </>
          )}

          <div
            class:list={[
              "relative z-10 mb-6 flex h-16 w-16 items-center justify-center rounded-2xl transition-all duration-500",
              featured
                ? "bg-gradient-to-br from-primary to-emerald-500 shadow-lg shadow-primary/30"
                : "bg-gradient-to-br from-primary/20 to-emerald-500/20 group-hover:scale-110",
            ]}
          >
            <Icon
              size={32}
              class:list={[
                "transition-colors",
                featured
                  ? "text-white"
                  : "text-primary group-hover:text-emerald-500",
              ]}
            />
          </div>

          <h3 class="relative z-10 text-xl font-bold text-heading-1">
            {service.title}
          </h3>

          <p class="relative z-10 mt-4 leading-7 text-gray-600 dark:text-gray-400">
            {service.description}
          </p>

          <a
            href={service.button_url}
            class:list={[
              "relative z-10 mt-8 inline-flex items-center gap-2 font-semibold transition-all",
              featured
                ? "rounded-full bg-primary px-5 py-3 text-white hover:bg-indigo-700 hover:gap-3"
                : "text-primary hover:gap-3",
            ]}
          >
            {service.button_text}

            {featured ? <Rocket size={18} /> : <SquareArrowOutDownRight />}
          </a>
        </div>
      );
    })
  }
</div>

<section class="relative overflow-hidden py-12" id="about">
  <div class="mx-auto max-w-full px-3">
    <!-- Header -->

    <div class="max-w-7xl mx-auto text-center px-6">
      <span
        class="inline-flex
          items-center
          gap-2
          rounded-full
          border
          border-blue-500/20
          bg-blue-500/10
          px-5
          py-2
          text-sm
          mb-8
          font-medium
          text-blue-700
          dark:text-blue-300
          backdrop-blur-xl"
      >
        <Atom size={18} />
        About Us
      </span>
      <Title
        class="mt-6 text-4xl font-bold tracking-tight text-heading-1 lg:text-5xl"
      >
        We help Organizations Unlock the Full Potential of <span
          class="bg-gradient-to-r from-indigo-600 via-primary to-emerald-500 bg-clip-text text-transparent"
          >AI, Automation & Cloud Technologies.</span
        >
      </Title>
    </div>

    <div class="mt-15 grid gap-14 lg:grid-cols-2 md:px-4">
      <!-- Left -->

      <div>
        <div class="relative lg:sticky lg:top-28">
          <div
            class="absolute -inset-6 -z-10 rounded-[2.5rem] bg-primary/5 blur-3xl"
            aria-hidden="true"
          >
          </div>

          <div
            class="overflow-hidden rounded-3xl border border-slate-300 bg-card shadow-xl"
          >
            <div
              class="flex items-center justify-between border-b border-border bg-muted/40 px-5 py-4"
            >
              <div class="flex items-center gap-3">
                <div class="flex gap-1.5" aria-hidden="true">
                  <span class="h-2.5 w-2.5 rounded-full bg-muted-foreground/30"
                  ></span>
                  <span class="h-2.5 w-2.5 rounded-full bg-muted-foreground/30"
                  ></span>
                  <span class="h-2.5 w-2.5 rounded-full bg-muted-foreground/30"
                  ></span>
                </div>
              </div>

              <span
                class="rounded-full bg-blue-700 px-3 py-1 text-xs font-medium text-white"
              >
                From the CEO
              </span>
            </div>

            <div class="relative aspect-video bg-black">
              <iframe
                src={videoUrl}
                title="Inside the CloudTweak Classroom"
                class="absolute inset-0 h-full w-full"
                loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen></iframe>
            </div>

            <div class="p-5 sm:p-6">
              <div class="flex items-start gap-4">
                <div
                  class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-primary/10 dark:border border-white"
                >
                  <Play className="h-5 w-5 fill-primary text-primary" />
                </div>

                <div>
                  <h3 class="font-semibold text-foreground sm:text-lg dark:text-white">
                    Reimagine how your business works with AI—automate smarter,
                    operate faster, and achieve more.
                  </h3>

                  <p class="mt-1 text-sm leading-6 text-muted-foreground dark:text-white">
                    See how businesses can harness AI to streamline operations,
                    automate everyday processes, and unlock new levels of
                    productivity across the organization.
                  </p>
                </div>
              </div>

              <div
                class="mt-5 flex flex-wrap gap-x-2 md:gap-x-5 gap-y-2 border-t border-slate-300 pt-5 text-xs font-medium text-muted-foreground sm:text-sm dark:text-white"
              >
                <span>#Copilot</span>
                <span>#Claude</span>
                <span>#Open AI</span>
                <span>#Zapier</span>
                <span>#n8n</span>
                <span>#Make</span>
              </div>
            </div>
          </div>
        </div>

        <a
          href="/solutions"
          class="mt-10 inline-flex justify-center items-center gap-2 rounded-full bg-primary px-6 py-3 font-semibold text-white transition hover:bg-blue-700"
        >
          Explore Our Solutions

          <ArrowRight size={18} />
        </a>
      </div>

      <!-- Right -->

      <div class="grid gap-5">
        <div
          class="group rounded-3xl border border-box-border bg-blue-50 dark:bg-box-bg/70 backdrop-blur-xl p-6 transition hover:-translate-y-1 hover:border-primary/30"
        >
          <div class="flex items-center gap-5">
            <div
              class="flex h-14 w-14 items-center justify-center text-primary"
            >
              <BrainCircuit size={30} />
            </div>

            <div>
              <h4 class="font-bold text-xl text-heading-1">
                Artificial Intelligence
              </h4>

              <p class="mt-2 text-gray-600 dark:text-gray-400">
                Securely integrate AI attendants and chatbots to your existing
                company site to handle offline client requests and generate
                marketing leads.
              </p>
            </div>
          </div>
        </div>

        <div
          class="group rounded-3xl border border-box-border bg-green-50 dark:bg-box-bg/70 backdrop-blur-xl p-6 transition hover:-translate-y-1 hover:border-primary/30"
        >
          <div class="flex items-center gap-5">
            <div
              class="flex h-14 w-14 items-center justify-center text-emerald-500"
            >
              <Workflow size={30} />
            </div>

            <div>
              <h4 class="font-bold text-xl text-heading-1">
                Intelligent Automation
              </h4>

              <p class="mt-2 text-gray-600 dark:text-gray-400">
                Safely deploy automated AI solutions like n8n, Make, Zapier,
                Power Automate, and AI agents into your organization
                infrastructure to meet your requirements.
              </p>
            </div>
          </div>
        </div>

        <div
          class="group rounded-3xl border border-box-border bg-cyan-50 dark:bg-box-bg/70 backdrop-blur-xl p-6 transition hover:-translate-y-1 hover:border-primary/30"
        >
          <div class="flex items-center gap-5">
            <div
              class="flex h-14 w-14 items-center justify-center text-cyan-500"
            >
              <Computer size={30} />
            </div>

            <div>
              <h4 class="font-bold text-xl text-heading-1">
                Web apps and software development
              </h4>

              <p class="mt-2 text-gray-600 dark:text-gray-400">
                We build and deploy intelligent web, mobile, and desktop
                solutions that help organizations apply AI to real-world
                business challenges.
              </p>
            </div>
          </div>
        </div>

        <div
          class="group rounded-3xl border border-box-border bg-violet-50 dark:bg-box-bg/70 backdrop-blur-xl p-6 transition hover:-translate-y-1 hover:border-primary/30"
        >
          <div class="flex items-center gap-5">
            <div
              class="flex h-14 w-14 items-center justify-center text-violet-500"
            >
              <ShieldCheck size={30} />
            </div>

            <div>
              <h4 class="font-bold text-xl text-heading-1">
                Learning and Development
              </h4>

              <p class="mt-2 text-gray-600 dark:text-gray-400">
                Secure cloud adoption backed by technical support,
                cybersecurity, and practical Cloud solution trainings.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
