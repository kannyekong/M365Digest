---
import Service from "../cards/Service.astro";
import Container from "../shared/Container.astro";
import Paragraph from "../shared/Paragraph.astro";
import Title from "../shared/Title.astro";
import { services } from "../../utils/data.ts";


type ServicesProps = {
    week:string;
    title: string;
    description: string;
    icon: string
};


---

<section id="services">
    <Container className="space-y-10 md:sapce-y-12">
        <div class="text-center max-w-3xl mx-auto space-y-4">
            <Title>
                <span class="text-transparent sm:text-4xl bg-clip-text bg-gradient-to-br from-indigo-600 from-20% via-primary via-30% to-green-600">What you will learn in 6 weeks</span>
            </Title>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
            {
                    services.map((service: ServicesProps) => {
                    return (
                            <Service title= {service.title} description={service.description} icon={service.icon} week= {service.week}>
                            </Service>
                            );
                    })
            }
        </div>
    </Container>
</section>