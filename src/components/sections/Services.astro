---
import Service from "../cards/Service.astro";
import Container from "../shared/Container.astro";
import Title from "../shared/Title.astro";
import { services } from "../../utils/data.ts";

type ServicesProps = {
  week: string;
  title: string;
  description: string;
  icon: string;
  href: string;
};
---

<section id="services">
  <Container className="space-y-10 md:space-y-12">
    <div class="text-center max-w-full mx-auto space-y-4">
      <Title>
        <span
          class="text-transparent bg-clip-text bg-gradient-to-br from-indigo-600 from-20% via-primary via-30% to-green-600"
          >What you will learn in 6 weeks</span
        >
      </Title>
      <p class="dark:text-white">
        You will gain hands-on experience with Microsoft 365, build practical
        skills in Exchange Online, SharePoint, OneDrive, Entra ID, Power
        Platform, and Microsoft Defender. You will also learn how administrators
        manage users, security, collaboration, and cloud services in real-world
        environments, and develop a strong foundation for career growth and
        future Microsoft certifications. View each week for more details.
      </p>
    </div>
    <div
      class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8"
      
    >
      {
        services.map((service: ServicesProps) => {
          return (
            <Service
              title={service.title}
              description={service.description}
              icon={service.icon}
              week={service.week}
              href={service.href}
            />
          );
        })
      }
    </div>
  </Container>
</section>
