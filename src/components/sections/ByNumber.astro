---
import Container from "../shared/Container.astro";
import { BadgeDollarSign, ClipboardPenLine,ShieldCheck } from "lucide-astro";
---

<section class="relative mt-12 md:mt-16">
  <Container>
    <div
      class="mx-auto lg:mx-0 p-5 sm:p-6 py-6 sm:py-8 max-w-full rounded-3xl bg-box-bg border-8 bg-gradient border-blue-500 shadow-lg shadow-box-shadow md:divide-x divide-box-border grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-8 md:gap-6 lg:gap-12"
    >
      <div class="text-center space-y-1">
        <h2
          class="font-semibold animate-bounce [animation-duration:1s] [animation-iteration-count:infinite] text-xl sm:text-2xl md:text-4xl text-heading-1"
        >
          $50
        </h2>
        <p class="mt-2 text-heading-3">Enrollment Fee</p>
        <a
          onclick="e.preventdefault()"
          class="open-modal-btn bg-emerald-600 hover:bg-emerald-700 inline-flex items-center md:gap-1 text-white transition-all duration-300 hover:scale-105 shadow-lg hover:shadow-xl text-sm lg:text-md px-2 md:px-4 py-1 rounded-full group"
        >
          Register Now
          <span class="transition group-hover:translate-x-1">
            <BadgeDollarSign size={15} strokeWidth={3} />
          </span>
        </a>
      </div>

      <div class="text-center space-y-1">
        <h2
          class="font-semibold text-xl sm:text-2xl md:text-4xl text-heading-1"
        >
          6 Weeks
        </h2>
        <p class="mt-2 text-heading-3">Training Duration</p>
        <mark
          class="border bg-white p-1 rounded-full text-xs font-bold pr-2 pl-2"
        >
          15th June - 28 July, 2026</mark
        >
      </div>

      <div class="text-center space-y-1">
        <h2
          class="font-semibold text-xl sm:text-2xl md:text-4xl text-heading-1"
        >
          2
        </h2>
        <p class="mt-2 text-heading-3">Practical Labs Weekly</p>
        <mark
          class="border bg-white p-1 rounded-full text-xs font-bold pr-2 pl-2"
          >Free Sandbox account</mark
        >
      </div>

      <div class="text-center space-y-1">
        <h2
          class="font-semibold text-xl sm:text-2xl md:text-4xl text-heading-1"
        >
          12 - 2pm
        </h2>
        <p class="mt-2 text-heading-3">Saturday, Sunday (UTC+1)</p>
        <mark
          class="border bg-white p-1 rounded-full text-xs font-bold pr-2 pl-2"
          >Recorded Sessions</mark
        >
      </div>
    </div>
  </Container>
</section>
