---
import Container from "../shared/Container.astro";
---

<section class="relative mt-12 md:mt-16">
  <Container>
    <div
      class="mx-auto lg:mx-0 p-5 sm:p-6 py-6 sm:py-8 max-w-full rounded-3xl bg-box-bg border-8 bg-gradient border-blue-700 shadow-lg  shadow-box-shadow md:divide-x divide-box-border grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-8 md:gap-6 lg:gap-12"
    >
      <div class="text-center">
        <h2
          class="font-semibold text-xl sm:text-2xl md:text-4xl text-heading-1"
        >
          $50
        </h2>
        <p class="mt-2 text-heading-3">Enrollment Fee</p>
      </div>

      <div class="text-center space-y-1">
        <h2
          class="font-semibold text-xl sm:text-2xl md:text-4xl text-heading-1"
        >
          6 Weeks
        </h2>
        <p class="mt-2 text-heading-3">Training Duration</p>
            <mark class="bg-yellow-500 text-white p-0.5 rounded text-xs font-bold pr-1 pl-1"> Starts on 1st June - 14 July, 2026</mark>
      </div>

      <div class="text-center">
        <h2
          class="font-semibold text-xl sm:text-2xl md:text-4xl text-heading-1"
        >
          3
        </h2>
        <p class="mt-2 text-heading-3">Practical Labs Weekly</p>
        <mark class="bg-yellow-500 text-white p-0.5 rounded text-xs font-bold pr-1 pl-1">With a free Sandbox account</mark>
      </div>

      <div class="text-center">
        <h2 class="font-semibold text-xl sm:text-2xl md:text-4xl text-heading-1">
          9-11 am
        </h2>
      <p class="mt-2 text-heading-3">Monday, Wednesday, Friday (WAT)</p>
          
      
      </div>
    </div>
  </Container>
</section>
