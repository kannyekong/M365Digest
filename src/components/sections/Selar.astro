---
const selarLink = "https://selar.co/m365bootcamp";
import { ShieldCheck, HandCoins, Handshake } from "lucide-astro";
---

<!-- Selar Modal --><!-- Modal -->
<div
  id="modal"
  class="fixed inset-0 z-50 hidden items-center justify-center bg-black/70 p-4 backdrop-blur-sm"
>
  <!-- Card -->
  <div
    class="relative w-full max-w-[450px] overflow-hidden rounded-3xl bg-white shadow-2xl dark:bg-gray-900 dark:border dark:border-yellow-500"
  >
    <!-- Close -->
    <button
      id="close-modal"
      class="absolute right-4 top-4 z-50 flex h-10 w-10 items-center justify-center rounded-full bg-gray-100 text-2xl transition hover:rotate-90 dark:bg-gray-800 dark:text-white"
    >
      ×
    </button>

    <!-- Content -->
    <div class="relative p-8 md:p-10">
      <!-- Heading -->
      <div class="text-center">
        <h2 class="text-3xl font-bold text-gray-800 dark:text-white">
          Registration Portal
        </h2>

        <p class="mt-3 text-gray-600 dark:text-gray-300">
          Kindly proceed to register. After registration, You will be redirected
          automatically to <span class="font-bold text-yellow-500">Selar</span> to
          complete your payment.<br />
        </p>
      </div>

      <!-- Pricing -->
      <div
        class="mt-8 rounded-3xl bg-gradient-to-r from-primary to-indigo-600 p-6 text-center text-white shadow-xl"
      >
        <p class="text-sm uppercase tracking-widest opacity-80">Bootcamp Fee</p>

        <h3 class="mt-2 text-4xl font-bold">$50</h3>
      </div>

      <!-- Features -->
      <div class="mt-8 grid gap-4 md:grid-cols-2">
        <div
          class="hover:bg-blue-200 border border-gray-200 dark:border-gray-800 rounded-2xl"
        >
          <a
            href="/terms"
            class="flex flex-row space-x-2 items-center p-4 dark:text-white"
          >
            <Handshake />
            <span>T&C</span>
          </a>
        </div>
        <div
          class="hover:bg-red-200 border border-gray-200 dark:border-gray-800 rounded-2xl"
        >
          <a
            href="/refundpolicy"
            class="flex flex-row space-x-1 items-center p-4 dark:text-white"
          >
            <HandCoins />
            <span>Refund Policy</span>
          </a>
        </div>
      </div>

      <!-- CTA -->
      <div class="grid grid-1 mt-8 justify-center space-y-2">
        <a
          href="#tally-open=gDkNGO&tally-layout=modal&tally-width=800&tally-emoji-text=👋&tally-emoji-animation=wave"
          class="rounded-full bg-primary px-8 py-4 text-md font-semibold text-white shadow-xl transition hover:scale-105"
        >
          Proceed to register
        </a>
        <div class="flex flex-row justify-center text-xs">
          <span>Payment secured by Selar </span>
          <span class="transition group-hover:translate-x-1">
            <ShieldCheck size={15} strokeWidth={3} />
          </span>
        </div>
      </div>
    </div>
  </div>
</div>
