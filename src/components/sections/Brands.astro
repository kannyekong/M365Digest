---
import Container from "../shared/Container.astro";
import Title from "../shared/Title.astro";

---

<section>
    <Container className="space-y-6 rounded-4xl p-8 border-2 border-rounded">
        <div class="text-center max-w-3xl mx-auto">
            <Title>
               <span class="text-transparent bg-clip-text bg-gradient-to-br from-indigo-600 from-20% via-primary via-30% to-green-600">Global Companies that may need your services</span>
            </Title>
        </div>
        <div class="flex justify-center flex-wrap gap-4 mt-12">
            <div class="p-4 sm:p-5 rounded-xl bg-body border border-box-border group">
                <img src="/logos/UPWK_BIG.png" width="500" height="500" alt="tgi" class="h-24 sm:h-10 w-auto">
            </div>
            <div class="p-4 sm:p-5 rounded-xl bg-body border border-box-border group">
                <img src="/logos/FVRR_BIG.png" width="100" height="60" alt="paypal" class="h-7 sm:h-10">
            </div>
            <div class="p-4 sm:p-5 rounded-xl bg-body border border-box-border group">
                <img src="/logos/MSFT_BIG.png" width="500" height="500" alt="tgi" class="h-24 sm:h-10 w-auto">
            </div>
            <div class="p-4 sm:p-5 rounded-xl bg-body border border-box-border group">
                <img src="/logos/ACN_BIG.png" width="100" height="60" alt="paypal" class="h-7 sm:h-10">
            </div>
            <div class="p-4 sm:p-5 rounded-xl bg-body border border-box-border group">
                <img src="/logos/AMZN_BIG.png" width="100" height="60" alt="spotify" class="h-7 sm:h-10 w-auto">
            </div>
            <div class="p-4 sm:p-5 rounded-xl bg-body border border-box-border group">
                <img src="/logos/GS_BIG.png" width="100" height="60" alt="slack" class="h-7 sm:h-10 w-auto">
            </div>
        </div>
    </Container>
</section>