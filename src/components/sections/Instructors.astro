---
import Container from "../shared/Container.astro";
import Title from "../shared/Title.astro";
import { ChevronLeft, ChevronRight, Linkedin, BadgeCheck, Github, Mail, PhoneCall } from "lucide-astro";
import { listActiveInstructors } from "../../lib/academy_instructors";

const instructors = await listActiveInstructors();
---

<section
  id="instructors"
  class="relative overflow-hidden"
>
  <Container className="relative z-10">

    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto">

      <Title>
        <span
          class="bg-gradient-to-r from-indigo-600 via-primary to-green-600 bg-clip-text text-transparent"
        >
          About your Instructors
        </span>
      </Title>

    </div>

    <!-- Carousel -->
    <div class="relative mt-4 md:mt-12">

      <!-- Slides -->
      <div
        id="instructor-carousel"
        class="relative overflow-hidden"
      >

        {
          instructors.map((instructor, index) => (

            <div
              class={`instructor-slide ${
                index === 0 ? "flex" : "hidden"
              } flex-col space-y-4 md:space-y-0 lg:flex-row items-center`}
            >

              <!-- Image Side -->
              <div class="relative flex-1">
                <div
                  class="
                    relative
                    overflow-hidden

                  "
                >

                  <img
                    src={instructor.image_url}
                    alt={instructor.full_name}
                    class="
                      w-full
                      md:w-3/4
                      object-cover
                      rounded-tr-full
                      rounded-tl-full
                    "
                  />

                </div>

              </div>

              <!-- Content Side -->
              <div class="flex-1 space-y-3">

                <h3
                  class="
                    text-2xl
                    font-bold
                    text-heading-1
                    tracking-tight
                  "
                >
                  {instructor.full_name}
                </h3>

                <p
                  class="
                    mt-1
                    text-primary
                    font-medium
                    text-lg
                    tracking-tighter
                  "
                >
                  {instructor.title}
                </p>

                <p
                  class="
                    mt-4
                    md:mt-8
                    dark:text-white
                  "
                >
                  {instructor.bio}
                </p>

                <!-- Skills -->
                
                <span class="bg-pink-700 text-xs p-0.5 text-white rounded font-semibold">My Skills</span>
                <div class="flex flex-wrap gap-4">
                  {
                    instructor.skills.map((skill) => (

                      <div
                        class="
                          inline-flex
                          items-center
                          gap-1
                          md:px-2
                          md:py-1
                          text-sm
                          dark:text-white
                        "
                      >
                        <BadgeCheck
                          size={16}
                          class="text-green-500"
                        />

                        {skill}
                      </div>

                    ))
                  }

                </div>

                <!-- CTA -->
                <div class="mt-5 md:mt-10 flex items-start gap-4">
                  <a href={instructor.github} class="border rounded p-1 bg-[#181717]">
                    <Github size={20} color="#fff"/>
                </a>
                <a href={instructor.linkedin} class="border rounded p-1 bg-[#2563EB]">
                    <Linkedin size={20} color="#fff"/>
                </a>
                <a href={instructor.email} class="border rounded p-1 dark:text-white">
                    <Mail size={20}/>
                </a>
                <a href={instructor.phone} class="border rounded p-1 bg-pink-600">
                    <PhoneCall size={20} color="#fff"/>
                </a>
                </div>

              </div>

            </div>

          ))
        }

      </div>

      <!-- Controls -->
      <div
        class="
          mt-10
          flex
          items-center
          justify-center
          gap-4
        "
      >

        <button
          id="prevInstructor"
          class="
            w-14
            h-14
            rounded-full
            border
            border-white/10
            bg-white/5
            backdrop-blur-xl
            flex
            items-center
            justify-center
            hover:bg-white/10
            transition-all
            duration-250
          "
        >
          <ChevronLeft size={24} />
        </button>

        <button
          id="nextInstructor"
          class="
            w-14
            h-14
            rounded-full
            bg-primary
            text-white
            flex
            items-center
            justify-center
            hover:scale-105
            transition-all
            duration-250
            shadow-xl
          "
        >
          <ChevronRight size={24} />
        </button>

      </div> 

    </div>

  </Container>
</section>

<script>
  let currentSlide = 0;

  const slides = document.querySelectorAll(".instructor-slide");

  const showSlide = (index) => {

    slides.forEach((slide, i) => {

      slide.classList.toggle("hidden", i !== index);
      slide.classList.toggle("flex", i === index);

    });

  };

  document
    .getElementById("nextInstructor")
    ?.addEventListener("click", () => {

      currentSlide = (currentSlide + 1) % slides.length;

      showSlide(currentSlide);

    });

  document
    .getElementById("prevInstructor")
    ?.addEventListener("click", () => {

      currentSlide =
        (currentSlide - 1 + slides.length) % slides.length;

      showSlide(currentSlide);

    });

</script>
