import Title from "../shared/Title.astro";
import { ChevronLeft, ChevronRight, Linkedin, BadgeCheck, Github, X, Twitter, Mail, PhoneCall } from "lucide-astro";

const instructors = [
  {
    name: "Akaneno Ekong",
    role: "M365 Technical Support Engineer",
    image: "/images/checker.png",
    bio: "I work for Microsoft as a Technical Support Engineer with 5 years of experience. I am a seasoned Microsoft 365 administrator with years of hands-on enterprise experience managing Exchange Online, SharePoint, Teams, Entra ID, and cloud security environments for organizations globally. I specialize in simplifying complex M365 cloud technologies for beginners.",
    skills: ['Senior IT support Specialist', 'Frontend Web Developer','M365 Technical Support Engineer', "Forward Deployment Engineer", "M365 Migration Expert", "Office 365 Technical Advisor"
      
    ],
    linkedin: "https://linkedin.com/in/akanenoekong",
    twitter:"https://x.com/kannyyekong",
    github:"https://github.com/kannyekong",
    email:"mailto:ekongakaneno@gmail.com",
    phone:"tel:+2348143099128"
  },

  // {
  //   name: "Ayomide Olamilekan Adedeji",
  //   role: "Microsoft 365 Technical Support Engineer",
  //   image: "/images/ayo.png",
  //   bio: "I work for Microsoft as a Technical Support Engineer with over 4 years of experience. I help organizations modernize workplace collaboration using Microsoft Teams, SharePoint, OneDrive, and Copilot technologies while focusing on a practical real-world implementation scenarios and cloud productivity solutions.",
  //   skills: [
      
  //   ],
  //   linkedin: "#",
  // },
];
---

<section
  id="instructors"
  class="relative overflow-hidden"
>
  <!-- Background Effects
  <div class="absolute top-0 left-0 w-80 h-80 bg-cyan-400/10 blur-3xl rounded-full"></div>
  <div class="absolute bottom-0 right-0 w-96 h-96 bg-green-400/10 blur-3xl rounded-full"></div> -->

  <Container className="relative z-10">

    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto">

      <Title>
        <span
          class="bg-gradient-to-r from-indigo-600 via-primary to-green-600 bg-clip-text text-transparent"
        >
          About your Instructor
        </span>
      </Title>

    </div>

    <!-- Carousel -->
    <div class="relative mt-4 md:mt-12">

      <!-- Slides -->
      <div
        id="instructor-carousel"
        class="relative overflow-hidden"
      >

        {
          instructors.map((instructor, index) => (

            <div
              class={`instructor-slide ${
                index === 0 ? "flex" : "hidden"
              } flex-col space-y-4 md:space-y-0 lg:flex-row items-center`}
            >

              <!-- Image Side -->
              <div class="relative flex-1">

                

                <div
                  class="
                    relative
                    overflow-hidden

                  "
                >

                  <img
                    src={instructor.image}
                    alt={instructor.name}
                    class="
                      w-full
                      md:w-3/4
                      object-cover
                      rounded-tr-full
                      rounded-tl-full
                    "
                  />

                </div>

              </div>

              <!-- Content Side -->
              <div class="flex-1">

                <h3
                  class="
                    text-2xl
                    font-bold
                    text-heading-1
                    tracking-tight
                  "
                >
                  {instructor.name}
                </h3>

                <p
                  class="
                    mt-1
                    text-primary
                    font-medium
                    text-lg
                    tracking-tighter
                  "
                >
                  {instructor.role}
                </p>

                <p
                  class="
                    mt-4
                    md:mt-8
                  "
                >
                  {instructor.bio}
                </p>

                <!-- Skills -->
                <div class="mt-4 md:mt-8 flex flex-wrap gap-4">

                  {
                    instructor.skills.map((skill) => (

                      <div
                        class="
                          inline-flex
                          items-center
                          gap-1
                          md:px-4
                          md:py-2
                          text-sm
                        "
                      >
                        <BadgeCheck
                          size={16}
                          class="text-green-500"
                        />

                        {skill}
                      </div>

                    ))
                  }

                </div>

                <!-- CTA -->
                <div class="mt-5 md:mt-10 flex items-start gap-4">
                  <a href={instructor.github} class="border rounded p-1 bg-[#181717]">
                    <Github size={30} color="#fff"/>
                </a>
                <a href={instructor.linkedin} class="border rounded p-1 bg-[#2563EB]">
                    <Linkedin size={30} color="#fff"/>
                </a>
                <a href={instructor.email} class="border rounded p-1">
                    <Mail size={30}/>
                </a>
                <a href={instructor.phone} class="border rounded p-1 bg-pink-600">
                    <PhoneCall size={30} color="#fff"/>
                </a>
                </div>

              </div>

            </div>

          ))
        }

      </div>

      <!-- Controls -->
      <!-- <div
        class="
          mt-10
          flex
          items-center
          justify-center
          gap-4
        "
      >

        <button
          id="prevInstructor"
          class="
            w-14
            h-14
            rounded-full
            border
            border-white/10
            bg-white/5
            backdrop-blur-xl
            flex
            items-center
            justify-center
            hover:bg-white/10
            transition-all
            duration-300
          "
        >
          <ChevronLeft size={24} />
        </button>

        <button
          id="nextInstructor"
          class="
            w-14
            h-14
            rounded-full
            bg-primary
            text-white
            flex
            items-center
            justify-center
            hover:scale-105
            transition-all
            duration-300
            shadow-xl
          "
        >
          <ChevronRight size={24} />
        </button>

      </div> -->

    </div>

  </Container>
</section>

<script>
  let currentSlide = 0;

  const slides = document.querySelectorAll(".instructor-slide");

  const showSlide = (index) => {

    slides.forEach((slide, i) => {

      slide.classList.toggle("hidden", i !== index);
      slide.classList.toggle("flex", i === index);

    });

  };

  document
    .getElementById("nextInstructor")
    ?.addEventListener("click", () => {

      currentSlide = (currentSlide + 1) % slides.length;

      showSlide(currentSlide);

    });

  document
    .getElementById("prevInstructor")
    ?.addEventListener("click", () => {

      currentSlide =
        (currentSlide - 1 + slides.length) % slides.length;

      showSlide(currentSlide);

    });

</script>
