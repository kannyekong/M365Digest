---
import { Picture } from "astro:assets";
import { Check, Image, Users, Wallpaper } from "lucide-astro";
import {
  Presentation,
  FlaskConical,
  BriefcaseBusiness,
  ArrowRight,
  BookOpen,
  Laptop,
  BarChart3,
  Award,
  GraduationCap,
  BadgeCheck,
  Play,
} from "lucide-react";

import { getPublishedAcademyPrograms } from "../../lib/academy";
import type { AcademyProgram } from "../../types/academy";

interface Props {
  videoUrl?: string;
}

// Fetch published Academy programs from the existing Supabase service.
const programRecords = await getPublishedAcademyPrograms();

// Ensure the pricing calculation receives a valid array of programs.
const programs: AcademyProgram[] = Array.isArray(programRecords)
  ? programRecords.filter((program): program is AcademyProgram =>
      Boolean(program)
    )
  : [];

// Keep only programs that are configured to display a valid price.
const pricedPrograms = programs.filter((program) => {
  const amount = program.discount_price ?? program.price;

  return program.show_price && Number.isFinite(amount) && amount >= 0;
});

// Find the lowest available published program price, accounting for discounts.
const lowestProgramPrice =
  pricedPrograms.length > 0
    ? Math.min(
        ...pricedPrograms.map(
          (program) => program.discount_price ?? program.price
        )
      )
    : null;

// Match the currency to the program supplying the lowest price.
const lowestProgramCurrency =
  pricedPrograms.find(
    (program) =>
      (program.discount_price ?? program.price) === lowestProgramPrice
  )?.currency || "NGN";

/**
 * Format the lowest published program price using its configured currency.
 */
function formatPricingAmount(
  amount: number | null,
  currency: string = "NGN"
): string {
  if (amount === null) {
    return "Contact us";
  }

  try {
    return new Intl.NumberFormat("en-US", {
      style: "currency",
      currency,
      maximumFractionDigits: 0,
    }).format(amount);
  } catch {
    return `${currency} ${amount.toLocaleString("en-US")}`;
  }
}
