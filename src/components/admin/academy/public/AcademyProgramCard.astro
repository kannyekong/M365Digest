---
import {
  ArrowRight,
  Award,
  CalendarDays,
  Clock3,
  GraduationCap,
  Laptop,
  MapPin,
  Users,
} from "lucide-astro";
import type { AcademyProgram } from "../../../../types/academy";

interface Props {
  program: AcademyProgram;
}

const { program } = Astro.props;

const programImage =
  program.thumbnail_image_url ||
  program.hero_image_url ||
  program.banner_image_url;

/**
 * Convert an underscore-separated database value into a readable label.
 */
function formatEnumLabel(value: string) {
  return value
    .split("_")
    .map((word) => {
      return word.charAt(0).toUpperCase() + word.slice(1);
    })
    .join(" ");
}

/**
 * Format the program duration.
 */
function formatDuration() {
  if (!program.duration_value || !program.duration_unit) {
    return "Flexible duration";
  }

  const durationUnit =
    program.duration_value === 1
      ? program.duration_unit.replace(/s$/, "")
      : program.duration_unit;

  return `${program.duration_value} ${durationUnit}`;
}

/**
 * Format a program date for public display.
 */
function formatDate(value: string | null) {
  if (!value) {
    return null;
  }

  const date = new Date(value);

  if (Number.isNaN(date.getTime())) {
    return null;
  }

  return new Intl.DateTimeFormat("en-US", {
    day: "numeric",
    month: "short",
    year: "numeric",
  }).format(date);
}

/**
 * Format the displayed program price.
 */
function formatPrice() {
  if (!program.show_price) {
    return "Contact us";
  }

  const amount = program.discount_price ?? program.price;

  try {
    return new Intl.NumberFormat("en-US", {
      style: "currency",
      currency: program.currency,
      maximumFractionDigits: 0,
    }).format(amount);
  } catch {
    return `${program.currency} ${amount.toLocaleString("en-US")}`;
  }
}

const formattedStartDate = formatDate(program.start_date);
const programPrice = formatPrice();
---

<article
  class="group flex h-full flex-col overflow-hidden rounded-3xl border border-box-border bg-box-bg shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-xl"
>
  <div class="relative h-56 overflow-hidden bg-gray-100 dark:bg-gray-900">
    {
      programImage ? (
        <img
          src={programImage}
          alt={`${program.title} cover`}
          width="1200"
          height="675"
          loading="lazy"
          class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
        />
      ) : (
        <div class="flex h-full items-center justify-center bg-gradient-to-br from-blue-50 via-indigo-50 to-purple-50 dark:from-blue-950/30 dark:via-indigo-950/30 dark:to-purple-950/30">
          <GraduationCap size={54} class="text-primary/60" />
        </div>
      )
    }

    <div
      class="absolute inset-x-0 top-0 flex items-start justify-between gap-3 p-4"
    >
      <span
        class="rounded-full border border-white/50 bg-white/90 px-3 py-1.5 text-xs font-semibold text-gray-800 shadow-sm backdrop-blur-md"
      >
        {program.category?.name ?? "Academy Program"}
      </span>

      {
        program.featured ? (
          <span class="rounded-full bg-amber-400 px-3 py-1.5 text-xs font-bold text-amber-950 shadow-sm">
            Featured
          </span>
        ) : null
      }
    </div>

    <div class="absolute inset-x-0 bottom-0 p-4">
      <span
        class:list={[
          "inline-flex items-center rounded-full px-3 py-1.5 text-xs font-semibold shadow-sm backdrop-blur-md",
          program.registration_open
            ? "bg-emerald-500/95 text-white"
            : "bg-red-500/95 text-white",
        ]}
      >
        {
          program.registration_open
            ? "Registration Open"
            : "Registration Closed"
        }
      </span>
    </div>
  </div>

  <div class="flex flex-1 flex-col p-6">
    <div class="flex-1">
      {
        program.code ? (
          <p class="text-xs font-semibold uppercase tracking-[0.16em] text-primary">
            {program.code}
          </p>
        ) : null
      }

      <h2
        class="mt-2 text-xl font-bold leading-8 text-heading-1 transition group-hover:text-primary"
      >
        <a href={`/academy/${program.slug}`}>
          {program.title}
        </a>
      </h2>

      <p class="mt-3 line-clamp-3 text-sm leading-6 text-heading-3">
        {
          program.short_description ||
            "Explore practical, instructor-led training designed to help you build real-world technical skills."
        }
      </p>

      <div class="mt-5 grid grid-cols-2 gap-3">
        <div class="flex items-center gap-2 text-sm text-heading-3">
          <Clock3 size={16} class="shrink-0 text-primary" />

          <span class="truncate">
            {formatDuration()}
          </span>
        </div>

        <div class="flex items-center gap-2 text-sm text-heading-3">
          <Laptop size={16} class="shrink-0 text-primary" />

          <span class="truncate">
            {formatEnumLabel(program.delivery_mode)}
          </span>
        </div>

        {
          formattedStartDate ? (
            <div class="flex items-center gap-2 text-sm text-heading-3">
              <CalendarDays size={16} class="shrink-0 text-primary" />

              <span class="truncate">{formattedStartDate}</span>
            </div>
          ) : (
            <div class="flex items-center gap-2 text-sm text-heading-3">
              <CalendarDays size={16} class="shrink-0 text-primary" />

              <span class="truncate">Date coming soon</span>
            </div>
          )
        }

        {
          program.maximum_students ? (
            <div class="flex items-center gap-2 text-sm text-heading-3">
              <Users size={16} class="shrink-0 text-primary" />

              <span class="truncate">{program.maximum_students} seats</span>
            </div>
          ) : program.location ? (
            <div class="flex items-center gap-2 text-sm text-heading-3">
              <MapPin size={16} class="shrink-0 text-primary" />

              <span class="truncate">{program.location}</span>
            </div>
          ) : (
            <div class="flex items-center gap-2 text-sm text-heading-3">
              <Award size={16} class="shrink-0 text-primary" />

              <span class="truncate">Certificate available</span>
            </div>
          )
        }
      </div>

      {
        program.tools_covered.length > 0 ? (
          <div class="mt-5 flex flex-wrap gap-2">
            {program.tools_covered.slice(0, 4).map((tool) => (
              <span class="rounded-full border border-box-border bg-body px-2.5 py-1 text-xs font-medium text-heading-3">
                {tool}
              </span>
            ))}

            {program.tools_covered.length > 4 ? (
              <span class="rounded-full border border-box-border bg-body px-2.5 py-1 text-xs font-medium text-heading-3">
                +{program.tools_covered.length - 4} more
              </span>
            ) : null}
          </div>
        ) : null
      }
    </div>

    <div
      class="mt-6 flex items-end justify-between gap-4 border-t border-box-border pt-5"
    >
      <div>
        <p class="text-xs font-medium uppercase tracking-wide text-heading-3">
          Program fee
        </p>

        <div class="mt-1 flex flex-wrap items-center gap-2">
          <p class="text-xl font-extrabold text-heading-1">
            {programPrice}
          </p>

          {
            program.show_price &&
            program.discount_price !== null &&
            program.discount_price < program.price ? (
              <span class="text-sm font-medium text-heading-3 line-through">
                {new Intl.NumberFormat("en-US", {
                  style: "currency",
                  currency: program.currency,
                  maximumFractionDigits: 0,
                }).format(program.price)}
              </span>
            ) : null
          }
        </div>
      </div>

      <a
        href={`/academy/${program.slug}`}
        aria-label={`View details for ${program.title}`}
        class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-primary text-white transition duration-300 group-hover:translate-x-1 group-hover:shadow-lg"
      >
        <ArrowRight size={19} />
      </a>
    </div>
  </div>
</article>
