---
import LogoutButton from "../../islands/LogoutButton";
import {
  LayoutDashboard,
  Newspaper,
  GraduationCap,
  Briefcase,
  Users,
  MessageSquare,
  Settings,
} from "lucide-react";

const sections = [
  {
    title: "Dashboard",
    href: "/admin/blog",
    icon: LayoutDashboard,
  },
  {
    title: "Blog content",
    icon: Newspaper,
    links: [
      {
        title: "All articles",
        href: "/admin/blog/articles",
      },
      {
        title: "Add a new article",
        href: "/admin/blog/new",
      },
    ],
  },

  {
    title: "Company info",
    icon: Briefcase,
    links: [
      {
        title: " All services",
        href: "/admin/services",
      },

      {
        title: "Add a new service",
        href: "/admin/services/new",
      },
      {
        title: "All testimonials",
        href: "/admin/testimonials",
      },
      {
        title: "Add a new testimonial",
        href: "/admin/testimonials/new",
      },
    ],
  },
  {
    title: "Manage staff",
    icon: Users,
    links: [
      {
        title: "Overview",
        href: "/admin/staff",
      },
      {
        title: "Manage Staff",
        href: "/admin/staff/manage",
      },
    ],
  },
  {
    title: "Manage students",
    icon: Users,
    links: [
      {
        title: "Overview",
        href: "/admin/students",
      },
      {
        title: "Manage Students",
        href: "/admin/students/manage",
      },
      {
        title: "Generate Certificate",
        href: "/admin/students/manage/certificate",
      },
    ],
  },

  {
    title: "Bootcamp settings",
    icon: GraduationCap,
    links: [
      {
        title: "All instructors",
        href: "/admin/bootcamp/instructors",
      },
      {
        title: "Add instructors",
        href: "/admin/bootcamp/instructors/new",
      },
    ],
  },

  {
    title: "Form submissions",
    icon: MessageSquare,
    links: [
      {
        title: "Contact",
        href: "/admin/forms/contact",
      },
      {
        title: "Bootcamp",
        href: "/admin/forms/bootcamp",
      },
      {
        title: "Quote",
        href: "/admin/forms/quote",
      },
      {
        title: "Reviews",
        href: "/admin/forms/reviews",
      },
    ],
  },

  {
    title: "Account settings",
    icon: Settings,
    links: [
      {
        title: "Change password",
        href: "/admin/profile/",
      },
      {
        title: "Update profile picture",
        href: "/admin/profile",
      },
    ],
  },
];
---

<aside class="sticky top-0 h-screen w-72 bg-[#000033] text-white flex flex-col">
  <div class="p-8">
    <img src="/logos/logonew-white.png" alt="logo" class="w-3/4" />
  </div>

  <nav class="px-4 flex-1 overflow-y-auto hide-scrollbar">
    {
      sections.map((section) =>
        section.links ? (
          <details class="group mb-2">
            <summary class="flex cursor-pointer items-center justify-between rounded-xl px-4 py-3 hover:bg-slate-800 transition list-none">
              <div class="flex items-center gap-4">
                <section.icon size={20} />

                <span>{section.title}</span>
              </div>

              <svg
                class="h-4 w-4 transition-transform group-open:rotate-90"
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 5l7 7-7 7"
                />
              </svg>
            </summary>

            <div class="ml-10 mt-2 space-y-1 border border-slate-200 rounded-lg">
              {section.links.map((link) => (
                <a
                  href={link.href}
                  class="block rounded-lg px-3 py-2 text-sm text-slate-200 hover:mr-1 hover:m-0.5 hover:bg-slate-800 hover:text-white transition"
                >
                  {link.title}
                </a>
              ))}
            </div>
          </details>
        ) : (
          <a
            href={section.href}
            class="flex items-center gap-4 rounded-xl px-4 py-3 mb-2 hover:bg-slate-800 transition"
          >
            <section.icon size={20} />

            {section.title}
          </a>
        )
      )
    }
  </nav>
  <div class="mt-auto px-4 pb-8">
    <LogoutButton client:load />
  </div>
</aside>
