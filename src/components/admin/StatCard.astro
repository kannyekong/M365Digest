---
interface Props {
  title: string;
  value: number | string;
  icon: "articles" | "published" | "drafts" | "views";
  color?: string;
}

const { title, value, icon, color = "bg-blue-500" } = Astro.props;
import { FileText, CheckCircle, FileClock, Eye } from "lucide-astro";
---

<div
  class="rounded-2xl bg-white p-6 shadow-lg border border-slate-200 hover:-translate-y-1 transition duration-300"
>
  <div class="flex justify-between items-start">
    <div>
      <p class="text-slate-500 text-sm">
        {title}
      </p>

      <h2 class="mt-3 text-4xl font-bold">
        {value}
      </h2>
    </div>

    <div
      class={`${color} w-8 h-8 rounded-xl flex items-center justify-center text-white`}
    >
      {icon === "articles" && <FileText class="w-4 h-4" />}

      {icon === "published" && <CheckCircle class="w-4 h-4" />}

      {icon === "drafts" && <FileClock class="w-4 h-4" />}

      {icon === "views" && <Eye class="w-4 h-4" />}
    </div>
  </div>
</div>
