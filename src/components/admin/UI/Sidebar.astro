const currentPath = Astro.url.pathname;
---

<aside class="sticky top-0 flex h-screen w-62 flex-col dark:bg-black">
  <a
    href="/admin"
    class="border-b border-r border-slate-100 p-6 dark:border-slate-800"
  >
    <img
      src="/logos/cloudtweaklogo.png"
      alt="CloudTweak"
      class="w-3/4 object-contain dark:hidden"
    />

    <img
      src="/logos/cloudtweakwhite.png"
      alt="CloudTweak"
      class="hidden w-3/4 object-contain dark:block"
    />
  </a>

  <nav
    class="flex-1 overflow-y-auto border-r border-slate-100 px-4 dark:border-slate-800"
  >
    <AdminSidebarNavigation
      sections={sections}
      currentPath={currentPath}
      client:load
    />
  </nav>

  <div class="mt-auto px-6 py-3 pb-8 text-red-500">
    <LogoutButton client:load />
  </div>
</aside>
