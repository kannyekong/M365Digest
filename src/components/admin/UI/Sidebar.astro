---
import {
  Construction,
  ContactRound,
  MessageSquareQuote,
  UserPen,
  LayoutDashboard,
  Newspaper,
  GraduationCap,
  BriefcaseBusiness,
  MailOpen,
  Workflow,
  Settings,
  FolderOpenDot,
  Columns2,
} from "lucide-astro";
import LogoutButton from "../../../islands/LogoutButton";

const sections = [
  {
    title: "Dashboard Overview",
    href: "/admin/",
    icon: LayoutDashboard,
  },

  {
    title: "My To-Dos",
    icon: Workflow,
    links: [
      {
        title: "Manage to-do",
        href: "/admin/tasks/",
      },
      {
        title: "Add a new to-do",
        href: "/admin/tasks/add",
      },
    ],
  },

  {
    title: "Manage Hero",
    icon: Columns2,
    links: [
      {
        title: "Manage banner",
        href: "/admin/tasks/",
      },
      {
        title: "Manage company values",
        href: "/admin/tasks/add",
      },
      {
        title: "Manage founders",
        href: "/admin/tasks/add",
      },
      {
        title: "Manage services",
        href: "/admin/tasks/add",
      },
    ],
  },

  {
    title: "Projects",
    icon: Construction,
    links: [
      {
        title: "Add Projects",
        href: "/admin/tasks/",
      },
      {
        title: "Manage Projects",
        href: "/admin/tasks/add",
      },
    ],
  },

  {
    title: "Blog articles",
    icon: Newspaper,
    links: [
      {
        title: "All articles",
        href: "/admin/blog/articles",
      },
      {
        title: "Add a new article",
        href: "/admin/blog/new",
      },
    ],
  },

  {
    title: "Services",
    icon: BriefcaseBusiness,
    links: [
      {
        title: " All services",
        href: "/admin/services",
      },

      {
        title: "Add a new service",
        href: "/admin/services/new",
      },
    ],
  },

  {
    title: "Testimonials",
    icon: MessageSquareQuote,
    links: [
      {
        title: "All testimonials",
        href: "/admin/testimonials",
      },
      {
        title: "Add a new testimonial",
        href: "/admin/testimonials/new",
      },
    ],
  },

  {
    title: "Manage staff",
    icon: UserPen,
    links: [
      {
        title: "Manage Staff",
        href: "/admin/staff/",
      },
      {
        title: "Add a new staff",
        href: "/admin/staff/new",
      },
    ],
  },
  {
    title: "Manage students",
    icon: UserPen,
    links: [
      {
        title: "Manage Students",
        href: "/admin/forms/registrations",
      },
      {
        title: "Generate Certificate",
        href: "/admin/students/manage/certificate",
      },
    ],
  },

  {
    title: "Bootcamp settings",
    icon: GraduationCap,
    links: [
      {
        title: "Bootcamp overview",
        href: "/admin/bootcamp/bootcamp",
      },
      {
        title: "Add bootcamp",
        href: "/admin/bootcamp/bootcamp",
      },
      {
        title: "All instructors",
        href: "/admin/bootcamp/instructors",
      },
      {
        title: "Add a new instructor",
        href: "/admin/bootcamp/instructors/new",
      },
    ],
  },

  {
    title: "Form submissions",
    icon: MailOpen,
    links: [
      {
        title: "Contact",
        href: "/admin/forms/contact",
      },
      {
        title: "Registrations",
        href: "/admin/forms/registrations",
      },
      {
        title: "Quote",
        href: "/admin/forms/quotes",
      },
      {
        title: "Reviews",
        href: "/admin/forms/review",
      },
    ],
  },
  {
    title: "Careers",
    icon: ContactRound,
    links: [
      {
        title: "Add a job",
        href: "/admin/careers/new",
      },
      {
        title: "All job openings",
        href: "/admin/careers",
      },

      {
        title: "Career applications",
        href: "/admin/careers/applications",
      },
    ],
  },

  {
    title: "Document Library",
    links: [
      {
        title: "All documents",
        href: "/admin/documents",
      },
      {
        title: "Upload a new document",
        href: "/admin/documents/add",
      },
    ],
    icon: FolderOpenDot,
  },

  {
    title: "Account settings",
    icon: Settings,
    links: [
      {
        title: "Change password",
        href: "/admin/profile/profile",
      },
      {
        title: "Update profile picture",
        href: "/admin/profile/profile",
      },
      {
        title: "Notification settings",
        href: "/admin/notifications/",
      },
    ],
  },
];
---

<aside class="sticky top-0 h-screen w-62 flex flex-col">
  <div class="p-6 border-b border-slate-100 border-r">
    <img src="/logos/cloudtweaklogo.png" alt="logo" class="w-full" />
  </div>

  <nav
    class="px-4 flex-1 overflow-y-auto border-r border-slate-100 dark:border-slate-50"
  >
    {
      sections.map((section) =>
        section.links ? (
          <details class="group">
            <summary class="flex cursor-pointer items-center justify-between rounded-xl px-3 py-2 dark:text-white hover:bg-slate-100 dark:hover:bg-slate-800 transition list-none">
              <div class="flex items-center gap-4">
                <section.icon size={18} />
                <span class="text-xs">{section.title}</span>
              </div>

              <svg
                class="h-4 w-4 transition-transform group-open:rotate-90"
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 5l7 7-7 7"
                />
              </svg>
            </summary>

            <div class="ml-10 mt-2  border rounded-md">
              {section.links.map((link) => (
                <a
                  href={link.href}
                  class="block rounded-lg px-2 py-2 text-xs text-black dark:text-slate-200 hover:mr-1  hover:text-orange-500"
                >
                  {link.title}
                </a>
              ))}
            </div>
          </details>
        ) : (
          <a
            href={section.href}
            class="flex items-center gap-4 rounded-xl px-3 text-xs py-2 dark:text-white hover:bg-slate-100 dark:hover:bg-slate-800 transition"
          >
            <section.icon size={18} />

            {section.title}
          </a>
        )
      )
    }
  </nav>
  <div class="mt-auto px-4 pb-8 text-black dark:text-white">
    <LogoutButton client:load />
  </div>
</aside>
