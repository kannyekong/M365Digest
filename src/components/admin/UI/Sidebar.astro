      src="/logos/cloudtweaklogo.png"
      alt="CloudTweak"
      class="w-3/4 object-contain dark:hidden"
    />

    <img
      src="/logos/cloudtweakwhite.png"
      alt="CloudTweak"
      class="hidden w-3/4 object-contain dark:block"
    />
  </a>

  <nav
    class="flex-1 overflow-y-auto border-r border-slate-100 px-4 dark:border-slate-800"
  >
    {
      sections.map((section) =>
        section.links ? (
          <details class="group" open={isSectionActive(section.links)}>
            <summary
              class:list={[
                "flex cursor-pointer list-none items-center justify-between rounded-xl px-3 py-2 transition",
                isSectionActive(section.links)
                  ? "bg-sky-100 text-sky-700 dark:bg-sky-950/60 dark:text-sky-300"
                  : "text-slate-800 hover:bg-slate-100 dark:text-white dark:hover:bg-slate-800",
              ]}
            >
              <div class="flex min-w-0 items-center gap-4">
                <section.icon size={18} />

                <div class="flex min-w-0 items-center gap-2">
                  <span class="text-xs">{section.title}</span>

                  {section.badge && (
                    <span class="inline-flex shrink-0 items-center rounded-full bg-pink-500 px-2 py-0.5 text-[9px] font-semibold uppercase tracking-wide text-white">
                      {section.badge}
                    </span>
                  )}
                </div>
              </div>

              <svg
                class="h-4 w-4 shrink-0 transition-transform group-open:rotate-90"
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 5l7 7-7 7"
                />
              </svg>
            </summary>

            <div class="ml-10 mt-2 overflow-hidden rounded-md border border-slate-200 dark:border-slate-800">
              {section.links.map((link) => {
                const active = isActiveLink(link);

                return (
                  <a
                    href={link.href}
                    aria-current={active ? "page" : undefined}
                    class:list={[
                      "block px-4 py-2.5 text-xs transition",
                      active
                        ? "bg-sky-100 font-semibold text-sky-700 dark:bg-sky-950/60 dark:text-sky-300"
                        : "text-black hover:bg-slate-50 hover:text-orange-500 dark:text-slate-200 dark:hover:bg-slate-900",
                    ]}
                  >
                    {link.title}
                  </a>
                );
              })}
            </div>
          </details>
        ) : (
          <a
            href={section.href}
            aria-current={
              isActiveTopLevelLink(section.href) ? "page" : undefined
            }
            class:list={[
              "mt-2.5 flex items-center gap-4 rounded-xl px-3 py-2 text-xs transition",
              isActiveTopLevelLink(section.href)
                ? "bg-sky-100 font-semibold text-sky-700 dark:bg-sky-950/60 dark:text-sky-300"
                : "text-slate-800 hover:bg-slate-100 dark:text-white dark:hover:bg-slate-800",
            ]}
          >
            <section.icon size={18} />

            {section.title}
          </a>
        )
      )
    }
