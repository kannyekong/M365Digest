---

<aside class="sticky top-0 h-screen w-62 flex flex-col dark:bg-black">
  <a
    href="/admin"
    class="p-6 border-b border-slate-100 border-r dark:border-slate-100"
  >
    <img
      src="/logos/cloudtweaklogo.png"
      alt="logo"
      class="dark:hidden w-3/4 object-contain"
      alt="CloudTweak"
    />

    <img
      src="/logos/cloudtweakwhite.png"
      class="hidden dark:block w-3/4 object-contain"
      alt="CloudTweak"
    />
  </a>

  <nav
    class="px-4 flex-1 overflow-y-auto border-r border-slate-100 dark:border-none"
  >
    {
      sections.map((section) =>
        section.links ? (
          <details class="group">
            <summary class="flex cursor-pointer items-center justify-between rounded-xl px-3 py-2 dark:text-white hover:bg-slate-100 dark:hover:bg-slate-800 transition list-none">
              <div class="flex items-center gap-4">
                <section.icon size={18} />
                <span class="text-xs">{section.title}</span>
              </div>

              <svg
                class="h-4 w-4 transition-transform group-open:rotate-90"
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 5l7 7-7 7"
                />
              </svg>
            </summary>

            <div class="ml-10 mt-2  border rounded-md">
              {section.links.map((link) => (
                <a
                  href={link.href}
                  class="block rounded-lg px-2 py-2 text-xs text-black dark:text-slate-200 hover:mr-1  hover:text-orange-500"
                >
                  {link.title}
                </a>
              ))}
            </div>
          </details>
        ) : (
          <a
            href={section.href}
            class="flex items-center gap-4 rounded-xl px-3 text-xs py-2 mt-2 dark:text-white hover:bg-slate-100 dark:hover:bg-slate-800 transition"
          >
            <section.icon size={18} />

            {section.title}
          </a>
        )
      )
    }
  </nav>
  <div class="mt-auto px-4 pb-8 text-red-500">
    <LogoutButton client:load />
  </div>
</aside>
