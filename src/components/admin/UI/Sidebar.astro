  GraduationCap,
  BriefcaseBusiness,
  Workflow,
  Settings,
  FolderOpenDot,
  Columns2,
  BadgeDollarSign,
  Sparkles,
  GalleryHorizontalEnd,
  LibraryBig,
} from "lucide-astro";
import LogoutButton from "../../../islands/LogoutButton";

const sections = [
  {
    title: "Dashboard Overview",
    href: "/admin/",
    icon: LayoutDashboard,
  },

  {
    title: "My Tasks",
    icon: Workflow,
    links: [
