/* Normalizes routes so trailing slashes do not affect active-link detection. */
function normalizePath(path: string) {
  if (path === "/") {
    return "/";
  }

  return path.replace(/\/+$/, "");
}

const currentPath = normalizePath(Astro.url.pathname);

/* Determines whether a nested navigation item should be considered the canonical active route. */
function isActiveLink(link: { href: string; activeMatch?: boolean }) {
  if (link.activeMatch === false) {
    return false;
  }

  return currentPath === normalizePath(link.href);
}

/* Determines whether a top-level navigation route is currently active. */
function isActiveTopLevelLink(href?: string) {
  if (!href) {
    return false;
  }

  return currentPath === normalizePath(href);
}

/* Determines whether any canonical child route inside a section is active. */
function isSectionActive(
  links: Array<{
    title: string;
    href: string;
    activeMatch?: boolean;
  }>
) {
  return links.some((link) => isActiveLink(link));
}
---

<aside class="sticky top-0 flex h-screen w-62 flex-col dark:bg-black">
  <a
    href="/admin"
    class="border-b border-r border-slate-100 p-6 dark:border-slate-800"
  >
