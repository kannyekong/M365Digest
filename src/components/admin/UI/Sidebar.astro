---
import LogoutButton from "../../../islands/LogoutButton";
import {
  LayoutDashboard,
  Newspaper,
  GraduationCap,
  Briefcase,
  Users,
  MailOpen,
  Workflow,
  Settings,
} from "lucide-react";

const sections = [
  {
    title: "Dashboard",
    href: "/admin/",
    icon: LayoutDashboard,
  },
  {
    title: "My To-Dos",
    icon: Workflow,
    links: [
      {
        title: "Manage to-do",
        href: "/admin/tasks/",
      },
      {
        title: "Add a new to-do",
        href: "/admin/tasks/add",
      },
    ],
  },
  {
    title: "Blog articles",
    icon: Newspaper,
    links: [
      {
        title: "All articles",
        href: "/admin/blog/articles",
      },
      {
        title: "Add a new article",
        href: "/admin/blog/new",
      },
    ],
  },

  {
    title: "Company info",
    icon: Briefcase,
    links: [
      {
        title: " All services",
        href: "/admin/services",
      },

      {
        title: "Add a new service",
        href: "/admin/services/new",
      },
      {
        title: "All testimonials",
        href: "/admin/testimonials",
      },
      {
        title: "Add a new testimonial",
        href: "/admin/testimonials/new",
      },
      {
        title: "Document Library",
        href: "/admin/documents",
      },
    ],
  },
  {
    title: "Manage staff",
    icon: Users,
    links: [
      {
        title: "Manage Staff",
        href: "/admin/staff/",
      },
      {
        title: "Add a new staff",
        href: "/admin/staff/new",
      },
    ],
  },
  {
    title: "Manage students",
    icon: Users,
    links: [
      {
        title: "Manage Students",
        href: "/admin/forms/registrations",
      },
      {
        title: "Generate Certificate",
        href: "/admin/students/manage/certificate",
      },
    ],
  },

  {
    title: "Bootcamp settings",
    icon: GraduationCap,
    links: [
      {
        title: "Bootcamp overview",
        href: "/admin/bootcamp/bootcamp",
      },
      {
        title: "Add bootcamp",
        href: "/admin/bootcamp/bootcamp",
      },
      {
        title: "All instructors",
        href: "/admin/bootcamp/instructors",
      },
      {
        title: "Add a new instructor",
        href: "/admin/bootcamp/instructors/new",
      },
    ],
  },

  {
    title: "Form submissions",
    icon: MailOpen,
    links: [
      {
        title: "Contact",
        href: "/admin/forms/contact",
      },
      {
        title: "Registrations",
        href: "/admin/forms/registrations",
      },
      {
        title: "Quote",
        href: "/admin/forms/quotes",
      },
      {
        title: "Reviews",
        href: "/admin/forms/review",
      },
    ],
  },

  {
    title: "Account settings",
    icon: Settings,
    links: [
      {
        title: "Change password",
        href: "/admin/profile/profile",
      },
      {
        title: "Update profile picture",
        href: "/admin/profile/profile",
      },
    ],
  },
];
---

<aside class="sticky top-0 h-screen w-62 bg-[#000033] text-white flex flex-col">
  <div class="p-6">
    <img src="/logos/logonew-white.png" alt="logo" class="w-3/4" />
    <!-- <div class="my-2 border-b border-slate-50"></div> -->
  </div>

  <nav class="px-4 flex-1 overflow-y-auto hide-scrollbar">
    {
      sections.map((section) =>
        section.links ? (
          <details class="group mb-2">
            <summary class="flex cursor-pointer items-center justify-between rounded-xl px-3 py-3 hover:bg-slate-800 transition list-none">
              <div class="flex items-center gap-4">
                <section.icon size={18} />
                <span class="text-xs">{section.title}</span>
              </div>

              <svg
                class="h-4 w-4 transition-transform group-open:rotate-90"
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 5l7 7-7 7"
                />
              </svg>
            </summary>

            <div class="ml-10 mt-2 space-y-1 border border-slate-200 rounded-lg">
              {section.links.map((link) => (
                <a
                  href={link.href}
                  class="block rounded-lg px-2 py-2 text-xs text-slate-200 hover:mr-1 hover:m-0.5 hover:bg-slate-800 hover:text-white transition"
                >
                  {link.title}
                </a>
              ))}
            </div>
          </details>
        ) : (
          <a
            href={section.href}
            class="flex items-center gap-4 rounded-xl px-4 text-xs py-3 mb-2 hover:bg-slate-800 transition"
          >
            <section.icon size={18} />

            {section.title}
          </a>
        )
      )
    }
  </nav>
  <div class="mt-auto px-4 pb-8">
    <LogoutButton client:load />
  </div>
</aside>
