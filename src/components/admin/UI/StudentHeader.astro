---
import StudentClockWidget from "../../../islands/student/StudentClockWidget";
import StudentNotificationBell from "../../../islands/student/StudentNotificationBell";
import UpcomingSessionWidget from "../../../islands/student/UpcomingSessionWidget";
import StudentUserMenu from "../../../islands/StudentUserMenu";
import StudentMobileNavigation from "../../../islands/student/StudentMobileNavigation";
import { ArrowLeft } from "lucide-astro";

interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  backHref?: string;
  backLabel?: string;
}

const {
  eyebrow,
  title,
  description,
  backHref,
  backLabel = "Back",
} = Astro.props;
---

<div class="sticky top-0 z-40 bg-white dark:bg-slate-950">
  <header class="border-b border-slate-200 px-5 dark:border-slate-800">
    <!-- Mobile-only global navigation: logo left, hamburger right. -->
    <StudentMobileNavigation client:load currentPath={Astro.url.pathname} />

    <div class="flex items-center justify-between gap-4 py-2">
      <section class="min-w-0">
        {
          backHref && (
            <a
              href={backHref}
              class="mb-3 inline-flex items-center gap-1 text-sm font-medium text-primary transition hover:text-slate-900 dark:text-slate-400 dark:hover:text-white"
            >
              <ArrowLeft size={16} />
              {backLabel}
            </a>
          )
        }

        {
          eyebrow && (
            <p class="mb-2 text-xs font-semibold uppercase tracking-[0.16em] text-orange-500">
              {eyebrow}
            </p>
          )
        }

        <h1
          class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white md:text-3xl"
        >
          {title}
        </h1>

        {
          description && (
            <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-500 dark:text-slate-400">
              {description}
            </p>
          )
        }
      </section>

      <div class="flex shrink-0 flex-row items-center gap-3">
        <span class="hidden md:block"
          ><UpcomingSessionWidget client:load /></span
        >
        <span class="hidden md:flex"><StudentNotificationBell client:load /></span>
        <span><StudentUserMenu client:load /></span>
      </div>
    </div>
  </header>
</div>
