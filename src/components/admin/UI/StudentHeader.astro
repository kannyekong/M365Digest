---
import StudentUserMenu from "../../../islands/StudentUserMenu";
import { ArrowLeft } from "lucide-astro";

interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  backHref?: string;
  backLabel?: string;
}

const {
  eyebrow,
  title,
  description,
  backHref,
  backLabel = "Back",
} = Astro.props;
---

<div class="sticky top-0 z-40 bg-white dark:bg-slate-950">
  <header class="border-b border-slate-200 dark:border-slate-800 px-5">
    <div class="flex items-center justify-between py-2">
      <section>
        {
          backHref && (
            <a
              href={backHref}
              class="mb-5 inline-flex items-center gap-2 text-sm font-medium text-slate-500 transition hover:text-slate-900 dark:text-slate-400 dark:hover:text-white"
            >
              <ArrowLeft size={16} />
              {backLabel}
            </a>
          )
        }

        {
          eyebrow && (
            <p class="mb-2 text-xs font-semibold uppercase tracking-[0.16em] text-orange-500">
              {eyebrow}
            </p>
          )
        }

        <h1
          class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white md:text-3xl"
        >
          {title}
        </h1>

        {
          description && (
            <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-500 dark:text-slate-400">
              {description}
            </p>
          )
        }
      </section>

      <div class="flex flex-row items-center justify-between">
        <StudentUserMenu client:load />
      </div>
    </div>
  </header>
</div>
