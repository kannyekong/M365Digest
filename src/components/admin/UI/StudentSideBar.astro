---
import LogoutButton from "../../../islands/LogoutButton";

import AnalogClockWidget from "../../../islands/student/AnalogClockWidget";

import StudentSidebarNavigation, {
  type StudentNavigationItem,
} from "../navigation/StudentSidebarNavigation";

const sections: StudentNavigationItem[] = [
  {
    title: "Dashboard Overview",
    href: "/student/dashboard",
    icon: "dashboard",
  },
  {
    title: "Explore Courses",
    icon: "allcourses",
    href: "/student/courses/allcourses",
  },
  {
    title: "My Courses",
    icon: "courses",
    href: "/student/courses",
  },

  {
    title: "Resources",
    icon: "resources",
    href: "/student/resources",
  },
  {
    title: "Live Sessions",
    icon: "live-sessions",
    href: "/student/live-sessions",
  },
  {
    title: "My Progress",
    icon: "progress",
    href: "/student/progress",
  },
  {
    title: "Certificates",
    icon: "certificates",
    href: "/student/certificate",
  },
  {
    title: "Payment History",
    icon: "receipt",
    href: "/student/payment-history",
  },
  {
    title: "Report a problem",
    icon: "support",
    href: "/student/report-problem",
  },
  {
    title: "Chat with Support",
    icon: "support",
    href: "/student/chat",
  },
  {
    title: "Account Settings",
    icon: "profile",
    href: "/student/settings",
  },
];

const currentPath = Astro.url.pathname;
---

<aside class="sticky top-0 flex h-screen w-62 flex-col dark:bg-black">
  <a
    href="/student/dashboard"
    class="border-b border-r p-4 border-slate-100 dark:border-slate-800"
  >
    <img
      src="/logos/cloudtweaklogo.png"
      alt="CloudTweak"
      class="w-3/4 items-center justify-center object-contain dark:hidden"
    />
  </a>

  <nav
    class="flex-1 overflow-y-auto border-r border-slate-100 px-4 dark:border-slate-800"
  >
    <StudentSidebarNavigation
      sections={sections}
      currentPath={currentPath}
      client:load
    />
  </nav>

  <div
    class="grid grid-1 gap-3 mt-auto space-y-4 border-r border-slate-100 px-4 py-4 dark:border-slate-800"
  >
    <AnalogClockWidget client:load />
    <LogoutButton userType="student" client:load />
  </div>
</aside>
