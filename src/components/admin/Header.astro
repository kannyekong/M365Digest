---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<header class="bg-white border-b border-slate-200">
  <div class="px-10 py-6 flex items-center justify-between">
    <div>
      <h1 class="text-3xl font-bold">
        {title}
      </h1>

      <p class="text-slate-500 mt-1">CloudTweak Administration Panel</p>
    </div>

    <div>
      <img src="../../images/dbpic.png" class="w-11 h-11 rounded-full" />
    </div>
  </div>
</header>
