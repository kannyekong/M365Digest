---
import { UserCircle } from "lucide-astro";

export interface Props {
  text?: string;
  className?: string;
}

const { text = "Login", className = "" } = Astro.props;
---

<a
  href="/student/register"
  class:list={[
    "inline-flex items-center justify-center gap-2 rounded-full",
    "border border-primary bg-transparent px-4 py-3",
    "text-sm font-semibold text-primary dark:text-white dark:border-white",
    "transition-colors duration-200",
    "hover:text-primary",
    "focus:outline-none focus:ring-2 focus:ring-primary/30",
    className,
  ]}
>
  <UserCircle size={18} />
  <span>{text}</span>
</a>
