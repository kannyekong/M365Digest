---
export interface Props {
  active: string;
}

const { active } = Astro.props;

const linkClass = (week: string) =>
  active === week
    ? "text-primary font-semibold underline underline-offset-4"
    : "hover:text-primary transition-colors duration-300";
---

<span
  class="inline-flex flex-wrap items-center mt-5 gap-2 rounded-full border border-cyan-500/20 bg-cyan-500/10 px-5 py-2 text-sm font-medium text-cyan-700 dark:text-cyan-300 backdrop-blur-xl"
>
  <a href="/weekone" class={linkClass("weekone")}> Week 1 </a>

  <span>/</span>

  <a href="/weektwo" class={linkClass("weektwo")}> Week 2 </a>

  <span>/</span>

  <a href="/weekthree" class={linkClass("weekthree")}> Week 3 </a>

  <span>/</span>

  <a href="/weekfour" class={linkClass("weekfour")}> Week 4 </a>

  <span>/</span>

  <a href="/weekfive" class={linkClass("weekfive")}> Week 5 </a>

  <span>/</span>

  <a href="/weeksix" class={linkClass("weeksix")}> Week 6 </a>
</span>
