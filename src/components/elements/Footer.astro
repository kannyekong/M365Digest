---
import {
  MailOpen,
  MailQuestionMark,
  MessageCircle,
  MessageCircleHeart,
  MessageCircleQuestion,
  MessageCircleReply,
  PhoneCall,
  PhoneOutgoing,
} from "lucide-astro";

const footerLinks = {
  company: [
    { name: "Home", href: "/" },
    { name: "About", href: "/about" },
    {
      name: "Contact",
      href: "#tally-open=VL4vdg&tally-layout=modal&tally-emoji-text=👋&tally-emoji-animation=wave",
    },
    { name: "FAQ", href: "./../#faq" },
  ],

  bootcamp: [
    { name: "Curriculum", href: "./weekone" },
    { name: "Pricing", class: "open-modal-btn" },
    { name: "Refund Policy", href: "/refundpolicy" },
    { name: "Terms & Conditions", href: "/terms" },
  ],

  resources: [
    { name: "Blog", href: "/blog" },
    {
      name: "Bootcamp Videos",
      target: "_blank",
      href: "https://wedefix-my.sharepoint.com/:f:/g/personal/kanny_wedefix_onmicrosoft_com/IgB1xhp7-ddaTYdgxUhvmC6WAVgm2m966OTHZ_dvr_3hfZ4?e=lafcfG",
    },
  ],

  socials: [
    { name: "LinkedIn", href: "https://linkedin.com/in/akanenoekong" },
    { name: "Twitter/X", href: "https://x.com/kannyekong" },
    { name: "Github", href: "https://github.com/kannyekong" },
  ],
};

const year = new Date().getFullYear();
---

<footer
  class="relative overflow-hidden mt-16 border-gray-200 dark:border-gray-800 dark:bg-gray-950"
>
  <!-- Background Glow -->
  <div
    class="absolute left-0 top-0 h-152 w-152 rounded-full bg-blue-500/10 blur-xl"
  >
  </div>

  <div
    class="absolute bottom-0 right-0 h-72 w-72 rounded-full bg-green-300/10 blur-xl"
  >
  </div>

  <div class="relative mx-auto max-w-7xl px-6 border-t border-t-[#eee] py-16">
    <!-- Top Section -->
    <div class="grid gap-12 md:grid-cols-2 lg:grid-cols-5">
      <!-- Brand -->
      <div class="lg:col-span-2">
        <a href="/" class="inline-flex items-center gap-3">
          <!-- Logo -->
          <img
            src="/logos/logonew.png"
            class="dark:hidden w-[200px] md:w-[300px] object-contain"
            alt="CloudTweak"
          />

          <img
            src="/logos/logonew-white.png"
            class="hidden dark:block w-[200px] md:w-[300px] object-contain"
            alt="CloudTweak"
          />
        </a>

        <p class="mt-6 max-w-md leading-7 text-gray-600 dark:text-gray-300">
          Empowering the next generation of Cloud Engineers with hands-on
          Microsoft 365, Azure, Security, Automation, and Enterprise IT
          training.
        </p>

        <!-- Social Icons -->
        <div class="mt-6 flex items-center gap-4">
          <a
            href="mailto:support@cloudtweak.net"
            class="flex h-10 w-10 items-center justify-center rounded-full border border-gray-200 transition hover:border-primary hover:bg-primary hover:text-white dark:text-white dark:border-white"
          >
            <MailOpen />
          </a>
          <a
            href="tel:+2348143099128"
            class="flex h-10 w-10 items-center justify-center rounded-full border border-gray-200 transition hover:border-primary hover:bg-primary hover:text-white dark:border-white dark:text-white"
          >
            <PhoneCall />
          </a>

          <a
            href="https://wa.me/07087907610"
            target="_blank"
            class="flex h-10 w-10 dark:text-white dark:border-white items-center justify-center rounded-full border border-gray-200 transition hover:border-primary hover:bg-primary hover:text-white"
          >
            <MessageCircle />
          </a>
        </div>
      </div>

      <!-- Company -->
      <div>
        <h3 class="text-lg font-semibold text-gray-900 dark:text-white">
          Company
        </h3>

        <ul class="mt-5 space-y-3">
          {
            footerLinks.company.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-gray-600 transition hover:text-primary dark:text-gray-300"
                >
                  {link.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Bootcamp -->
      <div>
        <h3 class="text-lg font-semibold text-gray-900 dark:text-white">
          Bootcamp
        </h3>

        <ul class="mt-5 space-y-3">
          {
            footerLinks.bootcamp.map((link) => (
              <li>
                <a
                  href={link.href}
                  class={`text-gray-600 transition hover:text-primary dark:text-gray-300 ${link.class}`}
                >
                  {link.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Resources -->
      <div>
        <h3 class="text-lg font-semibold text-gray-900 dark:text-white">
          Resources
        </h3>

        <ul class="mt-5 space-y-3">
          {
            footerLinks.resources.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-gray-600 transition hover:text-primary dark:text-gray-300"
                >
                  {link.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <!-- Divider -->
    <div class="my-10 border-t border-gray-200 dark:border-gray-800"></div>

    <!-- Bottom -->
    <div
      class="flex flex-col items-center justify-between gap-4 text-center md:flex-row"
    >
      <p class="text-sm text-gray-500 dark:text-gray-400">
        © {year} CloudTweak. All rights reserved.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-6 text-sm">
        <a
          href="/privacypolicy"
          class="text-gray-500 transition hover:text-primary dark:text-gray-400"
        >
          Privacy Policy
        </a>

        <a
          href="/terms"
          class="text-gray-500 transition hover:text-primary dark:text-gray-400"
        >
          Terms
        </a>

        <a
          href="/refundpolicy"
          class="text-gray-500 transition hover:text-primary dark:text-gray-400"
        >
          Refund Policy
        </a>
      </div>
    </div>
  </div>
</footer>
