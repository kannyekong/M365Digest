---
import { ExternalLink, MailOpen, MessageCircle, PhoneCall } from "lucide-astro";
import {
  FaFacebookF,
  FaInstagram,
  FaLinkedinIn,
  FaYoutube,
} from "react-icons/fa6";

import { FaXTwitter } from "react-icons/fa6";

const footerLinks = {
  company: [
    { name: "Home", href: "/" },
    { name: "About", href: "#about" },
    {
      name: "Contact",
      href: "#tally-open=VL4vdg&tally-layout=modal&tally-emoji-text=👋&tally-emoji-animation=wave",
    },
    { name: "FAQ", href: "./../#faq" },
  ],

  academy: [
    { name: "Programmes", href: "/academy" },
    { name: "Refund Policy", href: "/refundpolicy" },
    { name: "Terms & Conditions", href: "/terms" },
    {
      name: "Leave Feedback",
      href: "#tally-open=5Bp5qN&tally-align-left=1&tally-overlay=1&tally-emoji-text=👍&tally-emoji-animation=heart-beat",
    },
  ],

  resources: [
    { name: "Blog", href: "/blog" },
    {
      name: "Careers",
      target: "_blank",
      href: "https://cloudtweak.net/careers/",
    },
  ],

  products: [
    {
      name: "TweakMart",
      target: "_blank",
      href: "#",
    },
  ],
};

const year = new Date().getFullYear();
---

<footer
  class="relative overflow-hidden mt-16 border-gray-200 dark:border-gray-800 dark:bg-gray-950 px-6"
>
  <!-- Background Glow -->
  <div
    class="absolute left-0 top-0 h-152 w-152 rounded-full bg-blue-500/10 blur-xl"
  >
  </div>

  <div
    class="absolute bottom-0 right-0 h-72 w-72 rounded-full bg-green-300/10 blur-xl"
  >
  </div>

  <div class="relative mx-auto max-w-full border-t border-t-[#eee] py-16">
    <!-- Top Section -->
    <div class="grid gap-6 md:grid-cols-5">
      <!-- Brand -->
      <div class="lg:col-span-2">
        <a href="/" class="inline-flex items-center gap-3">
          <!-- Logo -->
          <img
            src="/logos/cloudtweaklogo.png"
            class="dark:hidden w-[140px] md:w-[250px] object-contain"
            alt="CloudTweak"
          />

          <img
            src="/logos/cloudtweakwhite.png"
            class="hidden dark:block w-[140px] md:w-[250px] object-contain"
            alt="CloudTweak"
          />
        </a>

        <p class="mt-6 max-w-md leading-7 text-gray-600 dark:text-gray-300">
          Bridging the gap between emerging technologies and real-world business
          challenges by helping organizations safely adopt AI, automate critical
          processes, and maximize the value of cloud solutions.
        </p>

        <!-- Social Icons -->
        <div class="flex items-center mt-5 gap-4">
          <a
            href="https://facebook.com/your-page"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Facebook"
            class="border p-2 rounded-xl border-blue-500 dark:border-white"
          >
            <FaFacebookF size={20} className="text-blue-500" />
          </a>

          <a
            href="https://instagram.com/your-page"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram"
            class="border p-2 rounded-xl border-red-500 dark:border-white"
          >
            <FaInstagram size={20} className="text-red-500" />
          </a>

          <a
            href="https://x.com/your-page"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="X"
            class="border p-2 rounded-xl border-black dark:border-white"
          >
            <FaXTwitter size={20} className="dark:text-white" />
          </a>

          <a
            href="https://linkedin.com/company/your-page"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn"
            class="border p-2 rounded-xl border-blue-500 dark:border-white"
          >
            <FaLinkedinIn size={20} className="text-blue-400 " />
          </a>

          <a
            href="https://www.youtube.com/@cloudtweaktechnologies"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="YouTube"
            class="border p-2 rounded-xl border-red-500 dark:border-white"
          >
            <FaYoutube size={20} className="text-red-500" />
          </a>
        </div>
        <div class="mt-3">
          <a
            href="mailto:support@cloudtweak.net"
            class="text-sm text-primary dark:text-white"
            >support@cloudtweak.net</a
          >
        </div>
      </div>

      <!-- Company -->
      <div>
        <h3 class="text-lg font-semibold text-gray-900 dark:text-white">
          Company
        </h3>

        <ul class="mt-5 space-y-3">
          {
            footerLinks.company.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-gray-600 transition hover:text-primary dark:text-gray-300"
                >
                  {link.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Bootcamp -->
      <div>
        <h3 class="text-lg font-semibold text-gray-900 dark:text-white">
          Academy
        </h3>

        <ul class="mt-5 space-y-3">
          {
            footerLinks.academy.map((link) => (
              <li>
                <a
                  href={link.href}
                  class={`text-gray-600 transition hover:text-primary dark:text-gray-300`}
                >
                  {link.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Resources -->
      <!-- Resources + Products -->
      <div>
        <h3 class="text-lg font-semibold text-gray-900 dark:text-white">
          Resources
        </h3>

        <ul class="mt-5 space-y-3">
          {
            footerLinks.resources.map((link) => (
              <li>
                <a
                  href={link.href}
                  target={link.target}
                  rel={
                    link.target === "_blank" ? "noopener noreferrer" : undefined
                  }
                  class="text-gray-600 transition hover:text-primary dark:text-gray-300"
                >
                  {link.name}
                </a>
              </li>
            ))
          }
        </ul>

        <h3 class="mt-8 text-lg font-semibold text-gray-900 dark:text-white">
          Products
        </h3>

        <ul class="mt-5 space-y-3">
          {
            footerLinks.products.map((link) => (
              <li>
                <a
                  href={link.href}
                  target={link.target}
                  rel={
                    link.target === "_blank" ? "noopener noreferrer" : undefined
                  }
                  class="inline-flex items-center gap-1.5 text-gray-600 transition hover:text-primary dark:text-gray-300"
                >
                  {link.name}
                  <ExternalLink class="h-3.5 w-3.5 shrink-0" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <!-- Divider -->
    <div class="my-10 border-t border-gray-200 dark:border-gray-800"></div>

    <!-- Bottom -->
    <div
      class="flex flex-col items-center justify-between gap-4 text-center md:flex-row"
    >
      <p class="text-sm text-gray-500 dark:text-gray-400">
        © {year} CloudTweak Technologies Limited. All rights reserved.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-6 text-sm">
        <a
          href="/privacypolicy"
          class="text-gray-500 transition hover:text-primary dark:text-gray-400"
        >
          Privacy Policy
        </a>

        <a
          href="/terms"
          class="text-gray-500 transition hover:text-primary dark:text-gray-400"
        >
          Terms
        </a>

        <a
          href="/refundpolicy"
          class="text-gray-500 transition hover:text-primary dark:text-gray-400"
        >
          Refund Policy
        </a>
      </div>
    </div>
  </div>
</footer>
