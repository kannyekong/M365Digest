---
import { ChevronDown } from "lucide-astro";

import BtnLink from "../shared/BtnLink.astro";
import Container from "../shared/Container.astro";
import { supabase } from "../../lib/superbase";

interface NavigationChild {
  href: string;
  text: string;
  description: string;
  badge?: string | null;
}

interface NavigationItem {
  href?: string;
  text: string;
  children?: NavigationChild[];
  activePaths?: string[];
}

/* Defines the service fields required by the navigation dropdown. */
interface NavService {
  id: string;
  title: string;
  button_url: string | null;
  badge: string | null;
  nav_short_description: string | null;
  nav_order: number | null;
}

/* Loads active services configured to appear in the Solutions dropdown. */
const { data: navServices, error: navServicesError } = await supabase
  .from("services")
  .select(
    `
      id,
      title,
      button_url,
      nav_short_description,
      nav_order,
      badge
    `
  )
  .eq("is_active", true)
  .eq("display_on_nav", true)
  .order("nav_order", {
    ascending: true,
    nullsFirst: false,
  });

/* Logs backend failures while allowing the rest of the navbar to render. */
if (navServicesError) {
  console.error(
    "Failed to load services for the Solutions navigation:",
    navServicesError
  );
}

/* Converts backend service records into navigation dropdown children. */
const solutionNavItems: NavigationChild[] = (
  (navServices ?? []) as NavService[]
)
  .filter(
    (
      service
    ): service is NavService & {
      button_url: string;
    } =>
      typeof service.button_url === "string" &&
      service.button_url.trim().length > 0
  )
  .map((service) => ({
    href: service.button_url.trim(),
    text: service.title,
    description:
      service.nav_short_description?.trim() ||
      "Explore this CloudTweak solution.",
    badge: service.badge?.trim() || null,
  }));

const navItems: NavigationItem[] = [
  {
    href: "/",
    text: "Home",
  },

  {
    text: "Solutions",
    activePaths: ["/solutions"],
    children: [
      {
        href: "/solutions",
        text: "All Solutions",
        description: "Explore every CloudTweak solution.",
      },

      ...solutionNavItems,
    ],
  },

  {
    text: "Academy",
    activePaths: ["/academy", "/verify-certificate"],
    children: [
      {
        href: "/academy",
        text: "All Programs",
        description: "Explore every Academy training program.",
      },
      {
        href: "/verify-certificate",
        text: "Verify Certificate",
        description: "Confirm a CloudTweak certificate.",
      },
    ],
  },

  {
    text: "Resources",
    activePaths: ["/careers", "/blog"],
    children: [
      {
        href: "/careers",
        text: "Careers",
        description: "Explore open positions.",
      },
      {
        href: "/blog",
        text: "Blog",
        description: "Read our quality articles.",
      },
      {
        href: "#",
        text: "TweakMart (Coming Soon)",
        description: "Small & Large scale Enterprise IT procurement",
      },
    ],
  },

  {
    href: "#tally-open=VL4vdg&tally-layout=modal&tally-emoji-text=👋&tally-emoji-animation=wave",
    text: "Contact Us",
  },
];

const currentPath = Astro.url.pathname;

/* Normalizes route paths so trailing slashes do not affect active matching. */
function normalizePath(path: string) {
  if (path === "/") {
    return "/";
  }

  return path.replace(/\/+$/, "");
}

/* Determines whether a navigation link matches the current route. */
function isLinkActive(href?: string) {
  if (!href || href.startsWith("#")) {
    return false;
  }

  const cleanHref = href.split("?")[0].split("#")[0];

  const linkPath = normalizePath(cleanHref);
  const activePath = normalizePath(currentPath);

  if (linkPath === "/") {
    return activePath === "/";
  }

  return (
    activePath === linkPath ||
    activePath.startsWith(`${linkPath}/`)
  );
}

/* Determines whether a top-level navigation item owns the current route. */
function isParentActive(item: NavigationItem) {
  if (item.activePaths?.length) {
    const activePath = normalizePath(currentPath);

    return item.activePaths.some((path) => {
      const parentPath = normalizePath(path);

      return (
        activePath === parentPath ||
        activePath.startsWith(`${parentPath}/`)
      );
    });
  }

  return isLinkActive(item.href);
}
---

<header class="sticky inset-x-0 top-0 z-[999] bg-white pb-8 dark:bg-[#030712]">
  <Container>
    <nav
      class="relative top-5 z-[1000] flex w-full items-center justify-between gap-5"
      aria-label="Primary navigation"
    >
      <a href="/" class="flex items-center gap-3">
        <div>
          <img
            src="/logos/cloudtweaklogo.png"
            class="w-[140px] object-contain dark:hidden md:w-[280px]"
            alt="CloudTweak"
          />

          <img
            src="/logos/cloudtweakwhite.png"
            class="hidden w-[140px] object-contain dark:block md:w-[280px]"
            alt="CloudTweak"
          />
        </div>
      </a>

      <div
        data-nav-overlay
        aria-hidden="true"
        class="fixed inset-0 hidden bg-box-bg bg-opacity-50 backdrop-blur-xl lg:!hidden"
      >
      </div>

      <div
        data-navbar
        class="absolute top-full flex h-0 max-h-[calc(100vh-6rem)] w-full flex-col gap-x-4 gap-y-6 overflow-hidden border-x border-x-box-border bg-body duration-300 ease-linear lg:relative lg:top-0 lg:!h-auto lg:max-h-none lg:scale-y-100 lg:flex-row lg:items-center lg:justify-between lg:overflow-visible lg:border-x-0 lg:bg-transparent"
      >
        <ul
          class="flex w-full flex-col gap-x-2 gap-y-2 border-t border-box-border px-6 pt-6 text-base text-heading-2 lg:flex-row lg:items-center lg:justify-center lg:border-t-0 lg:px-0 lg:pt-0"
        >
          {
            navItems.map((item, itemIndex) => {
              const parentActive = isParentActive(item);

              if (!item.children?.length) {
                return (
                  <li>
                    <a
                      href={item.href}
                      class:list={[
                        "relative flex min-h-11 items-center rounded-xl px-3 py-2 font-medium transition",
                        parentActive
                          ? "bg-primary/10 text-primary"
                          : "text-heading-2 hover:bg-box-bg hover:text-primary",
                      ]}
                    >
                      {item.text}
                    </a>
                  </li>
                );
              }

              return (
                <li
                  class="group relative lg:-mb-3 lg:pb-3"
                  data-public-nav-parent
                >
                  <button
                    type="button"
                    data-public-submenu-trigger
                    aria-expanded="false"
                    aria-controls={`public-submenu-${itemIndex}`}
                    class:list={[
                      "flex min-h-11 w-full items-center justify-between gap-2 rounded-xl px-3 py-2 font-medium transition lg:w-auto",
                      parentActive
                        ? "bg-primary/10 text-primary"
                        : "text-heading-2 hover:bg-box-bg hover:text-primary",
                    ]}
                  >
                    <span>{item.text}</span>

                    <ChevronDown
                      size={16}
                      data-public-submenu-icon
                      class="shrink-0 transition-transform duration-200"
                    />
                  </button>

                  <div
                    id={`public-submenu-${itemIndex}`}
                    data-public-submenu
                    class="hidden w-full lg:absolute lg:left-1/2 lg:top-full lg:z-[1001] lg:w-80 lg:-translate-x-1/2 lg:pt-3"
                  >
                    <div class="space-y-1 rounded-2xl border-l border-box-border bg-white pl-4 shadow-2xl dark:bg-[#000003] lg:border lg:border-box-border lg:p-2">
                      {item.children.map((child) => (
                        <a
                          href={child.href}
                          class:list={[
                            "block rounded-xl px-4 py-3 transition",
                            isLinkActive(child.href)
                              ? "bg-primary/10 text-primary"
                              : "text-heading-2 hover:bg-slate-100 hover:text-primary dark:hover:bg-slate-800",
                          ]}
                        >
                          <div class="flex items-start justify-between gap-3">
                            <span class="min-w-0 text-sm font-semibold">
                              {child.text}
                            </span>

                            {child.badge ? (
                              <span class="shrink-0 rounded-full bg-primary/10 px-2.5 py-1 text-[10px] font-semibold leading-none text-primary">
                                {child.badge}
                              </span>
                            ) : null}
                          </div>

                          {child.description ? (
                            <span class="mt-1 block pr-2 text-xs leading-5 text-heading-3">
                              {child.description}
                            </span>
                          ) : null}
                        </a>
                      ))}
                    </div>
                  </div>
                </li>
              );
            })
          }
        </ul>

        <div
          class="flex w-full items-center border-b border-box-bg px-6 pb-6 sm:w-max lg:min-w-max lg:border-0 lg:px-0 lg:pb-0"
        >
          <BtnLink
            text="Ask AI Assistant"
            className="flex w-full justify-center rounded-full sm:w-max"
            variant="primary"
          />
        </div>
      </div>

      <div class="flex min-w-max items-center gap-x-3">
        <button
          type="button"
          data-switch-theme
          aria-label="Switch theme"
          class="relative flex rounded-full border border-box-border p-2 text-heading-2 outline-none lg:p-3"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            class="hidden h-6 w-6 dark:flex"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z"
            >
            </path>
          </svg>

          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            class="h-6 w-6 dark:hidden"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z"
            >
            </path>
          </svg>

          <span class="sr-only">Switch theme</span>
        </button>

        <button
          type="button"
          data-toggle-nav
          data-open-nav="false"
          aria-label="Toggle navigation"
          class="relative flex h-auto w-7 flex-col outline-none lg:invisible lg:hidden"
        >
          <span
            id="line1"
            class="h-0.5 w-6 rounded-full bg-heading-2 transition-all duration-300 ease-linear"
          >
          </span>

          <span
            id="line2"
            class="mt-1 h-0.5 w-6 origin-center rounded-full bg-heading-2 transition-all duration-300 ease-linear"
          >
          </span>

          <span
            id="line3"
            class="mt-1 h-0.5 w-6 rounded-full bg-heading-2 transition-all duration-300 ease-linear"
          >
          </span>

          <span class="sr-only">Toggle navigation</span>
        </button>
      </div>
    </nav>
  </Container>
</header>

<script>
  /* Initializes expandable public navigation submenus. */
  function initializePublicSubmenus() {
    const navigationParents = Array.from(
      document.querySelectorAll<HTMLElement>("[data-public-nav-parent]")
    );

    /* Recalculates the open mobile navbar height after submenu content changes. */
    function updateMobileNavbarHeight() {
      if (window.innerWidth >= 1024) {
        return;
      }

      const navbar =
        document.querySelector<HTMLElement>("[data-navbar]");

      const toggleButton =
        document.querySelector<HTMLButtonElement>("[data-toggle-nav]");

      const navIsOpen =
        toggleButton?.getAttribute("data-open-nav") === "true";

      if (!navbar || !navIsOpen) {
        return;
      }

      requestAnimationFrame(() => {
        navbar.style.height = `${navbar.scrollHeight}px`;
        navbar.style.maxHeight = "calc(100vh - 6rem)";
        navbar.style.overflowY = "auto";
      });
    }

    /* Closes one navigation submenu. */
    function closeSubmenu(parent: HTMLElement) {
      const trigger = parent.querySelector<HTMLButtonElement>(
        "[data-public-submenu-trigger]"
      );

      const submenu = parent.querySelector<HTMLElement>(
        "[data-public-submenu]"
      );

      const icon = parent.querySelector<HTMLElement>(
        "[data-public-submenu-icon]"
      );

      trigger?.setAttribute("aria-expanded", "false");
      submenu?.classList.add("hidden");
      icon?.classList.remove("rotate-180");

      updateMobileNavbarHeight();
    }

    /* Opens one navigation submenu and closes every other submenu. */
    function openSubmenu(parent: HTMLElement) {
      navigationParents.forEach((navigationParent) => {
        if (navigationParent !== parent) {
          closeSubmenu(navigationParent);
        }
      });

      const trigger = parent.querySelector<HTMLButtonElement>(
        "[data-public-submenu-trigger]"
      );

      const submenu = parent.querySelector<HTMLElement>(
        "[data-public-submenu]"
      );

      const icon = parent.querySelector<HTMLElement>(
        "[data-public-submenu-icon]"
      );

      trigger?.setAttribute("aria-expanded", "true");
      submenu?.classList.remove("hidden");
      icon?.classList.add("rotate-180");

      updateMobileNavbarHeight();
    }

    navigationParents.forEach((parent) => {
      const trigger = parent.querySelector<HTMLButtonElement>(
        "[data-public-submenu-trigger]"
      );

      const submenu = parent.querySelector<HTMLElement>(
        "[data-public-submenu]"
      );

      if (!trigger || !submenu) {
        return;
      }

      trigger.addEventListener("click", (event) => {
        event.stopPropagation();

        const isOpen =
          trigger.getAttribute("aria-expanded") === "true";

        if (isOpen) {
          closeSubmenu(parent);
          return;
        }

        openSubmenu(parent);
      });

      parent.addEventListener("mouseenter", () => {
        if (window.innerWidth >= 1024) {
          openSubmenu(parent);
        }
      });

      parent.addEventListener("mouseleave", () => {
        if (window.innerWidth >= 1024) {
          closeSubmenu(parent);
        }
      });
    });

    document.addEventListener("click", (event) => {
      const target = event.target;

      if (!(target instanceof Node)) {
        return;
      }

      navigationParents.forEach((parent) => {
        if (!parent.contains(target)) {
          closeSubmenu(parent);
        }
      });
    });

    window.addEventListener("resize", () => {
      navigationParents.forEach((parent) => {
        closeSubmenu(parent);
      });
    });
  }

  document.addEventListener(
    "astro:page-load",
    initializePublicSubmenus
  );

  if (document.readyState === "loading") {
    document.addEventListener(
      "DOMContentLoaded",
      initializePublicSubmenus,
      {
        once: true,
      }
    );
  } else {
    initializePublicSubmenus();
  }
</script>